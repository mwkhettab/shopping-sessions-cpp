diff --git a/tests/pipeline/event_primary.cpp b/tests/pipeline/event_primary.cpp
new file mode 100644
--- /dev/null
+++ b/tests/pipeline/event_primary.cpp
@@ -0,0 +1,140 @@
+#include "../../cpp/pipeline/event_primary.hpp"
+#include <algorithm>
+#include <array>
+#include <barrier>
+#include <cstdio>
+#include <random>
+#include <span>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+
+using namespace pipeline;
+namespace {
+constexpr std::size_t threads=8,buckets=5,capacity=buckets*BSIZE;
+
+struct Part {
+    std::array<std::vector<Rec>,buckets> records;
+    void push(std::size_t bucket,u64 w0,u64 w1) {records.at(bucket).push_back({w0,w1});}
+    template<class F> void for_each(std::size_t bucket,F&& f) const {
+        f(std::span<const Rec>(records.at(bucket)));
+    }
+};
+struct Context {
+    struct Worker {Part ev;};
+    std::array<Worker,threads> workers;
+    static constexpr std::size_t nt=threads;
+    const Worker& t(std::size_t i) const {return workers.at(i);}
+};
+void require(bool test,const char* message) {
+    if(!test) throw std::runtime_error(message);
+}
+struct Row {
+    std::size_t ordinal;
+    Rec rec;
+};
+u64 ingest(const Rec& rec) {return (rec.w1>>16)&ING_MAX;}
+
+void exercise(std::string_view mode,unsigned round) {
+    EventPrimary table;
+    table.init(buckets,threads,mode);
+    require(table.active() && table.name()==mode,"policy unavailable");
+    Context ctx;
+    std::array<std::vector<Row>,threads> work;
+    std::vector<Rec> oracle(capacity);
+    std::vector<bool> present(capacity);
+    std::size_t copies=0,unique=0;
+    auto add=[&](std::size_t ordinal,std::size_t tid,u64 when,u64 person,u64 payload) {
+        const Rec r{payload,(person<<37)|(when<<16)|(ordinal&(BSIZE-1))};
+        work[tid].push_back({ordinal,r});
+        if(!present[ordinal] || when<ingest(oracle[ordinal])) oracle[ordinal]=r;
+        unique+=!present[ordinal];
+        present[ordinal]=true;
+        ++copies;
+    };
+    // Simultaneous insertions include earliest-invalid and latest-invalid
+    // versions, rank-zero records, identical ties, and arbitrary-user payloads.
+    for(std::size_t ordinal:{0u,1u,62u,63u,64u,65u,16382u,16383u,16384u,
+                              16385u,32767u,32768u,32769u,49151u,49152u,65535u}) {
+        for(std::size_t i=0;i<threads;++i) {
+            const auto rank=(i*5+ordinal+round)%threads;
+            const u64 person=(ordinal%4==1?ODDU:0)+rank;
+            const u64 payload=(ordinal%3==0 && rank==0) || (ordinal%3==2 && rank==7)
+                ?UINT64_MAX:0x2480ULL+(ordinal<<5)+rank;
+            add(ordinal,i,rank,person,payload);
+            if(rank==0) add(ordinal,(i+1)%threads,rank,person,payload);
+        }
+    }
+    // Leave the last whole bucket empty. Distribute the other slots sparsely
+    // so the test can examine every never-written generation word.
+    for(std::size_t i=0;i<1493;++i) {
+        const auto ordinal=(i*4921+113)%(4*BSIZE);
+        if(present[ordinal]) continue;
+        add(ordinal,i%threads,ING_MAX-1,ODDU+(i%27),i+1);
+        if(i%7==3) add(ordinal,(i+3)%threads,ING_MAX-2,i%63,UINT64_MAX);
+    }
+    std::barrier start{std::ptrdiff_t(threads)};
+    std::array<std::thread,threads> jobs;
+    for(std::size_t tid=0;tid<threads;++tid) {
+        jobs[tid]=std::thread([&,tid]{
+            auto& rows=work[tid];
+            std::mt19937 rng(unsigned(7369*round+tid));
+            std::shuffle(rows.begin(),rows.end(),rng);
+            auto& dup=ctx.workers[tid].ev;
+            start.arrive_and_wait();
+            for(std::size_t at=0,group=0;at<rows.size();++group) {
+                if(group%3==0) {
+                    const auto& r=rows[at++];
+                    table.write_one(dup,tid,r.ordinal>>BB,r.rec);
+                    continue;
+                }
+                std::array<u64,64> bs{};
+                std::array<std::array<u64,2>,64> records{};
+                std::size_t n=0;
+                u64 mask=0;
+                for(;at<rows.size() && n<64;++n) {
+                    if(group%3==2 && n%3==1) continue;
+                    const auto& r=rows[at++];
+                    bs[n]=r.ordinal>>BB;
+                    records[n]={r.rec.w0,r.rec.w1};
+                    mask|=u64{1}<<n;
+                }
+                table.write_batch(dup,tid,mask,n,bs.data(),records.data());
+            }
+        });
+    }
+    for(auto& job:jobs) job.join();
+    std::size_t losers=0;
+    for(const auto& w:ctx.workers) for(const auto& d:w.ev.records) losers+=d.size();
+    require(losers==copies-unique,"duplicate count");
+    for(std::size_t b=0;b<buckets;++b) {
+        const auto* slots=table.bucket(ctx,b);
+        require(bool(slots)==(b<buckets-1),"touched-bucket map");
+        if(!slots) continue;
+        require(reinterpret_cast<std::uintptr_t>(slots)%64==0,"slot alignment");
+        for(std::size_t s=0;s<BSIZE;++s) {
+            const auto i=b*BSIZE+s;
+            const auto& slot=slots[s];
+            if(!present[i]) {require(slot.w1==0,"unused generation");continue;}
+            require(slot.w1==oracle[i].w1+1 && slot.w0==oracle[i].w0,"earliest winner");
+            require(u16(slot.w1)==s+1,"generation-one tag");
+        }
+    }
+    table.release();
+    require(!table.active() && table.name()==mode,"release lost diagnostics");
+}
+}
+int main() {
+    for(const char* method:{"cas","bitmap"}) {
+        EventPrimary over_budget;
+        over_budget.init(1+(std::size_t{2}<<30)/(BSIZE*sizeof(Rec)),threads,method);
+        require(!over_budget.active() && std::string_view(over_budget.name())=="staged","memory budget");
+        for(unsigned i=0;i<8;++i) exercise(method,i);
+    }
+    for(const char* method:{"staged","unknown"}) {
+        EventPrimary table;
+        table.init(buckets,threads,method);
+        require(!table.active(),"ordinary storage fallback");
+    }
+    std::puts("event primary: both policies, 16 eight-worker rounds, zero/edge generations, caps passed");
+}
