+#pragma once
+#include "model_types.hpp"
+#include <array>
+#include <atomic>
+#include <bit>
+#include <cstddef>
+#include <cstdlib>
+#include <memory>
+#include <string_view>
+#include <vector>
+
+namespace pipeline {
+
+#ifndef SHOP_EVENT_PRIMARY_DEFAULT
+#define SHOP_EVENT_PRIMARY_DEFAULT "staged"
+#endif
+
+class EventPrimary {
+    enum class Mode { Staged, Cas, Bitmap };
+    struct Free {
+        void operator()(void* p) const noexcept { std::free(p); }
+    };
+    Mode mode_=Mode::Staged;
+    std::unique_ptr<void, Free> storage_;
+    Rec* rows_{};
+    std::unique_ptr<u64, Free> bitmap_;
+    mutable std::vector<u8> touched_;
+    std::size_t stride_{};
+
+    template<bool Bitmap, class Part>
+    inline void put(Part& duplicates,u8* touched,std::size_t b,Rec rec) const {
+        const auto index=(b<<BB)+(rec.w1&(BSIZE-1));
+        auto& slot=rows_[index];
+        // A bucket stores generation 1: index zero gets tag 1; the last gets BSIZE.
+        const auto tagged=rec.w1+1;
+        bool first;
+        if constexpr(Bitmap) {
+            const auto bit=u64{1}<<(index&63);
+            first=!(std::atomic_ref<u64>(bitmap_.get()[index>>6]).fetch_or(bit,std::memory_order_relaxed)&bit);
+            if(first) slot.w1=tagged;
+        } else {
+            u64 empty=0;
+            first=std::atomic_ref<u64>(slot.w1).compare_exchange_strong(empty,tagged,std::memory_order_relaxed);
+        }
+        if(first) {
+            slot.w0=rec.w0;
+            touched[b]=1;
+        } else {
+            // Losing workers never read the first writer's unfinished payload.
+            duplicates.push(b,rec.w0,rec.w1);
+        }
+    }
+    template<bool Bitmap, class Part>
+    void packet(Part& duplicates,u8* touched,u64 mask,std::size_t n,const u64* buckets,
+                const std::array<u64,2>* records) const {
+        auto row=[&](std::size_t i){put<Bitmap>(duplicates,touched,buckets[i],{records[i][0],records[i][1]});};
+        if(mask==(n==64?UINT64_MAX:(u64{1}<<n)-1)) {
+            for(std::size_t i=0;i<n;++i) row(i);
+        } else {
+            while(mask){const auto i=std::countr_zero(mask);mask&=mask-1;row(i);}
+        }
+    }
+public:
+    static constexpr std::string_view default_method=SHOP_EVENT_PRIMARY_DEFAULT;
+    void init(std::size_t nb,std::size_t nt,std::string_view method) {
+        // Above 2 GiB of primary records, use the bounded partitioned implementation.
+        constexpr std::size_t max_bytes=std::size_t{2}<<30;
+        if(!nb || !nt || nb>max_bytes/(BSIZE*sizeof(Rec)) || (method!="cas" && method!="bitmap")) return;
+        if constexpr(!std::atomic_ref<u64>::is_always_lock_free ||
+                     alignof(Rec)<std::atomic_ref<u64>::required_alignment ||
+                     offsetof(Rec,w1)%std::atomic_ref<u64>::required_alignment!=0) return;
+        const auto count=nb*BSIZE;
+        // calloc gives implicit-lifetime Rec objects defined zero values, including
+        // w1 for atomic_ref; the large empty table can remain demand paged.
+        const auto bytes=count*sizeof(Rec);
+        auto space=bytes+63;
+        storage_.reset(std::calloc(1,space));
+        if(!storage_) return;
+        void* aligned=storage_.get();
+        rows_=static_cast<Rec*>(std::align(64,bytes,aligned,space));
+        if(method=="bitmap") {
+            bitmap_.reset(static_cast<u64*>(std::calloc(count/64,sizeof(u64))));
+            if(!bitmap_){storage_.reset();rows_=nullptr;return;}
+        }
+        // Each parser marks its own cache-line-separated range.
+        stride_=((nb+63)&~std::size_t{63})+64;
+        touched_.resize(stride_*nt);
+        mode_=bitmap_?Mode::Bitmap:Mode::Cas;
+    }
+    bool active() const { return bool(rows_); }
+    const char* name() const {return mode_==Mode::Bitmap?"bitmap":mode_==Mode::Cas?"cas":"staged";}
+    template<class Part> void write_one(Part& duplicates,std::size_t tid,std::size_t b,Rec rec) const {
+        auto* touched=touched_.data()+tid*stride_;
+        if(mode_==Mode::Bitmap) put<true>(duplicates,touched,b,rec);
+        else put<false>(duplicates,touched,b,rec);
+    }
+    template<class Part> void write_batch(Part& duplicates,std::size_t tid,u64 mask,std::size_t n,
+                                         const u64* buckets,const std::array<u64,2>* records) const {
+        auto* touched=touched_.data()+tid*stride_;
+        if(mode_==Mode::Bitmap) packet<true>(duplicates,touched,mask,n,buckets,records);
+        else packet<false>(duplicates,touched,mask,n,buckets,records);
+    }
+    template<class G> Rec* bucket(const G& g,std::size_t b) const {
+        auto* slots=rows_+b*BSIZE;
+        bool any=false;
+        // The parser barrier precedes this loop. Stage 3 gives each bucket
+        // exactly one owner, so revision comparison now uses ordinary loads.
+        for(std::size_t tid=0;tid<g.nt;++tid) {
+            any|=bool(touched_[tid*stride_+b]);
+            g.t(tid).ev.for_each(b,[&](auto duplicates){
+                for(const auto& rec:duplicates) {
+                    auto& win=slots[rec.w1&(BSIZE-1)];
+                    if(((rec.w1>>16)&ING_MAX)<((win.w1>>16)&ING_MAX)) win={rec.w0,rec.w1+1};
+                }
+            });
+        }
+        return any?slots:nullptr;
+    }
+    void release() {storage_.reset();rows_=nullptr;bitmap_.reset();touched_.clear();}
+};
+
+template<class G> const EventPrimary* primary_events(const G& g) {
+    if constexpr(requires{g.primary;}) return g.primary.active()?&g.primary:nullptr;
+    return nullptr;
+}
+}
