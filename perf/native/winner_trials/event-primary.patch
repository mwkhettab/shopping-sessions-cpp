--- /dev/null
+++ b/tests/pipeline/event_primary.py
@@ -0,0 +1,192 @@
+"""Exercise dedup-before-validation across compact event bucket boundaries."""
+import argparse
+from collections import defaultdict
+from datetime import datetime, timezone
+from pathlib import Path
+import json
+import os
+import re
+import subprocess
+import tempfile
+
+import pyarrow.parquet as pq
+from check_keys import spelling
+
+START = 1835395200
+DAY = 86400
+ANCHORS = 36000
+TABLES = {
+    "user_daily": ("user_id", "day", "sessions", "events", "revenue_cents", "top_category"),
+    "campaign_daily": ("campaign_id", "channel", "day", "sessions", "purchasing_sessions",
+                       "revenue_cents", "assisted_sessions"),
+}
+HEADERS = {
+    "events": "event_id,user_id,ts,ingest_ts,event_type,product_id,price_cents",
+    "clicks": "click_id,user_id,campaign_id,ts",
+    "links": "user_id_a,user_id_b",
+}
+
+
+def timestamp(seconds):
+    return datetime.fromtimestamp(seconds, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def prepare(data):
+    for kind in HEADERS:
+        (data / kind).mkdir(parents=True)
+    (data / "manifest.json").write_text(json.dumps({
+        "window_start": timestamp(START), "window_end": timestamp(START + 14*DAY)}))
+    (data / "products.csv").write_text("product_id,category\np1,A\n")
+    (data / "campaigns.csv").write_text("campaign_id,channel\nc_1,mail\n")
+    (data / "clicks/part.csv").write_text(HEADERS["clicks"] + "\n")
+    (data / "links/part.csv").write_text(HEADERS["links"] + "\n")
+    when = timestamp(START)
+    groups = {}
+    ids = {}
+
+    def user(i):
+        if i not in groups:
+            groups[i] = "u" + spelling(i * 512, 0x12ECB0A367)
+        return groups[i]
+
+    def eid(i):
+        if i not in ids:
+            ids[i] = "e" + spelling(i, 0x1D0896B42F)
+        return ids[i]
+
+    def cohort(i):
+        return 0 if i < 1000 else 1 + (i - 1000)//128
+
+    revisions = [[] for _ in range(16)]
+    # Values in this independent oracle are (ingest, person, revenue or None).
+    # None means a physically valid row whose winning copy fails validation.
+    expected = {}
+    compact_copies = 0
+
+    def remember(key, seconds, name, revenue):
+        row = (seconds, name, revenue)
+        if key not in expected or seconds < expected[key][0]:
+            expected[key] = row
+        elif seconds == expected[key][0]:
+            assert expected[key] == row, (key, expected[key], row)
+
+    with (data / "events/anchors.csv").open("w") as f:
+        print(HEADERS["events"], file=f)
+        for i in range(ANCHORS):
+            group = cohort(i)
+            print(",".join((eid(i), user(group), when, timestamp(START+30),
+                           "view", "p1", "")), file=f)
+            remember(eid(i), START+30, user(group), 0)
+            compact_copies += 1
+
+    def add(part, key, name, t, seconds, kind, prod, price, value, compact=True):
+        nonlocal compact_copies
+        row = [key, name, t, timestamp(seconds), kind, prod, price]
+        if part % 3 == 1:
+            row = ['"' + field + '"' for field in row]
+        revisions[part].append(",".join(row))
+        remember(key, seconds, name, value)
+        compact_copies += compact
+
+    special = [0, 1, 62, 63, 64, 65, 8191, 8192, 16382, 16383, 16384,
+               16385, 24574, 32766, 32767, 32768, 32769, 35999]
+    raw_users = [" \x00raw ", "u00", "élève", "long-" + "Z"*320]
+    for j, i in enumerate(special):
+        key = eid(i)
+        owner = raw_users[j % 4] if j % 2 else user(300 if i == 0 else cohort(i))
+        for rank in range(8):
+            part = (7*rank + j)%len(revisions)
+            # Some rank-zero records are invalid, including empty users,
+            # unknown types, invalid timestamps, invalid price, and absent product.
+            name, t, kind, product, price, value = owner, when, "purchase", "p1", str(17+j), 17+j
+            if rank:
+                name, price, value = user(j + 400 + rank), str(9000 + rank), 9000 + rank
+            elif j % 8 == 1:
+                name, value = "", None
+            elif j % 8 == 2:
+                t, value = "2028-02-30T00:00:00Z", None
+            elif j % 8 == 4:
+                kind, value = "Purchase", None
+            elif j % 8 == 6:
+                price, value = "0", None
+            elif j % 8 == 7:
+                product, value = "", None
+            if rank == 0 and i in (16383, 32767):
+                name, t, kind, product, price, value = raw_users[2], when, "purchase", "p1", "41", 41
+            # For ordinal zero both the input ordinal and the packed ingest
+            # bits are zero; the winning event still needs a live generation.
+            sec = START-DAY+rank if i == 0 else START+rank
+            add(part, key, name, t, sec, kind, product, price, value)
+            if rank == 0:
+                add((part+1)%16, key, name, t, sec, kind, product, price, value)
+        # The CSV parser must drop this otherwise earlier revision.
+        revisions[(j+3)%16].append(",".join((key, user(999), when, timestamp(START-DAY),
+                                               "purchase", "p1", "323", "extra")))
+    for j, key in enumerate(("e00", "Év\x00", "E-arbitrary-"+"x"*327)):
+        add(2*j, key, user(391), when, START+2, "purchase", "p1", "7001", 7001, False)
+        add(2*j+1, key, raw_users[j], when, START, "purchase", "p1", str(j+101), j+101, False)
+    # A syntactically normal encoded ID outside the estimated dense ordinal
+    # range is still an arbitrary event. Its identity must survive global dedup.
+    outside = eid(1 << 29)
+    add(4, outside, user(389), when, START+2, "purchase", "p1", "88", 88, False)
+    add(5, outside, raw_users[3], when, START+1, "view", "p1", "ignored", 0, False)
+    for part, rows in enumerate(revisions):
+        sequence = rows if part % 2 else list(reversed(rows))
+        # Deliberately omit the final newline in half the shards.
+        suffix = "\n" if part % 2 else ""
+        (data / "events" / f"r{part:02}.csv").write_text(
+            HEADERS["events"] + "\n" + "\n".join(sequence) + suffix)
+    by_user = defaultdict(lambda: [0, 0])
+    for _, name, value in expected.values():
+        if value is None:
+            continue
+        by_user[name][0] += 1
+        by_user[name][1] += value
+    day = datetime.fromtimestamp(START, timezone.utc).date()
+    users = sorted((name, day, 1, n, rev, "A" if rev else None)
+                   for name, (n, rev) in by_user.items())
+    campaign = [("organic", "organic", day, len(users), sum(r[4] > 0 for r in users),
+                 sum(r[4] for r in users), 0)]
+    return [users, campaign], compact_copies
+
+
+def check(binary, scratch):
+    data = scratch / "input"
+    tables, compact_copies = prepare(data)
+    for mode, threads, legacy in [
+        ("cas", 1, True), ("bitmap", 8, True), ("bitmap", 1, False),
+        ("cas", 8, False), ("staged", 8, False), ("generic", 4, False),
+    ]:
+        out = scratch / f"out-{mode}-{threads}"
+        out.mkdir(mode=0o777)
+        out.chmod(0o777)
+        command = [str(binary), *(["--generic"] if mode == "generic" else []), str(data), str(out)]
+        env = os.environ | {"NCPU": str(threads), "XL_OLD3": str(int(legacy)),
+                            "XL_EVENT_PRIMARY": mode, "XL_TIMING": "1", "V1ND_LOG": "1"}
+        result = subprocess.run(command, env=env, capture_output=True, text=True, timeout=60)
+        if result.returncode:
+            raise RuntimeError(f"{mode} failed with {result.returncode}: {result.stderr[-3000:]}")
+        if mode != "generic":
+            trace = re.search(r"event_primary=(\w+) staged_event_records=(\d+) buckets=(\d+)", result.stderr)
+            target = compact_copies if mode == "staged" else compact_copies-ANCHORS
+            if not (trace and trace[1] == mode and int(trace[2]) == target and int(trace[3]) >= 3):
+                raise AssertionError((mode, target, result.stderr[-3000:]))
+        for (name, columns), want in zip(TABLES.items(), tables):
+            rows = []
+            for file in (out / name).glob("*.parquet"):
+                tab = pq.read_table(file, columns=list(columns))
+                rows.extend(zip(*(tab[c].to_pylist() for c in columns)))
+            if sorted(rows) != want:
+                raise AssertionError((mode, name, len(rows), len(want),
+                                      list(set(rows) - set(want))[:3], list(set(want) - set(rows))[:3]))
+        print(f"{mode} with {threads} workers, legacy={int(legacy)}: "
+              f"{len(tables[0])} user rows, one campaign row, exact", flush=True)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("binary", type=Path)
+    parser.add_argument("--scratch-parent", type=Path)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(dir=args.scratch_parent) as folder:
+        check(args.binary.resolve(), Path(folder))
