+#pragma once
+// Sessions are already chronological. Each click can affect a single interval
+// of session indices. The first eligible session suffices to order winners.
+struct ClickRanges {
+  struct Start {
+    Time time;
+    int32_t day;
+    int64_t revenue;
+    size_t intervals{}, next_day{};
+    Time best = bad;
+    Key click{};
+    int campaign{};
+  };
+  struct Interval {
+    int campaign;
+    size_t end, previous;
+  };
+  std::vector<Start> starts;
+  std::vector<Interval> intervals;
+
+  template <class Click, class Result, class Layout>
+  void attribute(std::span<Click> clicks, Result &result, Layout layout) {
+    if (starts.empty())
+      return;
+    auto offer = [](Start &s, Time ts, const Click &c) {
+      if (ts > s.best || (ts == s.best && c.id.user_less(s.click, 'k'))) {
+        s.best = ts;
+        s.click = c.id;
+        s.campaign = c.campaign;
+      }
+    };
+    auto credit = [&](const Start &s, int campaign) {
+      auto &v = result.at(campaign, s.day);
+      ++v.sessions;
+      v.purchases += s.revenue != 0;
+      v.revenue += s.revenue;
+    };
+    if (starts.size() == 1) {
+      auto &s = starts.front();
+      for (auto &c : clicks) {
+        Time ts = layout.click_time(c);
+        if (ts < s.time - reach || ts > s.time)
+          continue;
+        offer(s, ts, c);
+        auto &seen = result.activity[c.campaign].count;
+        if (!seen) {
+          seen = 1;
+          result.active.push_back(c.campaign);
+          ++result.at(c.campaign, s.day).assists;
+        }
+      }
+      credit(s, s.campaign);
+      starts.clear();
+      return;
+    }
+    for (size_t i = starts.size(); i-- > 0;)
+      starts[i].next_day =
+          i + 1 < starts.size() && starts[i].day == starts[i + 1].day
+              ? starts[i + 1].next_day
+              : i + 1;
+    for (auto &c : clicks) {
+      Time ts = layout.click_time(c);
+      auto first =
+          std::lower_bound(starts.begin(), starts.end(), ts,
+                           [](const Start &s, Time t) { return s.time < t; });
+      if (first == starts.end() || ts < first->time - reach)
+        continue;
+      auto end =
+          std::upper_bound(first, starts.end(), ts, [](Time t, const Start &s) {
+            return t < s.time - reach;
+          });
+      offer(*first, ts, c);
+      intervals.push_back(
+          {c.campaign, size_t(end - starts.begin()), first->intervals});
+      first->intervals = intervals.size();
+    }
+    int campaign = 0;
+    Time last = bad;
+    for (size_t i = 0; i < starts.size(); ++i) {
+      auto &s = starts[i];
+      if (s.best != bad) {
+        last = s.best;
+        campaign = s.campaign;
+      }
+      credit(s, last >= s.time - reach ? campaign : 0);
+      for (size_t at = s.intervals; at; at = intervals[at - 1].previous) {
+        const auto &interval = intervals[at - 1];
+        auto &covered = result.activity[interval.campaign].count;
+        if (covered >= interval.end)
+          continue;
+        if (!covered)
+          result.active.push_back(interval.campaign);
+        size_t pos = std::max(i, covered);
+        covered = interval.end;
+        while (pos < covered) {
+          size_t next = std::min(covered, starts[pos].next_day);
+          result.at(interval.campaign, starts[pos].day).assists += next - pos;
+          pos = next;
+        }
+      }
+    }
+    starts.clear();
+    intervals.clear();
+  }
+};
