+      size_t n = lf == Str::npos ? data.size() : lf + 1;
+      wide_csv_rows<N>(data.substr(0, n), f);
+      data.remove_prefix(n);
+      continue;
+    }
+    if (size_t(std::popcount(lo) + std::popcount(hi)) == N - 1) {
+      unsigned start = 0, expected = 0;
+      for (size_t i = 0; i < N; ++i) {
+        unsigned cut = end - 1;
+        if (i + 1 < N) {
+          if (lo) {
+            cut = __builtin_ctzll(lo);
+            lo &= lo - 1;
+          } else {
+            cut = 64 + __builtin_ctzll(hi);
+            hi &= hi - 1;
+          }
