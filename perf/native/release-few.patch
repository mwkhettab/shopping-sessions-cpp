+        unsigned len = cut - start;
+        bool q = len >= 2 && ((p[start] == '"') & (p[cut - 1] == '"'));
+        expected += 2 * q;
+        fields[i] = {p + start + q, len - 2 * q};
+        start = cut + 1;
+      }
+      if (expected == quote_count)
+        f(fields);
+    }
+    data.remove_prefix(end);
+  }
