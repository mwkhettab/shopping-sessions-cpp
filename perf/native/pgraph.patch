+inline void write_users(const fs::path &path,const std::vector<UserDay> &data) {
+  MEASURE(parquet_write);
+  using namespace flat_parquet;
+  static constexpr Column cols[]={{"user_id",6,0},{"day",1,6},{"sessions",2},
+    {"events",2},{"revenue_cents",2},{"top_category",6,0,true}};
+  File file(path,cols);
+  std::span<const UserDay> rows(data);
+  std::array<Bytes,6> pages;
+  while (!rows.empty()) {
+    size_t n=batch(rows,[](auto &r) {
+      return (r.user.indirect()?r.user.view().size():9)+(r.category?r.category->size():0);
+    });
+    for (auto &p:pages) { p.clear(); p.reserve(n*12); }
+    auto defs=levels(pages[5],n);
+    for (size_t i=0;i<n;++i) {
+      const auto &r=rows[i];
+      std::array<char,9> scratch;
+      plain_string(pages[0],r.user.user_text(scratch));
+      little(pages[1],r.day); little(pages[2],r.sessions);
+      little(pages[3],r.events); little(pages[4],r.revenue);
+      if (r.category) {
+        auto &value=pages[5][defs+i/8];
+        value=char(static_cast<unsigned char>(value) | (1u << (i%8)));
+        plain_string(pages[5],*r.category);
+      }
+    }
+    file.group(n);
+    Bytes packed;
+    for (size_t col=0;col<pages.size();++col) {
+      if (cols[col].physical==6) file.page(pages[col]);
+      else {
+        packed.clear(); packed.reserve(n*4);
+        if (cols[col].physical==1) delta_pack<int32_t>(packed,pages[col]);
+        else delta_pack<int64_t>(packed,pages[col]);
+        file.page(packed,5);
+      }
+    }
+    rows=rows.subspan(n);
+  }
+  file.close();
+}
+inline void write_campaigns(const fs::path &path,const std::vector<CampaignDay> &data) {
+  using namespace flat_parquet;
+  static constexpr Column cols[]={{"campaign_id",6,0},{"channel",6,0},{"day",1,6},
+    {"sessions",2},{"purchasing_sessions",2},{"revenue_cents",2},{"assisted_sessions",2}};
+  File file(path,cols);
+  std::span<const CampaignDay> rows(data);
+  std::array<Bytes,7> pages;
+  while (!rows.empty()) {
+    size_t n=batch(rows,[](auto &r) { return r.campaign.size()+r.channel.size(); });
+    for (auto &p:pages) { p.clear();p.reserve(n*12); }
+    for (const auto &r:rows.first(n)) {
+      plain_string(pages[0],r.campaign); plain_string(pages[1],r.channel);
+      little(pages[2],r.day); little(pages[3],r.counts.sessions);
+      little(pages[4],r.counts.purchases); little(pages[5],r.counts.revenue);
+      little(pages[6],r.counts.assists);
+    }
+    file.group(n);
+    Bytes packed;
+    for (size_t col=0;col<pages.size();++col) {
+      if (cols[col].physical==6) file.page(pages[col]);
+      else {
+        packed.clear(); packed.reserve(n*4);
+        if (cols[col].physical==1) delta_pack<int32_t>(packed,pages[col]);
+        else delta_pack<int64_t>(packed,pages[col]);
+        file.page(packed,5);
+      }
+    }
+    rows=rows.subspan(n);
+  }
+  file.close();
+}
