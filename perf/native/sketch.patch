+++ b/cpp/repeat_sketch.hpp
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstdlib>
+
+struct RevisionPages {
+  static constexpr size_t length = 2048;
+  std::vector<std::unique_ptr<Candidate[]>> pages;
+  size_t count{};
+  Candidate *append(Candidate value) {
+    size_t offset = count++ % length;
+    if (!offset)
+      pages.emplace_back(std::make_unique_for_overwrite<Candidate[]>(length));
+    auto *dest = pages.back().get() + offset;
+    *dest = value;
+    return dest;
+  }
+};
+
+struct RepeatSketch {
+  std::vector<uint64_t> seen, repeated;
+  void reset(size_t words) { seen.resize(words); repeated.resize(words); }
+  void observe(size_t hash) {
+    auto word = (hash >> 6) & (seen.size()-1);
+    auto bit = uint64_t{1} << (hash & 63);
+    auto old = seen[word];
+    if (old & bit) repeated[word] |= bit;
+    seen[word] = old | bit;
+  }
+};
