+    inline void push_event(std::size_t bucket, u64 first, u64 second) {
+        auto address = cur_[bucket];
+        if ((address & (CHUNK - 1)) == LINK_OFF)
+            address = new_chunk(bucket, address);
+        *reinterpret_cast<Rec*>(address) = {first, second};
+        cur_[bucket] = address + sizeof(Rec);
+    }
+
+    inline void push_events(u64 mask, std::size_t n, const u64* buckets,
+                            const std::array<u64,2>* rows) {
+        const auto append = [&](std::size_t index) {
+            push_event(buckets[index], rows[index][0], rows[index][1]);
+        };
+        const u64 all = n == 64 ? UINT64_MAX : (u64{1} << n) - 1;
+        if (mask == all) {
+            for (std::size_t i = 0; i < n; ++i) append(i);
+        } else {
+            while (mask) {
+                append(std::countr_zero(mask));
+                mask &= mask - 1;
+            }
+        }
+    }
+
     inline void push(std::size_t bucket, u64 w0, u64 w1) {
         const auto offset = fill_[bucket];
         lines_[bucket].rows[offset / sizeof(Rec)] = {w0, w1};
