+++ b/cpp/population_structure.hpp
@@ -0,0 +1,41 @@
+#pragma once
+struct PopulationStructure {
+  struct Sample {uint64_t owners{},events{},clicks{},bins{},sessions{},assists{};};
+  std::array<Sample,12> raw{},persons{};
+  std::array<std::array<Sample,7>,7> counts{};
+  std::vector<uint64_t> marks;
+  uint64_t generation{};
+  static unsigned tier(size_t n) {
+    if(n<=2)return unsigned(n);
+    if(n<=4)return 3;
+    if(n<=16)return 4;
+    if(n<=128)return 5;
+    return 6;
+  }
+  template<class E,class Layout> Sample &record(std::span<E> ev,size_t clicks,Layout layout,
+       Time origin,size_t capacity,bool person) {
+    auto &out=(person?persons:raw)[std::min<size_t>(11,std::bit_width(ev.size()))];
+    ++out.owners;out.events+=ev.size();out.clicks+=clicks;
+    if(capacity) {
+      if(marks.size()!=capacity)marks.assign(capacity,0);
+      ++generation;
+      for(auto e:ev){size_t i=(uint64_t(layout.time(e))-uint64_t(origin))/session_gap;
+        if(marks.at(i)!=generation){marks[i]=generation;++out.bins;}}
+    }
+    return out;
+  }
+  template<class R> static void report(const std::vector<R> &results) {
+    auto add=[](Sample &a,const Sample &b){a.owners+=b.owners;a.events+=b.events;a.clicks+=b.clicks;a.bins+=b.bins;a.sessions+=b.sessions;a.assists+=b.assists;};
+    auto print=[](Str label,size_t a,size_t b,Sample s){
+      if(s.owners)std::cerr<<label<<" "<<a<<" "<<b<<" "<<s.owners<<" "<<s.events<<" "<<s.clicks<<" "<<s.bins<<" "<<s.sessions<<" "<<s.assists<<"\n";
+    };
+    for(int action=0;action<2;++action)for(unsigned i=0;i<12;++i){
+      Sample s;for(const auto &r:results)add(s,action?r.structure.persons[i]:r.structure.raw[i]);
+      print(action?"personcounts":"rawcounts",i,0,s);
+    }
+    for(unsigned i=0;i<7;++i)for(unsigned j=0;j<7;++j){
+      Sample s;for(const auto &r:results)add(s,r.structure.counts[i][j]);
+      print("clicksessioncounts",i,j,s);
+    }
+  }
+};
