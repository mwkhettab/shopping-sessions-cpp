--- a/tests/pipeline/user_codecs.cpp
+++ b/tests/pipeline/user_codecs.cpp
@@ -9,7 +9,31 @@ static void check(bool ok,const char* reason) {
     if(!ok) throw std::runtime_error(reason);
 }
 
+static void check_known_word_pages() {
+    constexpr u32 base = 0x7ffffffc;
+    std::array<u32, 9> keys{0, 1, 2, 3, 4, 5, 6, 7, 7};
+    for (auto& key : keys) key += base;
+
+    pqw::Out page;
+    pqw::emit_user_words(page, keys, base, 3);
+    // Two eight-value groups. The second contains only 7 and its padding.
+    constexpr std::array<u8, 7> expected{0x05, 0x88, 0xc6, 0xfa, 0x07, 0, 0};
+    check(page.size() == expected.size(), "three-bit page length");
+    check(std::equal(expected.begin(), expected.end(), page.data()), "three-bit page layout");
+
+    // 505 values require 64 groups, the first count with a two-byte run header.
+    std::vector<u32> ones(505, base + 1);
+    pqw::Out wide_header;
+    pqw::emit_user_words(wide_header, ones, base, 1);
+    check(wide_header.size() == 66, "two-byte header page length");
+    const auto* bytes = wide_header.data();
+    check(bytes[0] == 0x81 && bytes[1] == 0x01, "64-group run header");
+    check(std::all_of(bytes + 2, bytes + 65, [](u8 b) { return b == 0xff; }), "full one-bit groups");
+    check(bytes[65] == 0x01, "final one-bit group padding");
+}
+
 int main() {
+    check_known_word_pages();
