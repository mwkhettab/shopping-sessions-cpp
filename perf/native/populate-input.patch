diff --git a/cpp/pipeline/parse.hpp b/cpp/pipeline/parse.hpp
index d607aa8..aa916fd 100644
--- a/cpp/pipeline/parse.hpp
+++ b/cpp/pipeline/parse.hpp
@@ -99,6 +99,16 @@ template<class G> void stage1(G& g,std::size_t tid){
         if(use_rd&&FDS[c.file]>=0){chunk_rd(g,t,*eb,*cb,*out,tb,tid,f,c,FDS[c.file],rb,d.rd);continue;}
         std::string_view data(reinterpret_cast<const char*>(g.region+f.off),f.len);
         const auto s=c.a==f.hdr?c.a:next_line_start(data,c.a-1),e=c.b>=f.len?f.len:next_line_start(data,c.b-1);if(s>=e)continue;
+#if defined(__linux__) && defined(MADV_POPULATE_READ)
+        // Fault complete file pages together before the decoder starts on this chunk.
+        static const long page_bytes = ::sysconf(_SC_PAGESIZE);
+        if (page_bytes > 0) {
+            const auto page = static_cast<std::size_t>(page_bytes);
+            const auto first = (s + page - 1) / page * page;
+            const auto end = e - e % page;
+            if (first < end) ::madvise(const_cast<u8*>(g.region + f.off + first), end - first, MADV_POPULATE_READ);
+        }
+#endif
         parse_buf(g,t,*eb,*cb,*out,tb,tid,f,data.substr(s,e-s),s);
         if(RELEASE)sys::release(g.region+f.off+s,e-s);
     }
