+        if (weight) {
+            const auto end=sampled_ns();
+            for (std::size_t j=0;j<end.size();++j) k.weighted[j] += (end[j]-before[j])*weight;
+        }
+    }
+};
+struct Buffer {
+    KindStats& k;
+    const bool sampled;
+    const u64& counter;
+    u64 initial, start;
+    Buffer(Worker& w, Kind kind, std::size_t bytes, const u64& rows)
+        : k(w.kinds[std::size_t(kind)]), sampled(w.selected), counter(rows), initial(rows), start(now()) {
+        k.bytes += bytes;
+        if (sampled) k.sample_bytes += bytes;
+    }
+    ~Buffer() {
+        const auto spent = now() - start, rows = counter - initial;
+        k.body_ns += spent; k.rows += rows;
+        if (sampled) { k.sample_body_ns += spent; k.sample_rows += rows; }
+    }
+};
+template<bool Sample> struct Packet {
+    KindStats& k;
+    u64 last = 0;
+    Packet(KindStats& s, u64 rows) : k(s) {
+        if constexpr (Sample) { last = now(); ++k.packets; k.packet_rows += rows; }
+    }
+    void mark(u64 KindStats::* member) {
+        if constexpr (Sample) {
+            const auto at = now(); k.*member += at - last; last = at;
+        }
+    }
+    void finish(u64 special) {
+        if constexpr (Sample) { k.special_rows += std::popcount(special); mark(&KindStats::special_ns); }
+    }
+};
+template<class C> struct SampleSink {
+    C& c;
+    auto ev() { return c.ev(); }
+    auto ck() { return c.ck(); }
+    void ev_flush() { c.template ev_flush<true>(); }
+    void ck_flush() { c.template ck_flush<true>(); }
+};
+inline void emit(std::size_t nt) {
+    std::array<u64, 512> costs;
+    for (auto& cost : costs) { auto a = now(); cost = now() - a; }
+    std::sort(costs.begin(), costs.end());
+    std::ostringstream o;
+    o << "[parse-sample] meta stride=" << stride() << " phase=" << phase() << " workers=" << nt
+      << " clock_pair_median_ns=" << costs[costs.size()/2] << '\n';
+    constexpr std::array names{"event", "click", "link"};
+    for (std::size_t i = 0; i < nt; ++i) {
+        const auto& w = workers[i];
+        o << "[parse-sample] worker tid=" << i << " begin=" << w.begin << " end=" << w.end << " jobs_ns="
+          << w.jobs_ns << " handoff_ns=" << w.handoff_ns << " tail_ns=" << w.tail_ns << '\n';
+        for (std::size_t j = 0; j < names.size(); ++j) {
+            const auto& k = w.kinds[j];
+            o << "[parse-sample] " << names[j] << " tid=" << i << " chunks=" << k.chunks << " sample_chunks="
+              << k.sample_chunks << " sampled_id_xor=" << k.sampled_id_xor << " chunk_ns=" << k.chunk_ns
+              << " bytes=" << k.bytes << " rows=" << k.rows << " body_ns=" << k.body_ns << " sample_bytes="
+              << k.sample_bytes << " sample_rows=" << k.sample_rows << " sample_body_ns=" << k.sample_body_ns
+              << " packets=" << k.packets << " packet_rows=" << k.packet_rows << " special_rows=" << k.special_rows
+              << " classify_ns=" << k.classify_ns << " scatter_ns=" << k.scatter_ns << " fused_ns="
+              << k.fused_ns << " special_ns=" << k.special_ns;
+            constexpr std::array fields{"body_ns","classify_ns","scatter_ns","fused_ns","special_ns"};
+            for (std::size_t f=0;f<fields.size();++f) o << " weighted_" << fields[f] << '=' << k.weighted[f];
+            o << '\n';
+        }
+    }
+    const auto text = o.str(); (void)std::fwrite(text.data(), 1, text.size(), stderr);
+}
+}
