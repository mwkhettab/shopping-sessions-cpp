+}
+inline u64 setting(const char* key, u64 fallback) {
+    if (const char* s = std::getenv(key)) {
+        std::string_view text(s);
+        u64 value{};
+        const auto [end, ec] = std::from_chars(s, s + text.size(), value);
+        if (ec == std::errc{} && end == s + text.size()) return value;
+    }
+    return fallback;
+}
+inline u64 mix(u64 v) {
+    v = (v ^ (v >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    v = (v ^ (v >> 27)) * 0x94d049bb133111ebULL;
+    return v ^ (v >> 31);
+}
+inline u64 stride() { static const u64 n = setting("SHOP_PARSE_STRIDE", 16); return n; }
+inline u64 phase() { static const u64 n = setting("SHOP_PARSE_PHASE", 0); return n; }
+
+// Pick one queue entry per contiguous group of each file kind. Rotating phase
+// covers every entry of each group; neither worker assignment nor run order enters the plan.
+template<class Files> const auto& plan(const std::vector<Chunk>& queue, const Files& files) {
+    static const auto selected = [&] {
+        std::vector<std::size_t> result(queue.size());
+        const auto step = stride();
+        if (!step) return result;
+        std::array<std::vector<std::size_t>, 3> kinds;
+        for (std::size_t i = 0; i < queue.size(); ++i)
+            kinds[std::size_t(files[queue[i].file].kind)].push_back(i);
+        for (std::size_t k = 0; k < kinds.size(); ++k) {
+            const auto& items = kinds[k];
+            for (std::size_t first = 0; first < items.size();) {
+                const auto width = std::min<u64>(step, items.size() - first);
+                const auto offset = (mix(first ^ ((k + 1) * 0x9e3779b97f4a7c15ULL)) % width + phase() % width) % width;
+                result[items[first + offset]] = width;
+                first += width;
+            }
+        }
+        return result;
+    }();
+    return selected;
+}
+struct KindStats {
+    u64 chunks{}, sample_chunks{}, sampled_id_xor{}, chunk_ns{}, bytes{}, rows{}, body_ns{};
+    u64 sample_bytes{}, sample_rows{}, sample_body_ns{}, packets{}, packet_rows{}, special_rows{};
+    u64 classify_ns{}, scatter_ns{}, fused_ns{}, special_ns{};
+    std::array<u64,5> weighted{};
+};
+struct alignas(128) Worker {
+    u64 begin{}, end{}, jobs_ns{}, handoff_ns{}, tail_ns{};
+    bool selected{};
+    std::array<KindStats, 3> kinds{};
+};
+inline std::array<Worker, 16> workers{};
+struct Scope {
+    u64& value;
+    u64 start = now();
+    ~Scope() { value += now() - start; }
+};
+struct ChunkScope {
+    KindStats& k;
+    u64 start, weight;
+    std::array<u64,5> before{};
+    std::array<u64,5> sampled_ns() const {
+        return {k.sample_body_ns,k.classify_ns,k.scatter_ns,k.fused_ns,k.special_ns};
+    }
+    ChunkScope(Worker& w, Kind kind, std::size_t id, std::size_t width)
+        : k(w.kinds[std::size_t(kind)]), start(now()), weight(width) {
