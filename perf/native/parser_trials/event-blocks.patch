+#pragma once
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <cstring>
+#include <utility>
+
+namespace pipeline::k_free::detail {
+
+// Two retained lookahead lines cover both 64-bit delimiter windows, including
+// the final row whose first byte is at the last byte of the main tile.
+struct EventBlockTile {
+    static constexpr unsigned blocks=16, ahead=2, bytes=64*blocks;
+    using P=const std::uint8_t *;
+    using Word=std::uint64_t;
+    alignas(64) std::array<Word,blocks+ahead> commas, newlines;
+    P base;
+
+    template<class Classify> void fill(P start,bool retain,Classify classify) {
+        base=start;
+        if (retain) for (unsigned i=0;i<ahead;++i) {
+            commas[i]=commas[blocks+i];
+            newlines[i]=newlines[blocks+i];
+        }
+        for (unsigned i=retain?ahead:0;i<blocks+ahead;++i) {
+            auto [comma,newline]=classify(start+64*i);
+            commas[i]=comma;
+            newlines[i]=newline;
+        }
+    }
+
+    std::pair<Word,Word> windows(P p) const {
+        static_assert(std::endian::native==std::endian::little);
+        auto offset=unsigned(p-base);
+        unsigned __int128 bits;
+        std::memcpy(&bits,reinterpret_cast<const std::uint8_t *>(commas.data())+(offset>>3),sizeof(bits));
+        auto shift=offset&7;
+        return {Word(bits>>shift),Word(bits>>(shift+32))};
+    }
+
+    // Save ends independently of the previous row's decode. Bound the number
+    // of offsets by the maximum possible number of source bytes in this tile.
+    unsigned ends(std::uint16_t *lines) const {
+        unsigned n=0;
+        for (unsigned i=0;i<blocks+ahead;++i) {
+            auto bits=newlines[i];
+            while (bits) {
+                lines[n++]=std::uint16_t(64*i+std::countr_zero(bits)+1);
+                bits&=bits-1;
+            }
+        }
+        return n;
+    }
+};
+
+// Fast consumes one source row. Slow owns the original parser's restart cursor,
+// which can jump past several physical newlines. Discard stale ends after it.
+template<class Classify,class Fast,class Slow>
+inline EventBlockTile::P walk_event_blocks(EventBlockTile::P input,EventBlockTile::P p,EventBlockTile::P limit,
+                                          Classify classify,Fast fast,Slow slow) {
+    using Tile=EventBlockTile;
+    auto floor=[](Tile::P s) {return reinterpret_cast<Tile::P>(reinterpret_cast<std::uintptr_t>(s)&~std::uintptr_t{63});};
+    while (p<=limit && ((reinterpret_cast<std::uintptr_t>(p)&63)>std::size_t(p-input))) p=slow(p);
+    if (p>limit) return p;
+    Tile tile;
+    std::array<std::uint16_t,64*(Tile::blocks+Tile::ahead)> ends;
+    auto base=floor(p);
+    bool retain=false;
+    while (p<=limit) {
+        tile.fill(base,retain,classify);
+        auto count=tile.ends(ends.data());
+        auto block_end=base+Tile::bytes,stop=block_end<limit+1?block_end:limit+1;
+        for (unsigned j=0;j<count && p<stop;++j) {
+            const auto next=base+ends[j];
+            if (next<=p) continue;
+            const auto span=std::size_t(next-p);
+            if (span-33>63) {p=slow(p);continue;}
+            const auto [head,tail]=tile.windows(p);
+            p=fast(p,next,head,tail,span-33);
+        }
+        // A physical line may span multiple tiles. Let the original parser
+        // advance over it once as soon as the cached 96-byte window lacks LF.
+        while (p<stop) p=slow(p);
+        if (p>limit) break;
+        retain=p-block_end<64*Tile::ahead;
+        base=retain?block_end:floor(p);
+    }
+    return p;
+}
+}
