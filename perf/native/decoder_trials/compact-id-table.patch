+// Widths exceeding the canonical digit encodings all produce the same rejection
+// masks. A non-power-of-two row pitch spreads common width pairs across L1 sets.
+inline constexpr unsigned joint_event_limit = 12, joint_user_limit = 13, joint_pitch = 19;
+inline constexpr auto small_joint_ids = [] {
+    A<A<JidRow, joint_pitch>, joint_event_limit + 1> rows{};
+    for (unsigned a = 0; a <= joint_event_limit; ++a)
+        for (unsigned d = 0; d <= joint_user_limit; ++d)
+            rows[a][d] = T.jid[a][d];
+    return rows;
+}();
+
+inline const JidRow& joint_ids(unsigned event_width, unsigned user_span) {
+    return small_joint_ids[std::min(event_width, joint_event_limit)]
+                          [std::min(user_span, joint_user_limit)];
+}
