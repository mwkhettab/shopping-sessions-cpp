+#pragma once
+#if defined(SHOPPING_X86_CSV) && defined(__x86_64__)
+// A certified tile has seven fields per row and quotes only in matching
+// pairs at field boundaries. Reject the complete tile before emitting rows
+// when either check fails. The scalar grammar handles long or irregular input.
+struct OrdinalMasks {
+  uint64_t separators, quotes, newlines;
+};
+
+template <size_t N>
+inline constexpr auto ordinal_newlines = [] {
+  std::array<uint64_t, N> out{};
+  for (unsigned phase = 0; phase < N; ++phase)
+    for (unsigned bit = 0; bit < 64; ++bit)
+      if ((phase + bit + 1) % N == 0)
+        out[phase] |= uint64_t{1} << bit;
+  return out;
+}();
+
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),
+               always_inline)) inline OrdinalMasks
+ordinal_masks_avx2(const char *p) {
+  auto a = row_mask32(p), b = row_mask32(p + 32);
+  auto join = [](unsigned x, unsigned y) {
+    return uint64_t(x) | (uint64_t(y) << 32);
+  };
+  auto lf = join(a.lf, b.lf);
+  return {join(a.comma, b.comma) | lf, join(a.quotes, b.quotes), lf};
+}
+
+__attribute__((target("avx512f,avx512bw"), always_inline)) inline OrdinalMasks
+ordinal_masks_wide(const char *p) {
+  auto text = _mm512_loadu_si512(p);
+  uint64_t lf = _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8('\n'));
+  return {lf | _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8(',')),
+          _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8('"')), lf};
+}
+
+__attribute__((target("avx2,pclmul"), always_inline)) inline uint64_t
+quote_prefix(uint64_t q) {
+  auto value = _mm_cvtsi64_si128(std::bit_cast<int64_t>(q));
+  return uint64_t(
+      _mm_cvtsi128_si64(_mm_clmulepi64_si128(value, _mm_set1_epi64x(-1), 0)));
+}
+
+// Each word encodes twice the position just after a separator, plus one if
+// its field ends in a quote. A certified field then has the same flag at
+// its opening and closing ends, even for an empty quoted value.
+struct MarkedEventFields {
+  const char *data;
+  std::array<uint16_t, 8> begins, lengths;
+  MarkedEventFields(const char *text, const uint16_t *cuts) : data(text) {
+    auto words = _mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts - 1));
+    auto end = _mm_srli_si128(words, 2), begin = _mm_srli_epi16(words, 1);
+    auto ones = _mm_set1_epi16(1), trim = _mm_and_si128(end, ones);
+    auto width =
+        _mm_sub_epi16(_mm_sub_epi16(_mm_srli_epi16(end, 1), ones), begin);
+    _mm_storeu_si128(reinterpret_cast<__m128i *>(begins.data()),
+                     _mm_add_epi16(begin, trim));
+    _mm_storeu_si128(reinterpret_cast<__m128i *>(lengths.data()),
+                     _mm_sub_epi16(width, _mm_add_epi16(trim, trim)));
+  }
+  Str operator[](size_t i) const { return {data + begins[i], lengths[i]}; }
+  operator std::array<Str, 7>() const {
+    constexpr size_t N = 7;
+    std::array<Str, N> values;
+    for (size_t i = 0; i < N; ++i)
+      values[i] = (*this)[i];
+    return values;
+  }
+};
+__attribute__((target("avx512f,avx512bw,avx512vbmi2"),
+               always_inline)) inline void
+save_trimmed_positions(uint16_t *out, unsigned base, uint64_t separators,
+                       uint64_t closed) {
+  alignas(64) static constexpr auto sequence = [] {
+    std::array<uint8_t, 64> values{};
+    for (unsigned i = 0; i < 64; ++i)
+      values[i] = uint8_t(2 * i);
+    return values;
+  }();
+  auto base_offsets = _mm512_load_si512(sequence.data());
+  auto marked = _mm512_mask_add_epi8(base_offsets, closed, base_offsets,
+                                     _mm512_set1_epi8(1));
+  auto packed = _mm512_maskz_compress_epi8(separators, marked);
+  auto origin = _mm512_set1_epi16(short(2 * (base + 1)));
+  auto lower = _mm512_cvtepu8_epi16(_mm512_castsi512_si256(packed));
+  _mm512_storeu_si512(out, _mm512_add_epi16(lower, origin));
+  if (std::popcount(separators) > 32) {
+    auto high = _mm512_shuffle_i64x2(packed, packed, 0xee);
+    auto upper = _mm512_cvtepu8_epi16(_mm512_castsi512_si256(high));
+    _mm512_storeu_si512(out + 32, _mm512_add_epi16(upper, origin));
+  }
+}
+template <class F>
+inline void emit_marked_event(const MarkedEventFields &row, F &fn) {
+  if constexpr (requires {
+                  fn.rich(row[0].data(), 0u, row[1].data(), 0u, row[2], row[3],
+                          row[4], row[5], row[6]);
+                }) {
+    Str id = row[0], user = row[1], arrival = row[3];
+    if (id.size() - 2 <= 7 && user.size() - 2 <= 7 && arrival.size() == 20 &&
+        fn.rich(id.data(), unsigned(id.size()), user.data(),
+                unsigned(user.size()), row[2], arrival, row[4], row[5], row[6]))
+      return;
+  }
+  fn(row);
+}
+inline void save_marked_positions(uint16_t *out, unsigned base,
+                                  uint64_t separators, uint64_t closed) {
+  while (separators) {
+    unsigned bit = std::countr_zero(separators);
+    *out++ = uint16_t(2 * (base + bit + 1) + ((closed >> bit) & 1));
+    separators &= separators - 1;
+  }
+}
+struct EightEventFields {
+  __m128i begins[6], widths[6], eligible;
+  // Each row contains the previous line end and the seven current ends. Every
+  // index stores twice the next start and the field's verified quote flag.
+  __attribute__((
+      target("avx2,bmi,bmi2,popcnt,pclmul"),
+      always_inline)) inline explicit EightEventFields(const uint16_t *cuts) {
+    __m128i pairs[8], quads[8], columns[8];
+    for (unsigned i = 0; i < 4; ++i) {
+      auto a =
+          _mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts + 14 * i - 1));
+      auto b =
+          _mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts + 14 * i + 6));
+      pairs[2 * i] = _mm_unpacklo_epi16(a, b);
+      pairs[2 * i + 1] = _mm_unpackhi_epi16(a, b);
+    }
+    for (unsigned i = 0; i < 2; ++i)
+      for (unsigned j = 0; j < 2; ++j) {
+        auto a = pairs[4 * i + j], b = pairs[4 * i + j + 2];
+        quads[4 * i + 2 * j] = _mm_unpacklo_epi32(a, b);
+        quads[4 * i + 2 * j + 1] = _mm_unpackhi_epi32(a, b);
+      }
+    for (unsigned i = 0; i < 4; ++i) {
+      columns[2 * i] = _mm_unpacklo_epi64(quads[i], quads[i + 4]);
+      columns[2 * i + 1] = _mm_unpackhi_epi64(quads[i], quads[i + 4]);
+    }
+    auto one = _mm_set1_epi16(1);
+    for (unsigned i = 0; i < 6; ++i) {
+      auto left = _mm_srli_epi16(columns[i], 1);
+      auto end = columns[i + 1], trim = _mm_and_si128(end, one);
+      begins[i] = _mm_add_epi16(left, trim);
+      auto raw =
+          _mm_sub_epi16(_mm_sub_epi16(_mm_srli_epi16(end, 1), one), left);
+      widths[i] = _mm_sub_epi16(raw, _mm_add_epi16(trim, trim));
+    }
+    auto short_id = [](__m128i width) {
+      return _mm_and_si128(_mm_cmpgt_epi16(width, _mm_set1_epi16(1)),
+                           _mm_cmpgt_epi16(_mm_set1_epi16(10), width));
+    };
+    eligible = _mm_and_si128(short_id(widths[0]), short_id(widths[1]));
+    eligible =
+        _mm_and_si128(eligible, _mm_cmpeq_epi16(widths[3], _mm_set1_epi16(20)));
+    eligible =
+        _mm_and_si128(eligible, _mm_cmpeq_epi16(widths[4], _mm_set1_epi16(4)));
+    eligible = _mm_and_si128(eligible,
+                             _mm_cmpgt_epi16(widths[5], _mm_setzero_si128()));
+  }
+  __attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),
+                 always_inline)) inline unsigned
+  common_kinds(const char *base) const {
+    auto valid = _mm256_cvtepi16_epi32(eligible);
+    auto words = _mm256_mask_i32gather_epi32(
+        _mm256_setzero_si256(), reinterpret_cast<const int *>(base),
+        _mm256_cvtepu16_epi32(begins[4]), valid, 1);
+    auto view = _mm256_cmpeq_epi32(words, _mm256_set1_epi32(0x77656976));
+    auto cart = _mm256_cmpeq_epi32(words, _mm256_set1_epi32(0x74726163));
+    return unsigned(
+        _mm256_movemask_ps(_mm256_castsi256_ps(_mm256_or_si256(view, cart))));
+  }
+  static void save(uint16_t (&out)[8], __m128i v) {
+    _mm_storeu_si128(reinterpret_cast<__m128i *>(out), v);
+  }
+};
+
+template <class F>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"))) inline void
+emit_event_batch(const char *base, const uint16_t *cuts, F &fn) {
+  EightEventFields fields(cuts);
+  unsigned mask = fields.common_kinds(base);
+  uint16_t id[8], user[8], ew[8], uw[8], ts[8], tw[8], arrival[8];
+  fields.save(id, fields.begins[0]);
+  fields.save(ew, fields.widths[0]);
+  fields.save(user, fields.begins[1]);
+  fields.save(uw, fields.widths[1]);
+  fields.save(ts, fields.begins[2]);
+  fields.save(tw, fields.widths[2]);
+  fields.save(arrival, fields.begins[3]);
+  for (unsigned i = 0; i < 8; ++i) {
+    if ((mask & (1u << i)) &&
+        fn.common(base + id[i], ew[i], base + user[i], uw[i],
+                  Str(base + ts[i], tw[i]), Str(base + arrival[i], 20)))
+      continue;
+    emit_marked_event(MarkedEventFields{base, cuts + 7 * i}, fn);
+  }
+}
+
+template <class F>
