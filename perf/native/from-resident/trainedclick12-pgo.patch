+// A logical offset addresses a byte of one of the mapped click files. The
+// directory uses one pointer per 64 KiB. No input bytes are copied or remapped.
+struct ClickFileDirectory {
+  static constexpr unsigned block_bits=16;
+  static constexpr size_t block_size=size_t{1}<<block_bits;
+  std::vector<const char *> pages;
+  std::vector<uint32_t> chunk_bases;
+  bool build(const std::vector<InputChunk> &chunks,uint64_t limit) {
+    pages.clear();chunk_bases.clear();
+    const char *last=nullptr;
+    uint32_t base=0;
+    for(const auto &chunk:chunks) {
+      if(last!=chunk.file.data()) {
+        auto bytes=chunk.file.size();
+        uint64_t blocks=bytes/block_size + (bytes%block_size!=0);
+        if(blocks>(limit>>block_bits)-pages.size())return false;
+        base=uint32_t(uint64_t(pages.size())*block_size);
+        last=chunk.file.data();
+        for(size_t i=0;i<blocks;++i)pages.push_back(last+i*block_size);
+      }
+      chunk_bases.push_back(base);
+    }
+    return true;
+  }
+  const char *get(uint32_t address)const {
+    return pages[address>>block_bits]+(address&(block_size-1));
+  }
+  // A valid first field always has a following comma (unquoted) or closing
+  // quote. NUL, CR, spaces, and non-ASCII bytes all remain data.
+  bool less(uint32_t left,uint32_t right)const {
+    if(left==right)return false;
+    auto a=reinterpret_cast<const unsigned char *>(get(left));
+    auto b=reinterpret_cast<const unsigned char *>(get(right));
+    for(;;) {
+      unsigned x=*a++,y=*b++;
+      bool ex=x==',' || x=='"', ey=y==',' || y=='"';
+      if(ex || ey)return ex && !ey;
+      if(x!=y)return x<y;
+    }
+  }
+};
+struct SourceClick {
+  uint32_t time,address;
+  int campaign;
+};
+static_assert(sizeof(SourceClick)==12);
