+template <class F>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"))) inline void
+emit_event_batch(const char *base, const uint16_t *cuts, F &fn) {
+  EightEventFields fields(cuts);
+  unsigned mask = fields.common_kinds(base),numeric_mask=0;
+  uint64_t event_index[8],user_index[8];
+  if constexpr(requires { fn.numeric(uint64_t{},uint64_t{},Str{},Str{}); }) {
+    if(!fn.cap_lanes && __builtin_cpu_supports("avx512f") && __builtin_cpu_supports("avx512bw") && __builtin_cpu_supports("avx512dq"))
