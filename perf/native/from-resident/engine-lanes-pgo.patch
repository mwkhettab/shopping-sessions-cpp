+  const size_t ucap=std::clamp<size_t>(estimate/6+1024,4096,size_t{1}<<23);
+  std::vector<std::pair<unsigned,uint64_t>> frequent;
+  for(auto [x,f]:counts)frequent.emplace_back(f,x);
+  size_t limit=std::min<size_t>(96,frequent.size());
+  std::partial_sort(frequent.begin(),frequent.begin()+limit,frequent.end(),std::greater<>{});
+  std::optional<Codec> user;
+  size_t best=0;
+  for(size_t i=0;i<limit;++i)for(unsigned a=0;a<8;++a){
+    Codec c{frequent[i].second^((first*a)&mask)};
+    size_t hit=0;
+    for(size_t j=0;j<samples.size();j+=17){
+      uint64_t n=c.ordinal(samples[j].alias);
+      hit+=(n>>9)<ucap && (n&511)<16;
+    }
+    if(hit>best){best=hit;user=c;}
+  }
+  if(!user||best*17<samples.size()*8/10)return {};
+  std::vector<std::pair<Time,uint64_t>> anchors;
+  for(auto &s:samples)if((user->ordinal(s.alias)>>9)==0 && s.time!=bad)
