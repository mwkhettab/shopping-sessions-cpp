+#pragma once
+#include "ordinal_math.hpp"
+
+// Eight canonical ASCII fields become eight integer ordinals. Each lane
+// proves its prefix, width, alphabet and range before its number is used.
+__attribute__((target("avx512f,avx512bw,avx512dq"),always_inline))
+inline __m512i base36_lanes(const char *base,__m128i starts,__m128i widths,char prefix,__mmask8 &good){
+  auto at=_mm256_cvtepu16_epi32(starts);
+  auto prefix_words=_mm512_mask_i32gather_epi64(_mm512_setzero_si512(),good,at,base,1);
+  good&=_mm512_cmpeq_epi64_mask(_mm512_and_si512(prefix_words,_mm512_set1_epi64(255)),_mm512_set1_epi64(prefix));
+  auto raw=_mm512_mask_i32gather_epi64(_mm512_setzero_si512(),good,at,base+1,1);
+  const auto digits=_mm512_sub_epi8(raw,_mm512_set1_epi8('0'));
+  const auto letters=_mm512_sub_epi8(raw,_mm512_set1_epi8('a'));
+  auto decimal=_mm512_cmple_epu8_mask(digits,_mm512_set1_epi8(9));
+  auto alpha=_mm512_cmple_epu8_mask(letters,_mm512_set1_epi8(25));
+  auto value=_mm512_mask_blend_epi8(decimal,_mm512_add_epi8(letters,_mm512_set1_epi8(10)),digits);
+  auto pad=_mm512_slli_epi64(_mm512_sub_epi64(_mm512_set1_epi64(9),_mm512_cvtepu16_epi64(widths)),3);
+  auto bad=_mm512_sllv_epi64(_mm512_movm_epi8(~(decimal|alpha)),pad);
+  good&=_mm512_cmpeq_epi64_mask(bad,_mm512_setzero_si512());
+  auto first=_mm512_and_si512(raw,_mm512_set1_epi64(255));
+  good&=_mm512_cmpneq_epi64_mask(first,_mm512_set1_epi64('0'))|
+        _mm512_cmpeq_epi64_mask(pad,_mm512_set1_epi64(56));
+  value=_mm512_sllv_epi64(value,pad);
+  auto pairs=_mm512_maddubs_epi16(value,_mm512_set1_epi16(256+36));
+  auto quads=_mm512_madd_epi16(pairs,_mm512_set1_epi32(65536+1296));
+  auto n=_mm512_add_epi64(_mm512_mul_epu32(quads,_mm512_set1_epi64(1679616)),_mm512_srli_epi64(quads,32));
+  good&=_mm512_cmple_epu64_mask(n,_mm512_set1_epi64(ordinal_ids::mask));
+  return n;
+}
+__attribute__((target("avx512f,avx512dq"),always_inline))
+inline __m512i index_dq(__m512i x,uint64_t salt){
+  using namespace ordinal_ids;
+  auto m=_mm512_set1_epi64(mask);
+  auto t=_mm512_and_si512(_mm512_mullo_epi64(x,_mm512_set1_epi64(inverse(last))),m);
+  auto u=_mm512_xor_si512(_mm512_xor_si512(t,_mm512_srli_epi64(t,17)),_mm512_srli_epi64(t,34));
+  return _mm512_and_si512(_mm512_mullo_epi64(_mm512_xor_si512(u,_mm512_set1_epi64(salt)),_mm512_set1_epi64(inverse(first))),m);
+}
+__attribute__((target("avx512f,avx512ifma")))
+inline __m512i index_ifma(__m512i x,uint64_t salt){
+  using namespace ordinal_ids;
+  auto m=_mm512_set1_epi64(mask),z=_mm512_setzero_si512();
+  auto t=_mm512_and_si512(_mm512_madd52lo_epu64(z,x,_mm512_set1_epi64(inverse(last))),m);
+  auto u=_mm512_xor_si512(_mm512_xor_si512(t,_mm512_srli_epi64(t,17)),_mm512_srli_epi64(t,34));
+  return _mm512_and_si512(_mm512_madd52lo_epu64(z,_mm512_xor_si512(u,_mm512_set1_epi64(salt)),_mm512_set1_epi64(inverse(first))),m);
+}
+template<class F> __attribute__((target("avx2,avx512f,avx512bw,avx512dq")))
+inline unsigned ordinal_packet(const char *base,const EightEventFields &fields,unsigned mask,F &fn,uint64_t (&events)[8],uint64_t (&users)[8]){
+  __mmask8 good=__mmask8(mask);
+  auto e=base36_lanes(base,fields.begins[0],fields.widths[0],'e',good);
+  auto u=base36_lanes(base,fields.begins[1],fields.widths[1],'u',good);
+  if(__builtin_cpu_supports("avx512ifma") && !fn.cap_multiply){
+    e=index_ifma(e,fn.event_salt);u=index_ifma(u,fn.user_salt);
+  }else{e=index_dq(e,fn.event_salt);u=index_dq(u,fn.user_salt);}
+  good&=_mm512_cmplt_epu64_mask(e,_mm512_set1_epi64(fn.event_bound));
+  good&=_mm512_cmplt_epu64_mask(_mm512_srli_epi64(u,9),_mm512_set1_epi64(fn.user_bound));
+  good&=_mm512_cmplt_epu64_mask(_mm512_and_si512(u,_mm512_set1_epi64(511)),_mm512_set1_epi64(16));
+  _mm512_storeu_si512(events,e);_mm512_storeu_si512(users,u);
+  return good;
+}
