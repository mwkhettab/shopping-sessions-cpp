+      if(c.ordinal(probe[0])>=ecap||c.ordinal(probe[1])>=ecap||c.ordinal(probe[2])>=ecap)continue;
+      size_t hits=0;
+      for(auto &s:samples)hits+=c.ordinal(s.event)<ecap;
+      if(hits*10>=samples.size()*9)return Fit{*user,c,ecap,ucap};
+    }
+  }
+  return {};
+}
