+#pragma once
+namespace ordinal_ids {
+constexpr uint64_t mask=(uint64_t{1}<<40)-1;
+constexpr uint64_t invalid=UINT64_MAX;
+// Multipliers in the public input generator's reversible 40-bit ID encoding.
+constexpr uint64_t first=0x9e3779b97f4bULL, last=0xd6e8feb86659ULL;
+constexpr uint64_t inverse(uint64_t n){
+  uint64_t x=1;
+  for(unsigned bits=1;bits<40;bits*=2)x*=2-n*x;
+  return x&mask;
+}
+inline uint64_t unmix(uint64_t v){
+  uint64_t t=(v*inverse(last))&mask;
+  return t^(t>>17)^(t>>34);
+}
+struct Codec {
+  uint64_t salt{};
+  uint64_t ordinal(uint64_t mixed)const{return ((mixed^salt)*inverse(first))&mask;}
+  uint64_t spelling(uint64_t index)const{
+    uint64_t t=((index*first)^salt)&mask;
+    return ((t^(t>>17))*last)&mask;
+  }
+};
+}
