+#pragma once
+#ifdef SHOPPING_X86_CSV
+// Each separator gets an ordinal in a tile. A valid event has a newline
+// at exactly every seventh ordinal. Quotes must pair at field boundaries
+// before any event is emitted. All failed tiles use the existing row parser.
+struct OrdinalMasks {
+  uint64_t separators, quotes, newlines;
+};
+
+template <size_t N>
+inline constexpr auto ordinal_newlines = [] {
+  std::array<uint64_t, N> out{};
+  for (unsigned phase = 0; phase < N; ++phase)
+    for (unsigned bit = 0; bit < 64; ++bit)
+      if ((phase + bit + 1) % N == 0)
+        out[phase] |= uint64_t{1} << bit;
+  return out;
+}();
+
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),
+               always_inline)) inline OrdinalMasks
+ordinal_masks_avx2(const char *p) {
+  auto a = row_mask32(p), b = row_mask32(p + 32);
+  auto join = [](unsigned x, unsigned y) {
+    return uint64_t(x) | (uint64_t(y) << 32);
+  };
+  auto lf = join(a.lf, b.lf);
+  return {join(a.comma, b.comma) | lf, join(a.quotes, b.quotes), lf};
+}
+
+__attribute__((target("avx512f,avx512bw"), always_inline)) inline OrdinalMasks
+ordinal_masks_wide(const char *p) {
+  auto text = _mm512_loadu_si512(p);
+  uint64_t lf = _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8('\n'));
+  return {lf | _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8(',')),
+          _mm512_cmpeq_epi8_mask(text, _mm512_set1_epi8('"')), lf};
+}
+
+__attribute__((target("avx2,pclmul"), always_inline)) inline uint64_t
+quote_prefix(uint64_t q) {
+  auto value = _mm_cvtsi64_si128(std::bit_cast<int64_t>(q));
+  return uint64_t(
+      _mm_cvtsi128_si64(_mm_clmulepi64_si128(value, _mm_set1_epi64x(-1), 0)));
+}
+struct OrdinalFields16 {
+  const char *data;
+  const uint16_t *end;
+  Str operator[](size_t i) const {
+    unsigned start = uint16_t(end[std::ptrdiff_t(i) - 1] + 1);
+    unsigned cut = end[i], trim = data[start] == '"';
+    return {data + start + trim, cut - start - 2 * trim};
+  }
+  template <size_t N> operator std::array<Str, N>() const {
+    std::array<Str, N> out;
+    for (unsigned i = 0; i < N; ++i)
+      out[i] = (*this)[i];
+    return out;
+  }
+};
+
+template <size_t N, class Row, class F>
+inline void emit_ordinal_row(const Row &row, F &fn) {
+  if constexpr (N == 7 && requires {
+                  fn.common(static_cast<const char *>(nullptr), 0u,
+                            static_cast<const char *>(nullptr), 0u, Str{},
+                            Str{});
+                }) {
+    Str kind = row[4];
+    if (kind.size() == 4 && (std::memcmp(kind.data(), "view", 4) == 0 ||
+                             std::memcmp(kind.data(), "cart", 4) == 0)) {
+      Str id = row[0], user = row[1], ingest = row[3];
+      if (id.size() - 2 <= 7 && user.size() - 2 <= 7 && ingest.size() == 20 &&
+          !row[5].empty() &&
+          fn.common(id.data(), unsigned(id.size()), user.data(),
+                    unsigned(user.size()), row[2], ingest))
+        return;
+    }
+  }
+  fn(row);
+}
+
+__attribute__((target("avx512f,avx512bw,avx512vbmi2"),
+               always_inline)) inline void
+save_positions16(uint16_t *out, uint16_t offset, uint64_t mask) {
+  alignas(64) static constexpr auto sequence = [] {
+    std::array<uint8_t, 64> s{};
+    for (unsigned i = 0; i < 64; ++i)
+      s[i] = uint8_t(i);
+    return s;
+  }();
+  auto packed =
+      _mm512_maskz_compress_epi8(mask, _mm512_load_si512(sequence.data()));
+  auto origin = _mm512_set1_epi16(short(offset));
+  auto first = _mm512_cvtepu8_epi16(_mm512_castsi512_si256(packed));
+  _mm512_storeu_si512(out, _mm512_add_epi16(first, origin));
+  if (std::popcount(mask) > 32) {
+    auto high = _mm512_shuffle_i64x2(packed, packed, 0xee);
+    auto second = _mm512_cvtepu8_epi16(_mm512_castsi512_si256(high));
+    _mm512_storeu_si512(out + 32, _mm512_add_epi16(second, origin));
+  }
+}
