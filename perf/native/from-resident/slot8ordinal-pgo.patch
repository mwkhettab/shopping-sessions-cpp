+#pragma once
+// A primary slot owns the alias and its running event and click counts. Once
+// assigned, its index remains usable by every raw record until the scatter.
+template<class Index,unsigned Probes,bool Remember> struct FlatAliasGroups {
+  struct Group {Key key{};Index event_end{},click_end{},vertex{};};
+  std::vector<Group> primary,extra;
+  std::vector<uint32_t> live;
+  std::unordered_map<Key,size_t,KeyHash> spilled;
+  explicit FlatAliasGroups(size_t size):primary(size) {}
+  std::pair<size_t,Group*> intern(Key key) {
+    size_t mask=primary.size()-1,at=(key.hash()/shards)&mask;
+    for(unsigned attempt=0;attempt<Probes;++attempt,at=(at+1)&mask) {
+      Group &g=primary[at];
+      if(g.key==key)return {at,&g};
+      if(!g.key.bits) {
+        g.key=key;
+        if constexpr(Remember)live.push_back(uint32_t(at));
+        return {at,&g};
+      }
+    }
+    auto [it,added]=spilled.try_emplace(key,extra.size());
+    if(added)extra.push_back({key});
+    return {primary.size()+it->second,&extra[it->second]};
+  }
+  Group &operator[](size_t i){return i<primary.size()?primary[i]:extra[i-primary.size()];}
+  template<class Visit> void visit(Visit f){
+    if constexpr(Remember){for(auto i:live)f(primary[i]);}
+    else {for(auto &g:primary)if(g.key.bits)f(g);}
+    for(auto &g:extra)f(g);
+  }
+};
