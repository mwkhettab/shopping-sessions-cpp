+#pragma once
+
+// Each reader owns its direct-address counters during parsing. The complete
+// identifier distinguishes every collision. Unassigned rows remain in an
+// explicit list, so the grouping stage reads just those full identifiers.
+template<size_t MaximumSlots, unsigned Probes> struct CountedAliasSlots {
+  struct Slot {
+    Key key;
+    size_t events{}, clicks{}, merged{};
+  };
+  struct Partition {
+    std::vector<uint32_t> occupied;
+    std::vector<size_t> uncached_events, uncached_clicks;
+  };
+  std::vector<Slot> slots;
+  std::array<Partition, shards> parts;
+  size_t width{1};
+  void prepare(size_t records_per_partition) {
+    width=std::bit_ceil(std::clamp<size_t>(records_per_partition/3,1,MaximumSlots));
+    slots.resize(width*shards);
+  }
+  static constexpr bool counted(uintptr_t v) {return (v&3)==3;}
+  Slot &get(size_t shard, size_t i) {return slots[shard*width+i];}
+  template<bool Click>
+  Key observe(size_t shard, Key name, size_t row) {
+    const size_t mask=width-1;
+    size_t at=(name.hash()/shards)&mask;
+    for(unsigned k=0;k<Probes;++k,at=(at+1)&mask) {
+      auto &slot=get(shard,at);
+      if(!slot.key.bits) {
+        slot.key=name;
+        parts[shard].occupied.push_back(uint32_t(at));
+      } else if(!(slot.key==name)) continue;
+      if constexpr(Click)++slot.clicks;
+      else ++slot.events;
+      return Key{(uintptr_t(at)<<2)|3};
+    }
+    if constexpr(Click)parts[shard].uncached_clicks.push_back(row);
+    else parts[shard].uncached_events.push_back(row);
+    return name;
+  }
+  void discard(size_t shard, Key &row) {
+    if(counted(row.bits))
+      std::atomic_ref<size_t>(get(shard,row.bits>>2).events).fetch_sub(1,std::memory_order_relaxed);
+    row.bits=0;
+  }
+};
