+#pragma once
+
+struct SessionCredit {
+  Time start;
+  int64_t revenue;
+  int32_t day;
+};
+
+struct SessionClickMasks {
+  std::array<SessionCredit,64> sessions;
+  ScratchArray<uint64_t> campaign;
+  std::vector<int> touched;
+
+  static uint64_t prefix(unsigned n) {
+    return n ? UINT64_MAX >> (64-n) : 0;
+  }
+
+#ifdef SHOPPING_X86_CSV
+  template<unsigned Blocks, class Layout, class Click, class Offer>
+  __attribute__((target("avx2"),noinline))
+  static void packed_ranges(std::span<Click> rows, const uint32_t *relative,
+                            Time origin, Time last, uint64_t active,
+                            Layout layout, Offer &offer) {
+    __m256i starts[Blocks];
+    for(unsigned i=0;i<Blocks;++i)
+      starts[i]=_mm256_loadu_si256(reinterpret_cast<const __m256i *>(relative+8*i));
+    const auto sign=_mm256_set1_epi32(INT32_MIN);
+    const auto limit=_mm256_set1_epi32(int32_t(INT32_MIN+reach+1));
+    for(const auto &click:rows) {
+      Time t=layout.click_time(click);
+      if(t<origin || t>last)continue;
+      auto value=_mm256_set1_epi32(std::bit_cast<int32_t>(uint32_t(t-origin)));
+      uint64_t mask=0;
+      for(unsigned j=0;j<Blocks;++j) {
+        auto gap=_mm256_xor_si256(_mm256_sub_epi32(starts[j],value),sign);
+        unsigned bits=unsigned(_mm256_movemask_ps(_mm256_castsi256_ps(_mm256_cmpgt_epi32(limit,gap))));
+        mask|=uint64_t(bits)<<(8*j);
+      }
+      if(uint64_t covered=mask&active)offer(click,covered);
+    }
+  }
+#endif
+  template<class Layout, class Visit, class At>
+  void attribute(unsigned n, Layout layout, Visit visit, At at) {
+    using Click=typename Layout::C;
+    std::array<Time,64> starts,oldest;
+    std::array<uint64_t,64> day_masks;
+    std::array<const Click *,64> winners;
+    std::fill_n(winners.begin(),n,nullptr);
+    for(unsigned i=0;i<n;) {
+      unsigned first=i;
+      do {
+        starts[i]=sessions[i].start;
+        oldest[i]=starts[i]-reach;
+        ++i;
+      } while(i<n && sessions[i].day==sessions[first].day);
+      std::fill(day_masks.begin()+first,day_masks.begin()+i,prefix(i)&~prefix(first));
+    }
+    auto newer=[](const Click *next,const Click *old){
+      return !old || next->ts>old->ts || (next->ts==old->ts && next->id.user_less(old->id,'k'));
+    };
+    auto offer=[&](const Click &click,uint64_t bits) {
+      unsigned first=unsigned(std::countr_zero(bits));
+      if(newer(&click,winners[first]))winners[first]=&click;
+      auto &mask=campaign[click.campaign];
+      if(!mask)touched.push_back(click.campaign);
+      mask|=bits;
+    };
+    bool packed=false;
+#if defined(SHOPPING_X86_CSV) && SHOP_MASK_VECTOR
+    if (__builtin_cpu_supports("avx2") && n>1 &&
+        uint64_t(starts[n-1])-uint64_t(oldest[0])<=UINT32_MAX-uint64_t(reach)-1) {
+      std::array<uint32_t,64> relative{};
+      for(unsigned i=0;i<n;++i)relative[i]=uint32_t(starts[i]-oldest[0]);
+      const auto valid=prefix(n);
+      auto process=[&]<unsigned Blocks>() {
+        visit([&](std::span<Click> rows){
+          packed_ranges<Blocks>(rows,relative.data(),oldest[0],starts[n-1],valid,layout,offer);
+        });
+      };
+      if(n<=8)process.template operator()<1>();
+      else if(n<=16)process.template operator()<2>();
+      else if(n<=32)process.template operator()<4>();
+      else process.template operator()<8>();
+      packed=true;
+    }
+#endif
+    if(!packed)visit([&](std::span<Click> rows) {
+      for(const Click &click:rows) {
+        auto time=layout.click_time(click);
+        if(time<oldest[0] || time>starts[n-1])continue;
+        unsigned first=0,last=1;
+        if(n!=1) {
+          first=unsigned(std::lower_bound(starts.begin(),starts.begin()+n,time)-starts.begin());
+          last=unsigned(std::upper_bound(oldest.begin()+first,oldest.begin()+n,time)-oldest.begin());
+          if(first==last)continue;
+        }
+        offer(click,prefix(last)&~prefix(first));
+      }
+    });
+    const Click *winner=nullptr;
+    for(unsigned i=0;i<n;++i) {
+      if(winners[i] && newer(winners[i],winner))winner=winners[i];
+      int index=winner && layout.click_time(*winner)>=oldest[i]?winner->campaign:0;
+      const auto &session=sessions[i];
+      auto &counts=at(index,session.day);
+      ++counts.sessions;
+      counts.purchases+=session.revenue!=0;
+      counts.revenue+=session.revenue;
+    }
+    for(int id:touched) {
+      auto &stored=campaign[id];
+      uint64_t bits=stored;
+      stored=0;
+      while(bits) {
+        auto i=std::countr_zero(bits);
+        at(id,sessions[i].day).assists+=std::popcount(bits&day_masks[i]);
+        bits&=~day_masks[i];
+      }
+    }
+    touched.clear();
+  }
+};
