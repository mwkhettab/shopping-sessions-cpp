+#pragma once
+
+// Resolve each coarse event-ID shard in small, independent hash tables.
+// The short tag only rejects unequal IDs. A possible match always reads
+// the complete identifier and compares its original spelling when indirect.
+template<unsigned LogSlots, class Value, class Workers, class Match, class Merge>
+bool resolve_in_cache(Workers &workers,size_t shard,size_t count,Match equal,Merge merge) {
+  static_assert(LogSlots>=8 && LogSlots<=16);
+  constexpr size_t slots=size_t{1}<<LogSlots;
+  if(!count)return true;
+  const size_t target=slots/2;
+  size_t bands=std::bit_ceil((count+target-1)/target);
+  if(bands>4096)return false;
+  struct Entry { Value reference; uint16_t home; uint8_t tag; };
+  std::vector<std::vector<Entry>> lists(bands);
+  size_t expected=count/bands+64;
+  for(auto &list:lists)list.reserve(expected);
+  for(unsigned owner=0;owner<workers.size();++owner){
+    const auto &rows=workers[owner].candidates[shard];
+    for(size_t i=0;i<rows.size();++i) {
+      Key k=rows.key(i);
+      auto h=k.hash()/shards;
+      size_t band=(h>>LogSlots)&(bands-1);
+      Value ref=Value(1+(uint64_t(i)<<6)+owner);
+      uint8_t tag=uint8_t(1+((h>>24)^(h>>40))%127);
+      lists[band].push_back({ref,uint16_t(h&(slots-1)),tag});
+    }
+  }
+  // Preflight every table before any worker touches a loser. This also
+  // bounds probe lengths if exotic keys produce one abnormally large band.
+  for(const auto &list:lists)if(list.size()>slots*3/4)return false;
+  std::vector<uint8_t> tags(slots);
+  auto values=std::make_unique_for_overwrite<Value[]>(slots);
+  for(const auto &list:lists) {
+    std::fill(tags.begin(),tags.end(),0);
+    for(const auto &item:list) {
+      size_t dest=item.home;
+      for(;;dest=(dest+1)&(slots-1)) {
+        if(!tags[dest]){tags[dest]=item.tag;values[dest]=item.reference;break;}
+        if(tags[dest]==item.tag && equal(values[dest],item.reference)){
+          if(merge(values[dest],item.reference))values[dest]=item.reference;
+          break;
+        }
+      }
+    }
+  }
+  return true;
+}
