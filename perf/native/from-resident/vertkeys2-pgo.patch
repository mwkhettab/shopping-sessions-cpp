+// Instantiate the same grammar and emission loop with each runtime-checked ISA.
+template<size_t N,bool Lookup,class F>
+__attribute__((target(ORDINAL_TARGET))) void ORDINAL_READER(Str data,F &fn){
+  alignas(64) std::array<uint8_t,1+256+64> positions;
+  positions[0]=255;
+  auto *cuts=positions.data()+1;
+  while(data.size()>=256){
+    const char *p=data.data();
+    OrdinalMasks m[4];
+    for(unsigned b=0;b<4;++b){
+#if ORDINAL_USE_WIDE
+      m[b]=ordinal_masks_wide(p+b*64);
+#else
+      m[b]=ordinal_masks_avx2(p+b*64);
+#endif
+    }
+    unsigned blocks=4;
+    while(blocks && !m[blocks-1].newlines)--blocks;
+    if(!blocks){
+      auto lf=data.find('\n',256),n=lf==Str::npos?data.size():lf+1;
+      scalar_rows<N>(data.substr(0,n),fn);data.remove_prefix(n);continue;
+    }
+    unsigned length=64u*blocks-std::countl_zero(m[blocks-1].newlines);
+    uint64_t tail=mask_to(length-(blocks-1)*64);
+    m[blocks-1].separators&=tail;m[blocks-1].quotes&=tail;
+    uint64_t inside=0,prev=1,invalid=0;
+    unsigned nc=0;
+    for(unsigned b=0;b<blocks;++b){
+      auto [sep,q,lf]=m[b];
+      auto count=unsigned(std::popcount(sep));
+      uint64_t want=ordinal_newlines<N>[nc%N]&mask_to(count);
+      invalid|=_pext_u64(lf,sep)^want;
+      uint64_t parity=quote_prefix(q)^inside;
+      uint64_t next=b+1<blocks?(m[b+1].separators&1):1;
+      invalid|=((q&parity)&~((sep<<1)|prev))|((q&~parity)&~((sep>>1)|(next<<63)))|(sep&parity);
+      inside=uint64_t(0)-(parity>>63);prev=sep>>63;
+#if ORDINAL_USE_WIDE
+      ordinal_positions_wide(cuts+nc,b*64,sep);
+#else
+      ordinal_positions<Lookup>(cuts+nc,b*64,sep);
+#endif
+      nc+=count;
+    }
+    if(invalid || inside || nc%N){
+      tiled_lines<N,16>(data.substr(0,length),fn);
+    }else{
+      for(unsigned i=0;i<nc;i+=N){OrdinalFields row{p,cuts+i};fn(row);}
+    }
+    data.remove_prefix(length);
+  }
+  tiled_lines<N,16>(data,fn);
+}
