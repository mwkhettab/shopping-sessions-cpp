+#pragma once
+#ifdef SHOPPING_X86_CSV
+#include "trimmed_ordinals.hpp"
+#include "vertical_fields.hpp"
+// A tile may contain arbitrarily long fields. Every absolute delimiter offset
+// fits in 16 bits, including a newline at the very end of its register group.
+struct OrdinalFields16 {
+  const char *data;
+  const uint16_t *end;
+  Str operator[](size_t i) const {
+    unsigned start=uint16_t(end[std::ptrdiff_t(i)-1]+1);
+    unsigned cut=end[i],trim=data[start]=='"';
+    return {data+start+trim,cut-start-2*trim};
+  }
+  template<size_t N> operator std::array<Str,N>()const{
+    std::array<Str,N> out;
+    for(unsigned i=0;i<N;++i)out[i]=(*this)[i];
+    return out;
+  }
+};
+
+template<size_t N,class Row,class F>
+inline void emit_ordinal_row(const Row &row,F &fn) {
+  if constexpr(N==7 && requires{fn.common(static_cast<const char*>(nullptr),0u,static_cast<const char*>(nullptr),0u,Str{},Str{});}){
+    Str kind=row[4];
+    if(kind.size()==4 && (std::memcmp(kind.data(),"view",4)==0 || std::memcmp(kind.data(),"cart",4)==0)){
+      Str id=row[0],user=row[1],ingest=row[3];
+      if(id.size()-2<=7 && user.size()-2<=7 && ingest.size()==20 && !row[5].empty() &&
+         fn.common(id.data(),unsigned(id.size()),user.data(),unsigned(user.size()),row[2],ingest))return;
+    }
+  }
+  fn(row);
+}
