+  auto remainder=_mm512_slli_epi64(_mm512_sub_epi64(_mm512_set1_epi64(9),lengths),3);
+  auto suffix=_mm512_and_si512(words,_mm512_srlv_epi64(_mm512_set1_epi64(-1),remainder));
+  auto last_shift=_mm512_slli_epi64(_mm512_sub_epi64(lengths,_mm512_set1_epi64(2)),3);
+  auto last=_mm512_and_si512(_mm512_srlv_epi64(suffix,last_shift),_mm512_set1_epi64(255));
+  live&=_mm512_cmpneq_epi64_mask(last,_mm512_setzero_si512());
+  live&=_mm512_cmpge_epi64_mask(suffix,_mm512_setzero_si512());
+  auto mixed=_mm512_xor_si512(suffix,_mm512_srli_epi64(suffix,27));
+  auto product=_mm512_mullo_epi64(mixed,_mm512_set1_epi64(static_cast<long long>(0x9e3779b97f4a7c15ULL)));
+  auto low=_mm512_and_si512(product,_mm512_set1_epi64(INT64_MAX));
+  return _mm512_slli_epi64(_mm512_xor_si512(low,_mm512_srli_epi64(low,31)),1);
+}
+template<class F> SHOP_KEYBATCH inline void emit_key_batch(const char *base,const uint16_t *cuts,F &fn){
+  EightEventFields fields(cuts);
+  __mmask8 mask=__mmask8(fields.common_kinds(base));
+  auto ids=eight_key_hashes(base,fields.begins[0],fields.widths[0],'e',mask);
+  auto users=eight_key_hashes(base,fields.begins[1],fields.widths[1],'u',mask);
+  uint64_t id[8],user[8];
+  uint16_t ts[8],tw[8],arrival[8];
+  _mm512_storeu_si512(id,ids);_mm512_storeu_si512(user,users);
+  fields.save(ts,fields.begins[2]);fields.save(tw,fields.widths[2]);fields.save(arrival,fields.begins[3]);
+  for(unsigned i=0;i<8;++i){
+    if(mask&(1u<<i))fn.prepared(id[i],user[i],Str(base+ts[i],tw[i]),Str(base+arrival[i],20));
+    else fn(TrimmedFields{base,cuts+7*i});
+  }
+}
