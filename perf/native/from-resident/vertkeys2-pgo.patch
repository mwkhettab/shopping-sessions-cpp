+__attribute__((target("avx512f,avx512bw,avx512vbmi2"),always_inline)) inline void
+save_trimmed_positions(uint16_t *out,unsigned base,uint64_t separators,uint64_t closed) {
+  alignas(64) static constexpr auto sequence=[] {
+    std::array<uint8_t,64> values{};
+    for(unsigned i=0;i<64;++i)values[i]=uint8_t(2*i);
