+struct TrimmedFields {
+  const char *data;
+  const uint16_t *end;
+  Str operator[](size_t i) const {
+    unsigned last=end[i], trim=last&1;
+    unsigned begin=end[std::ptrdiff_t(i)-1]>>1;
+    return {data+begin+trim, (last>>1)-1-begin-2*trim};
+  }
+  template<size_t N> operator std::array<Str,N>() const {
+    std::array<Str,N> values;
+    for(size_t i=0;i<N;++i) values[i]=(*this)[i];
+    return values;
+  }
+};
+struct LaneFields {
+  const char *data;
+  std::array<uint16_t,8> begins,lengths;
+  LaneFields(const char *text,const uint16_t *cuts):data(text) {
+    auto words=_mm_loadu_si128(reinterpret_cast<const __m128i*>(cuts-1));
+    auto end=_mm_srli_si128(words,2), begin=_mm_srli_epi16(words,1);
+    auto ones=_mm_set1_epi16(1), trim=_mm_and_si128(end,ones);
+    auto width=_mm_sub_epi16(_mm_sub_epi16(_mm_srli_epi16(end,1),ones),begin);
