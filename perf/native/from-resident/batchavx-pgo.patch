+#pragma once
+
+#define SHOP_ROWBATCH __attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),always_inline)) inline
+#define SHOP_KEYBATCH __attribute__((target("avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw,avx512dq")))
+
+struct TransposedFields {
+  __m128i begins[6], widths[6], eligible;
+  // Each row contains the previous line end and the seven current ends. Every
+  // index stores twice the next start and the field's verified quote flag.
+  SHOP_ROWBATCH explicit TransposedFields(const uint16_t *cuts) {
+    __m128i pairs[8],quads[8],columns[8];
+    for(unsigned i=0;i<4;++i){
+      auto a=_mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts+14*i-1));
+      auto b=_mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts+14*i+6));
+      pairs[2*i]=_mm_unpacklo_epi16(a,b);
+      pairs[2*i+1]=_mm_unpackhi_epi16(a,b);
+    }
+    for(unsigned i=0;i<2;++i)for(unsigned j=0;j<2;++j){
+      auto a=pairs[4*i+j],b=pairs[4*i+j+2];
+      quads[4*i+2*j]=_mm_unpacklo_epi32(a,b);
+      quads[4*i+2*j+1]=_mm_unpackhi_epi32(a,b);
+    }
+    for(unsigned i=0;i<4;++i){
+      columns[2*i]=_mm_unpacklo_epi64(quads[i],quads[i+4]);
+      columns[2*i+1]=_mm_unpackhi_epi64(quads[i],quads[i+4]);
+    }
+    auto one=_mm_set1_epi16(1);
+    for(unsigned i=0;i<6;++i){
+      auto left=_mm_srli_epi16(columns[i],2);
+      auto end=columns[i+1],trim=_mm_and_si128(end,one);
+      begins[i]=_mm_add_epi16(left,trim);
+      auto raw=_mm_sub_epi16(_mm_sub_epi16(_mm_srli_epi16(end,2),one),left);
+      widths[i]=_mm_sub_epi16(raw,_mm_add_epi16(trim,trim));
+    }
+    auto short_id=[](__m128i width){
+      return _mm_and_si128(_mm_cmpgt_epi16(width,_mm_set1_epi16(1)),
+                           _mm_cmpgt_epi16(_mm_set1_epi16(10),width));
+    };
+    eligible=_mm_and_si128(short_id(widths[0]),short_id(widths[1]));
+    eligible=_mm_and_si128(eligible,_mm_cmpeq_epi16(widths[3],_mm_set1_epi16(20)));
+    eligible=_mm_and_si128(eligible,_mm_cmpeq_epi16(widths[4],_mm_set1_epi16(4)));
+    eligible=_mm_and_si128(eligible,_mm_cmpgt_epi16(widths[5],_mm_setzero_si128()));
+  }
+  SHOP_ROWBATCH unsigned common_kinds(const char *base) const {
+    auto valid=_mm256_cvtepi16_epi32(eligible);
+    auto words=_mm256_mask_i32gather_epi32(_mm256_setzero_si256(),reinterpret_cast<const int *>(base),
+                                           _mm256_cvtepu16_epi32(begins[4]),valid,1);
+    auto view=_mm256_cmpeq_epi32(words,_mm256_set1_epi32(0x77656976));
+    auto cart=_mm256_cmpeq_epi32(words,_mm256_set1_epi32(0x74726163));
+    return unsigned(_mm256_movemask_ps(_mm256_castsi256_ps(_mm256_or_si256(view,cart))));
+  }
+  static void save(uint16_t (&out)[8],__m128i v){
+    _mm_storeu_si128(reinterpret_cast<__m128i *>(out),v);
+  }
+};
+
+template<class F>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"))) inline void
+emit_stream_batch(const char *base,const uint16_t *cuts,F &fn){
+  TransposedFields fields(cuts);
+  unsigned mask=fields.common_kinds(base);
+  uint16_t id[8],user[8],ew[8],uw[8],ts[8],tw[8],arrival[8];
+  fields.save(id,fields.begins[0]);fields.save(ew,fields.widths[0]);
+  fields.save(user,fields.begins[1]);fields.save(uw,fields.widths[1]);
+  fields.save(ts,fields.begins[2]);fields.save(tw,fields.widths[2]);fields.save(arrival,fields.begins[3]);
+  for(unsigned i=0;i<8;++i){
+    if((mask&(1u<<i)) && fn.common(base+id[i],ew[i],base+user[i],uw[i],Str(base+ts[i],tw[i]),Str(base+arrival[i],20)))continue;
+    emit_marked_event(MarkedEventFields{base,cuts+7*i},fn);
+  }
+}
