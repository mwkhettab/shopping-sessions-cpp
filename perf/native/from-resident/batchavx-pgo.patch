+template<class F>
+__attribute__((target(STREAM_TARGET))) void STREAM_NAME(Str data,F &fn) {
+  constexpr unsigned Bytes=STREAM_BYTES, N=7;
+  alignas(64) std::array<uint16_t,Bytes+65> storage;
+  storage[0]=0;
+  uint16_t *cuts=storage.data()+1;
+  while(data.size()>=Bytes) {
+    const char *text=data.data();
+    uint64_t inside=0, previous_separator=1, pending_close=0, invalid=0;
+    unsigned nc=0,physical_lines=0;
+    for(unsigned b=0;b<Bytes/64;++b) {
+      auto [sep,quotes,lf]=STREAM_MASK(text+64*b);
+      unsigned count=std::popcount(sep);
+      uint64_t parity=quote_prefix(quotes)^inside;
+      uint64_t opening=quotes&parity, closing=quotes&~parity;
+      uint64_t must_separate=(closing<<1)|pending_close;
+      invalid|=(opening&~((sep<<1)|previous_separator)) | (must_separate&~sep) | (sep&parity);
+      inside=uint64_t(0)-(parity>>63);previous_separator=sep>>63;pending_close=closing>>63;
+#if STREAM_VERIFY == 0
+      invalid|=_pext_u64(lf,sep)^(ordinal_newlines<N>[nc%N]&mask_to(count));
+#elif STREAM_VERIFY == 1
+      physical_lines+=std::popcount(lf);
+#endif
+      STREAM_SAVE(cuts+nc,64*b,sep,must_separate,lf);
+      nc+=count;
+    }
+    unsigned rows=nc/N, complete=rows*N;
+#if STREAM_VERIFY == 1
+    invalid|=rows^physical_lines;
+    for(unsigned i=N-1;i<complete;i+=N)invalid|=(cuts[i]&2)^2;
+#elif STREAM_VERIFY == 2
+    invalid|=STREAM_CHECK(cuts,complete);
+#elif STREAM_VERIFY == 3
+    // The first seven words of each row must carry [0,0,0,0,0,0,1].
+    // Use scalar words for the last row to avoid reading an unassigned lane.
+    unsigned i=0;
+    for(;complete-i>7;i+=7) {
+      auto block=_mm_loadu_si128(reinterpret_cast<const __m128i*>(cuts+i));
+      unsigned flags=unsigned(_mm_movemask_epi8(_mm_slli_epi16(block,14)))&0x3fff;
+      invalid|=flags^(1u<<13);
+    }
+    for(;i<complete;++i)invalid|=(cuts[i]&2)^((i%N==N-1)*2);
+#endif
+    if(!invalid && complete) {
+      // Every seventh separator in this prefix is a proven physical newline.
+      // Bytes in the incomplete final row belong to the next tile.
+      unsigned length=cuts[complete-1]>>STREAM_SHIFT;
+      unsigned i=0;
+      if constexpr(requires{fn.common(text,2u,text,2u,Str{},Str{});})
+        for(;complete-i>=8*N;i+=8*N)emit_stream_batch(text,cuts+i,fn);
+      for(;i<complete;i+=N)emit_marked_event(MarkedEventFields{text,cuts+i},fn);
+      data.remove_prefix(length);
+    } else {
+      auto last=data.substr(0,Bytes).rfind('\n');
+      if(last==Str::npos) {
+        auto end=data.find('\n',Bytes);
+        size_t take=end==Str::npos?data.size():end+1;
+        scalar_rows<N>(data.substr(0,take),fn);data.remove_prefix(take);
+      } else {
+        tiled_lines<N,16>(data.substr(0,last+1),fn);data.remove_prefix(last+1);
+      }
+    }
+  }
+  tiled_lines<N,16>(data,fn);
+}
