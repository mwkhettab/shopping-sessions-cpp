+#pragma once
+
+template<unsigned Shift>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),always_inline)) inline void
+save_stream_scalar(uint16_t *out,unsigned base,uint64_t sep,uint64_t close,uint64_t lf) {
+  while(sep) {
+    unsigned i=std::countr_zero(sep);
+    *out++=uint16_t(((base+i+1)<<Shift)+((close>>i)&1)+
+                    (Shift==2?2*((lf>>i)&1):0));
+    sep&=sep-1;
+  }
+}
+template<unsigned Shift>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw,avx512vbmi2"),always_inline)) inline void
+save_stream_wide(uint16_t *out,unsigned base,uint64_t sep,uint64_t close,uint64_t lf) {
+  alignas(64) static constexpr auto offsets=[]{
+    std::array<uint8_t,64> v{};
+    for(unsigned i=0;i<64;++i)v[i]=uint8_t(i<<Shift);
+    return v;
+  }();
+  auto s=_mm512_load_si512(offsets.data());
+  s=_mm512_mask_add_epi8(s,close,s,_mm512_set1_epi8(1));
+  if constexpr(Shift==2)s=_mm512_mask_add_epi8(s,lf,s,_mm512_set1_epi8(2));
+  auto bytes=_mm512_maskz_compress_epi8(sep,s);
+  auto delta=_mm512_set1_epi16(short((base+1)<<Shift));
+  auto low=_mm512_cvtepu8_epi16(_mm512_castsi512_si256(bytes));
+  _mm512_storeu_si512(out,_mm512_add_epi16(low,delta));
+  if(std::popcount(sep)>32) {
+    auto high=_mm512_shuffle_i64x2(bytes,bytes,0xee);
+    _mm512_storeu_si512(out+32,_mm512_add_epi16(_mm512_cvtepu8_epi16(_mm512_castsi512_si256(high)),delta));
+  }
+}
+template<unsigned Shift>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw"),always_inline)) inline void
+save_stream_dwords(uint16_t *out,unsigned base,uint64_t sep,uint64_t close,uint64_t lf) {
+  alignas(64) static constexpr auto seq=[]{
+    std::array<int,16> v{};
+    for(unsigned i=0;i<16;++i)v[i]=i<<Shift;
+    return v;
+  }();
+  auto start=_mm512_add_epi32(_mm512_load_si512(seq.data()),_mm512_set1_epi32((base+1)<<Shift));
+  for(unsigned g=0;g<4;++g){
+    __mmask16 used=__mmask16(sep);
+    if(used){
+      auto marked=_mm512_mask_add_epi32(start,__mmask16(close),start,_mm512_set1_epi32(1));
+      if constexpr(Shift==2)marked=_mm512_mask_add_epi32(marked,__mmask16(lf),marked,_mm512_set1_epi32(2));
+      auto packed=_mm512_maskz_compress_epi32(used,marked);
+      _mm256_storeu_si256(reinterpret_cast<__m256i*>(out),_mm512_cvtepi32_epi16(packed));
+      out+=std::popcount(uint16_t(used));
+    }
+    sep>>=16;close>>=16;lf>>=16;start=_mm512_add_epi32(start,_mm512_set1_epi32(16<<Shift));
+  }
+}
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),always_inline)) inline unsigned
+check_stream_avx2(const uint16_t *cuts,unsigned n) {
+  unsigned i=0,invalid=0;
+  for(;n-i>=16;i+=16) {
+    auto value=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(cuts+i));
+    auto flags=_pext_u32(unsigned(_mm256_movemask_epi8(_mm256_slli_epi16(value,14))),0xaaaaaaaaU);
+    invalid|=flags^uint16_t(ordinal_newlines<7>[i%7]);
+  }
+  for(;i<n;++i)invalid|=(cuts[i]&2)^((i%7==6)*2);
+  return invalid;
+}
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw"),always_inline)) inline unsigned
+check_stream_wide(const uint16_t *cuts,unsigned n) {
+  unsigned i=0,invalid=0;
+  for(;i<n;i+=32) {
+    unsigned lanes=uint32_t(mask_to(std::min<unsigned>(n-i,32)));
+    auto values=_mm512_maskz_loadu_epi16(lanes,cuts+i);
+    unsigned got=_mm512_test_epi16_mask(values,_mm512_set1_epi16(2));
+    invalid|=(got^uint32_t(ordinal_newlines<7>[i%7]))&lanes;
+  }
+  return invalid;
+}
