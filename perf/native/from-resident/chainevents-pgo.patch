+#pragma once
+
+// Deduplication is complete before grouping begins. Each source pair now
+// belongs to one alias, then to exactly one connected component.
+template <class T, unsigned Block> struct AliasChain {
+  using Pair = std::pair<Key, T>;
+  struct Chunk {
+    Chunk *previous;
+    T values[Block ? Block : 1];
+  };
+  void *tail{};
+  size_t count{};
+
+  std::span<T> contiguous() const {
+    if constexpr (Block) {
+      if (count && count <= Block)
+        return {static_cast<Chunk *>(tail)->values, count};
+    } else if (count == 1) {
+      return {&static_cast<Pair *>(tail)->second, 1};
+    }
+    return {};
+  }
+  void copy_to(std::span<T> output) const {
+    size_t left = count;
+    if constexpr (Block) {
+      auto *node = static_cast<Chunk *>(tail);
+      while (left) {
+        size_t used = 1 + (left - 1) % Block;
+        left -= used;
+        std::copy_n(node->values, used, output.data() + left);
+        node = node->previous;
+      }
+    } else {
+      auto *node = static_cast<Pair *>(tail);
+      while (left) {
+        output[--left] = node->second;
+        uintptr_t link = node->first.bits;
+        node = link ? reinterpret_cast<Pair *>(link) : nullptr;
+      }
+    }
+  }
+  std::span<T> materialize(std::vector<T> &scratch) const {
+    auto span = contiguous();
+    if (span.size() == count) return span;
+    if (scratch.size() < count) scratch.resize(count);
+    auto result = std::span(scratch).first(count);
+    copy_to(result);
+    return result;
+  }
+};
+
+template <class T, unsigned Block> struct AliasChainWriter {
+  using Chain = AliasChain<T, Block>;
+  using Chunk = typename Chain::Chunk;
+  static constexpr size_t per_page = std::max<size_t>(16, 16384 / sizeof(Chunk));
+  std::vector<TimelineArray<Chunk>> pages;
+  size_t next = per_page;
+
+  void append(Chain &chain, typename Chain::Pair &record,
+              std::span<TimelineRegion> regions, unsigned owner) {
+    if constexpr (Block) {
+      size_t position = chain.count % Block;
+      auto *node = static_cast<Chunk *>(chain.tail);
+      if (position == 0) {
+        if (next == per_page) {
+          pages.emplace_back().prepare(per_page, regions, owner);
+          next = 0;
+        }
+        auto *fresh = &pages.back()[next++];
+        fresh->previous = node;
+        chain.tail = node = fresh;
+      }
+      node->values[position] = record.second;
+    } else {
+      record.first.bits = chain.tail ? reinterpret_cast<uintptr_t>(chain.tail) : 0;
+      chain.tail = &record;
+    }
+    ++chain.count;
+  }
+};
