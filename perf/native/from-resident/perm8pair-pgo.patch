+#pragma once
+
+// A tile already contains the field ends of eight consecutive rows. Read all
+// 56 distinct boundaries with two overlapping loads, then place four columns
+// in each register. The final boundary is unnecessary for the common path.
+template<unsigned First>
+alignas(64) inline constexpr auto event_boundary_order = [] {
+  std::array<uint16_t, 32> order{};
+  for (unsigned column = 0; column < 4; ++column) {
+    for (unsigned row = 0; row < 8; ++row) {
+      const unsigned source = 7 * row + std::min(6u, First + column);
+      // Register two starts 24 words after register one. The index of a word
+      // from that register is therefore its source index plus eight.
+      order[8 * column + row] = uint16_t(source < 32 ? source : source + 8);
+    }
+  }
+  return order;
+}();
+
+template<bool GatherKind, class F>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw")))
+inline void emit_permuted_events(const char *base, const uint16_t *cuts, F &fn) {
+  const uint16_t *start = cuts - 1;
+  auto low = _mm512_loadu_si512(start);
+  auto high = _mm512_loadu_si512(start + 24);
+  auto left = _mm512_permutex2var_epi16(low, _mm512_load_si512(event_boundary_order<0>.data()), high);
+  auto right = _mm512_permutex2var_epi16(low, _mm512_load_si512(event_boundary_order<4>.data()), high);
+  auto left_ends = _mm512_alignr_epi32(right, left, 4);
+  auto right_ends = _mm512_alignr_epi32(right, right, 4);
+  const auto one = _mm512_set1_epi16(1);
+  auto left_trim = _mm512_and_si512(left_ends, one);
+  auto right_trim = _mm512_and_si512(right_ends, one);
+  auto left_start = _mm512_add_epi16(_mm512_srli_epi16(left, 1), left_trim);
+  auto right_start = _mm512_add_epi16(_mm512_srli_epi16(right, 1), right_trim);
+  auto left_width = _mm512_sub_epi16(_mm512_sub_epi16(_mm512_srli_epi16(left_ends, 1), left_start), _mm512_add_epi16(left_trim, one));
+  auto right_width = _mm512_sub_epi16(_mm512_sub_epi16(_mm512_srli_epi16(right_ends, 1), right_start), _mm512_add_epi16(right_trim, one));
+
+  auto short_ids = unsigned(_mm512_cmple_epu16_mask(_mm512_sub_epi16(left_width, _mm512_set1_epi16(2)), _mm512_set1_epi16(7)));
+  unsigned mask = short_ids & (short_ids >> 8);
+  mask &= unsigned(_mm512_cmpeq_epi16_mask(left_width, _mm512_set1_epi16(20))) >> 24;
+  mask &= unsigned(_mm512_cmpeq_epi16_mask(right_width, _mm512_set1_epi16(4)));
+  mask &= unsigned(_mm512_cmpneq_epi16_mask(right_width, _mm512_setzero_si512())) >> 8;
+  alignas(64) uint16_t begins[32], widths[32];
+  alignas(16) uint16_t kind[8];
+  _mm512_store_si512(begins, left_start);
+  _mm512_store_si512(widths, left_width);
+  auto kind_begins = _mm512_castsi512_si128(right_start);
+  if constexpr (GatherKind) {
+    auto lane = _mm256_cvtepu16_epi32(kind_begins);
+    auto lanes = _mm512_castsi512_si256(_mm512_maskz_set1_epi32(__mmask16(mask & 255), -1));
+    auto words = _mm256_mask_i32gather_epi32(_mm256_setzero_si256(), reinterpret_cast<const int *>(base), lane, lanes, 1);
+    auto view = _mm256_cmpeq_epi32(words, _mm256_set1_epi32(0x77656976));
+    auto cart = _mm256_cmpeq_epi32(words, _mm256_set1_epi32(0x74726163));
+    mask = unsigned(_mm256_movemask_ps(_mm256_castsi256_ps(_mm256_or_si256(view,cart))));
+  } else {
+    _mm_store_si128(reinterpret_cast<__m128i *>(kind), kind_begins);
+  }
+  for (unsigned i = 0; i < 8; ++i) {
+    if (mask & (1u << i)) {
+      bool common = true;
+      if constexpr (!GatherKind) {
+        uint32_t type;
+        std::memcpy(&type, base + kind[i], 4);
+        common = type == 0x77656976 || type == 0x74726163;
+      }
+      if (common && fn.common(base + begins[i], widths[i], base + begins[8+i], widths[8+i],
+                              Str(base + begins[16+i], widths[16+i]), Str(base + begins[24+i], 20)))
+        continue;
+    }
+    emit_marked_event(MarkedEventFields{base, cuts + 7*i}, fn);
+  }
+}
