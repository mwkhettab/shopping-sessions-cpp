+#pragma once
+
+// Keep a row inside each 128-bit lane. The checked offsets for the uncommon
+// path are already available when a pair fails the short view/cart predicate.
+template<bool Reuse, class F>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"))) inline void
+emit_paired_events(const char *base, const uint16_t *cuts, F &fn) {
+  const auto one = _mm256_set1_epi16(1);
+  const auto min = _mm256_broadcastsi128_si256(_mm_setr_epi16(2,2,INT16_MIN,20,4,1,INT16_MIN,INT16_MIN));
+  const auto max = _mm256_broadcastsi128_si256(_mm_setr_epi16(9,9,INT16_MAX,20,4,INT16_MAX,INT16_MAX,INT16_MAX));
+  for (unsigned pair = 0; pair < 4; ++pair, cuts += 14) {
+    auto a = _mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts-1));
+    auto b = _mm_loadu_si128(reinterpret_cast<const __m128i *>(cuts+6));
+    auto markers = _mm256_inserti128_si256(_mm256_castsi128_si256(a), b, 1);
+    auto end = _mm256_srli_si256(markers, 2);
+    auto trim = _mm256_and_si256(end, one);
+    auto start = _mm256_add_epi16(_mm256_srli_epi16(markers,1),trim);
+    auto width = _mm256_sub_epi16(_mm256_sub_epi16(_mm256_srli_epi16(end,1),start),_mm256_add_epi16(one,trim));
+    unsigned invalid = unsigned(_mm256_movemask_epi8(_mm256_or_si256(_mm256_cmpgt_epi16(min,width),_mm256_cmpgt_epi16(width,max))));
+    alignas(32) uint16_t begins[16], lengths[16];
+    _mm256_store_si256(reinterpret_cast<__m256i *>(begins),start);
+    _mm256_store_si256(reinterpret_cast<__m256i *>(lengths),width);
+    for (unsigned lane = 0; lane < 2; ++lane) {
+      auto p = begins + 8*lane;
+      auto n = lengths + 8*lane;
+      if (!(invalid & (0xffffu << (16*lane)))) {
+        uint32_t type;
+        std::memcpy(&type,base+p[4],4);
+        if ((type == 0x77656976 || type == 0x74726163) &&
+            fn.common(base+p[0],n[0],base+p[1],n[1],Str(base+p[2],n[2]),Str(base+p[3],20)))
+          continue;
+      }
+      if constexpr (Reuse) {
+        MarkedEventFields row{base,p,n};
+        emit_marked_event(row,fn);
+      } else {
+        emit_marked_event(MarkedEventFields{base,cuts+7*lane},fn);
+      }
+    }
+  }
+}
