+#pragma once
+#include "k_free_tables.hpp"
+#include <limits>
+
+namespace pipeline::k_free::detail {
+#if defined(__ELF__) && defined(__x86_64__)
+#define EVENT_TABLE(name) __asm__(name) __attribute__((used,visibility("hidden")))
+#else
