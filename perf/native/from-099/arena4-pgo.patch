+#pragma once
+template<class T> class TimelineArena {
+  static_assert(std::is_trivially_copyable_v<T> && std::is_trivially_destructible_v<T>);
+  struct Block {T *data;size_t size;};
+  std::allocator<T> allocator;
+  std::vector<Block> blocks;
+  T *remaining_data{};
+  size_t remaining{};
+  T *block(size_t n) {
+    auto *p=allocator.allocate(n);
+    try {blocks.push_back({p,n});} catch(...) {allocator.deallocate(p,n);throw;}
+    return p;
+  }
+public:
+  TimelineArena()=default;
+  TimelineArena(const TimelineArena&)=delete;
+  ~TimelineArena(){for(auto b:blocks)allocator.deallocate(b.data,b.size);}
+  T *allocate(size_t n) {
+    constexpr size_t chunk=32768/sizeof(T);
+    if(n>chunk/2)return block(n);
+    if(n>remaining){remaining_data=block(chunk);remaining=chunk;}
+    auto *out=remaining_data;remaining_data+=n;remaining-=n;return out;
+  }
+};
+template<class T,size_t Initial> struct GrowingTimeline {
+  T *data{};
+  size_t count{};
+  void append(const T &value,TimelineArena<T> &arena) {
+    if(count==0)data=arena.allocate(Initial);
+    else if(count>=Initial && std::has_single_bit(count)) {
+      if(count>SIZE_MAX/2/sizeof(T))throw std::length_error("timeline too large");
+      T *next=arena.allocate(2*count);
+      std::memcpy(next,data,count*sizeof(T));
+      data=next;
+    }
+    std::construct_at(data+count,value);++count;
+  }
+  std::span<T> view() const{return {data,count};}
+};
