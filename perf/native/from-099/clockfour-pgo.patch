+#pragma once
+struct ClockRow {
+  Key id,user;
+  const char *instant,*arrival;
+  int32_t price,category;
+};
+#ifdef SHOPPING_X86_CSV
+#define CLOCK_AVX __attribute__((target("avx2"),always_inline)) inline
+template<bool arrival>
+CLOCK_AVX __m256i four_load(const ClockRow *r,int off) {
+  auto load=[&](unsigned i){return std::bit_cast<int64_t>(little_word((arrival?r[i].arrival:r[i].instant)+off));};
+  return _mm256_set_epi64x(load(3),load(2),load(1),load(0));
+}
+CLOCK_AVX __m256i tenfold(__m256i x){return _mm256_add_epi64(_mm256_slli_epi64(x,3),_mm256_slli_epi64(x,1));}
+CLOCK_AVX __m256i clock_invalid_digits(__m256i x,uint64_t hi,uint64_t add,uint64_t limit){
+  return _mm256_or_si256(_mm256_and_si256(x,_mm256_set1_epi64x(hi)),
+      _mm256_and_si256(_mm256_add_epi64(x,_mm256_set1_epi64x(add)),_mm256_set1_epi64x(limit)));
+}
+template<bool arrival>
+CLOCK_AVX __m256i four_seconds(const ClockRow *r) {
+  auto d=_mm256_xor_si256(four_load<arrival>(r,11),_mm256_set1_epi64x(0x30303a30303a3030ULL));
+  auto pairs=_mm256_add_epi64(tenfold(d),_mm256_srli_epi64(d,8)),mask=_mm256_set1_epi64x(255);
+  auto h=_mm256_and_si256(pairs,mask);
+  auto m=_mm256_and_si256(_mm256_srli_epi64(pairs,24),mask);
+  auto s=_mm256_and_si256(_mm256_srli_epi64(pairs,48),mask);
+  auto result=_mm256_add_epi64(s,_mm256_add_epi64(_mm256_mul_epu32(h,_mm256_set1_epi64x(3600)),
+                                                 _mm256_mul_epu32(m,_mm256_set1_epi64x(60))));
+  if constexpr(!arrival){
+    auto bad=clock_invalid_digits(d,0xf0f0fff0f0fff0f0ULL,0x0606000606000606ULL,0x1010001010001010ULL);
+    auto invalid=_mm256_or_si256(_mm256_cmpgt_epi64(h,_mm256_set1_epi64x(23)),_mm256_cmpgt_epi64(m,_mm256_set1_epi64x(59)));
+    invalid=_mm256_or_si256(invalid,_mm256_cmpgt_epi64(s,_mm256_set1_epi64x(59)));
+    auto okay=_mm256_cmpeq_epi64(_mm256_or_si256(bad,invalid),_mm256_setzero_si256());
+    result=_mm256_blendv_epi8(_mm256_set1_epi64x(-1),result,okay);
+  }
+  return result;
+}
+CLOCK_AVX __m256i four_decimal(__m256i x){
+  auto d=_mm256_and_si256(x,_mm256_set1_epi64x(0x0f0f0f0f0f0f0f0fULL));
+  auto pairs=_mm256_and_si256(_mm256_add_epi64(tenfold(d),_mm256_srli_epi64(d,8)),_mm256_set1_epi64x(0x00ff00ff00ff00ffULL));
+  auto hundreds=_mm256_add_epi64(_mm256_slli_epi64(pairs,6),_mm256_add_epi64(_mm256_slli_epi64(pairs,5),_mm256_slli_epi64(pairs,2)));
+  auto quads=_mm256_and_si256(_mm256_add_epi64(hundreds,_mm256_srli_epi64(pairs,16)),_mm256_set1_epi64x(0x0000ffff0000ffffULL));
+  return _mm256_add_epi64(_mm256_mul_epu32(quads,_mm256_set1_epi64x(10000)),_mm256_srli_epi64(quads,32));
+}
+CLOCK_AVX __m256i four_epoch(const ClockRow *r) {
+  auto first=four_load<false>(r,0),last=four_load<false>(r,5),zero=_mm256_set1_epi64x(0x3030303030303030ULL);
+  auto bad0=clock_invalid_digits(_mm256_xor_si256(first,zero),0xf0f0f0f0f0f0f0f0ULL,0x0606060606060606ULL,0x1010101010101010ULL);
+  auto bad1=clock_invalid_digits(_mm256_xor_si256(last,zero),0xf0f0f0f0f0f0f0f0ULL,0x0606060606060606ULL,0x1010101010101010ULL);
+  auto left=_mm256_mul_epu32(four_decimal(first),_mm256_set1_epi64x(100000));
+  auto right=four_decimal(_mm256_and_si256(last,_mm256_set1_epi64x(~0xffffffULL)));
+  auto okay=_mm256_cmpeq_epi64(_mm256_or_si256(bad0,bad1),_mm256_setzero_si256());
+  return _mm256_blendv_epi8(_mm256_set1_epi64x(bad),_mm256_add_epi64(left,right),okay);
+}
+template<int form>
+__attribute__((target("avx2"))) void clock_block(const ClockRow *r,Time *event,Time *ingested) {
+  alignas(32) int64_t arrival_s[4],event_s[4];
+  _mm256_store_si256(reinterpret_cast<__m256i*>(arrival_s),four_seconds<true>(r));
+  if constexpr(form==13)_mm256_storeu_si256(reinterpret_cast<__m256i*>(event),four_epoch(r));
+  else _mm256_store_si256(reinterpret_cast<__m256i*>(event_s),four_seconds<false>(r));
+  for(unsigned i=0;i<4;++i){
+    Time ad=midnight(r[i].arrival);ingested[i]=ad==bad?bad:ad+arrival_s[i]*1000;
+    if constexpr(form!=13){
+      auto p=r[i].instant;
+      bool valid=p[10]=='T' && event_s[i]>=0;
+      int offset=0;
+      if constexpr(form==25){
+        int h=pair_digits(p+20),m=pair_digits(p+23);
+        valid=valid && (p[19]=='+' || p[19]=='-') && p[22]==':' && unsigned(h)<24 && unsigned(m)<60;
+        if(valid)offset=(h*3600+m*60)*(p[19]=='+'?1:-1);
+      }else valid=valid && p[19]=='Z';
+      Time ed=valid?midnight(p):bad;
+      event[i]=ed==bad?bad:ed+(event_s[i]-offset)*1000;
+    }
+  }
+}
+#undef CLOCK_AVX
+#endif
+template<int width,unsigned Batch,class F> struct ClockBatch {
+  std::array<ClockRow,Batch> rows;
+  unsigned count=0;
+  F &emit;
+  explicit ClockBatch(F &f):emit(f){}
+  void flush() {
+    unsigned i=0;
+#if defined(SHOPPING_X86_CSV) && !defined(SHOPPING_SCALAR_CLOCK_BATCH)
+    if(__builtin_cpu_supports("avx2")){
+      for(;i+4<=count;i+=4){
+        Time event[4],ingest[4];clock_block<width>(rows.data()+i,event,ingest);
+        for(unsigned k=0;k<4;++k)emit(rows[i+k],event[k],ingest[k]);
+      }
+    }
+#endif
+    for(;i<count;++i)emit(rows[i],timestamp(Str(rows[i].instant,width)),ingest_time(Str(rows[i].arrival,20)));
+    count=0;
+  }
+  void add(ClockRow r){rows[count++]=r;if(count==Batch)flush();}
+};
