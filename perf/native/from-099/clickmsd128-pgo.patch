+#pragma once
+// Order only the click timestamps. The precise byte tie-break is deferred to
+// the latest eligible timestamp actually used by a session.
+inline std::span<WordLayout::C> radix_click_times(std::span<WordLayout::C> clicks,
+    std::vector<WordLayout::C> &scratch) {
+  using C=WordLayout::C;
+  scratch.resize(clicks.size());
+#ifdef SHOPPING_CLICK_HIGH_DIGIT
+  uint32_t minimum=UINT32_MAX,maximum=0;
+  for(const auto &c:clicks){minimum=std::min(minimum,c.ts);maximum=std::max(maximum,c.ts);}
+  if(maximum==minimum)return clicks;
+  unsigned width=std::bit_width(maximum-minimum);
+  unsigned shift=width>8?width-8:0;
+  auto digit=[&](const C &c){return (c.ts-minimum)>>shift;};
+  std::array<size_t,256> pos{};
+  for(const auto &c:clicks)++pos[digit(c)];
+  size_t n=0;for(auto &p:pos){auto c=p;p=n;n+=c;}
+  for(const auto &c:clicks)scratch[pos[digit(c)]++]=c;
+  n=0;
+  if(shift)for(auto end:pos){
+    if(end>n+1)std::sort(scratch.begin()+n,scratch.begin()+end,[](auto &a,auto &b){return a.ts<b.ts;});
+    n=end;
+  }
+  return std::span(scratch).first(clicks.size());
+#else
+  std::array<std::array<size_t,256>,4> hist{};
+  for(auto &c:clicks){
+    ++hist[0][c.ts&255];++hist[1][(c.ts>>8)&255];
+    ++hist[2][(c.ts>>16)&255];++hist[3][c.ts>>24];
+  }
+  auto input=clicks,output=std::span(scratch).first(clicks.size());
+  for(unsigned d=0;d<4;++d){
+    auto &pos=hist[d];
+    if(pos[(input[0].ts>>(8*d))&255]==clicks.size())continue;
+    size_t n=0;for(auto &p:pos){auto c=p;p=n;n+=c;}
+    for(auto &c:input)output[pos[(c.ts>>(8*d))&255]++]=c;
+    std::swap(input,output);
+  }
+  return input;
+#endif
+}
