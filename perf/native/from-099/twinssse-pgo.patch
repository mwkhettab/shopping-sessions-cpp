+#pragma once
+struct EventClocks {Time event,ingest,seconds;};
+#ifdef SHOPPING_TWIN_SIMD
+#ifdef SHOPPING_X86_CSV
+__attribute__((target("ssse3"))) inline uint64_t clock_pair(const char *event,const char *arrival) {
+  auto raw=_mm_set_epi64x(std::bit_cast<int64_t>(little_word(arrival)),std::bit_cast<int64_t>(little_word(event)));
+  auto digits=_mm_shuffle_epi8(_mm_sub_epi8(raw,_mm_set1_epi8('0')),
+                 _mm_setr_epi8(0,1,3,4,6,7,-1,-1,8,9,11,12,14,15,-1,-1));
+  auto values=_mm_maddubs_epi16(digits,_mm_set1_epi16(0x010a));
+  auto partial=_mm_madd_epi16(values,_mm_setr_epi16(3600,60,1,0,3600,60,1,0));
+  auto total=_mm_hadd_epi32(partial,partial);
+  uint64_t result=uint64_t(_mm_cvtsi128_si64(total));
+  auto valid_digits=_mm_cmpeq_epi8(digits,_mm_min_epu8(digits,_mm_set1_epi8(9)));
+  auto high=_mm_cmpgt_epi16(values,_mm_setr_epi16(23,59,59,100,23,59,59,100));
+  if((_mm_movemask_epi8(valid_digits)&63)!=63||(_mm_movemask_epi8(high)&63)||event[2]!=':'||event[5]!=':')
+    result|=UINT32_MAX;
+  return result;
+}
+#endif
+#endif
+inline EventClocks event_clocks(Str instant,Str arrival) {
+  if(arrival.size()!=20) {
+    Time ingest=ingest_time(arrival);
+    return {timestamp(instant),ingest,ingest/1000};
+  }
+  const char *a=arrival.data();
+  Time ad=civil_day(a);
+  if(ad==bad)return {timestamp(instant),bad,bad/1000};
+  int arrival_sec,event_sec=0;
+  bool iso=(instant.size()==20||instant.size()==25)&&instant[4]=='-';
+  const char *e=instant.data();
+#ifdef SHOPPING_TWIN_SIMD
+#ifdef SHOPPING_X86_CSV
+  if(iso&&__builtin_cpu_supports("ssse3")) {
+    uint64_t clocks=clock_pair(e+11,a+11);
+    event_sec=std::bit_cast<int32_t>(uint32_t(clocks));
+    arrival_sec=int(clocks>>32);
+  } else
+#endif
+#endif
+  {
+    arrival_sec=clock_seconds<false>(a+11);
+    if(iso)event_sec=clock_seconds<true>(e+11);
+  }
+  Time seconds=ad*86400+arrival_sec;
+  Time time=bad;
+  if(!iso)time=timestamp(instant);
+  else if(event_sec>=0 && e[10]=='T') {
+    bool valid=true;
+    if(instant.size()==25){
+      int h=pair_digits(e+20),m=pair_digits(e+23);
+      valid=(e[19]=='+'||e[19]=='-')&&e[22]==':'&&unsigned(h)<=23&&unsigned(m)<=59;
+      if(valid)event_sec-=(h*3600+m*60)*(e[19]=='+'?1:-1);
+    } else valid=e[19]=='Z';
+    if(valid) {
+#ifdef SHOPPING_SHARED_DATE
+      Time ed=(little_word(e)==little_word(a)&&e[8]==a[8]&&e[9]==a[9])?ad:civil_day(e);
+#else
+      Time ed=civil_day(e);
+#endif
+      if(ed!=bad)time=(ed*86400+event_sec)*1000;
+    }
+  }
+  return {time,seconds*1000,seconds};
+}
