+#pragma once
+#ifdef SHOPPING_X86_CSV
+struct IndexedLine { uint16_t after, quotes; };
+struct CsvBlockIndex {
+  static constexpr size_t extent=4096;
+  // Vector stores may extend 32 elements past the last active position.
+  std::array<uint16_t,extent+32> cuts;
+  std::array<IndexedLine,extent> lines;
+  unsigned nc=0,nl=0,nq=0;
+  void lines_in(uint64_t marks,uint64_t lfs,uint64_t quotes) {
+    auto end=lfs;
+    while(end) {
+      auto first=end & (0-end);
+      auto before=first-1;
+      lines[nl++]={uint16_t(nc+std::popcount(marks&before)+1),
+                   uint16_t(nq+std::popcount(quotes&before))};
+      end&=end-1;
+    }
+    nq+=std::popcount(quotes);
+  }
+};
+__attribute__((target("avx2,bmi,popcnt")))
+inline void index_avx2(Str data,CsvBlockIndex &out) {
+  for(size_t i=0;i<data.size();i+=32) {
+    alignas(32) char tail[32]{};
+    auto p=data.data()+i;
+    if(data.size()-i<32){std::memcpy(tail,p,data.size()-i);p=tail;}
+    auto m=row_mask32(p);unsigned marks=m.comma|m.lf;
+    out.lines_in(marks,m.lf,m.quotes);
+    while(marks){out.cuts[out.nc++]=uint16_t(i+std::countr_zero(marks));marks&=marks-1;}
+  }
+}
+__attribute__((target("avx512f,avx512bw,avx512vbmi2,popcnt,bmi")))
+inline void index_vbmi(Str data,CsvBlockIndex &out) {
+  alignas(64) static constexpr auto seq=[]{
+    std::array<int16_t,32> s{};for(unsigned i=0;i<32;++i)s[i]=int16_t(i);return s;
+  }();
+  auto pos=_mm512_load_si512(seq.data());
+  for(size_t i=0;i<data.size();i+=64) {
+    auto p=data.data()+i;
+    auto v=data.size()-i>=64?_mm512_loadu_si512(p):
+        _mm512_maskz_loadu_epi8((uint64_t{1}<<(data.size()-i))-1,p);
+    auto lf=_mm512_cmpeq_epi8_mask(v,_mm512_set1_epi8('\n'));
+    auto q=_mm512_cmpeq_epi8_mask(v,_mm512_set1_epi8('"'));
+    uint64_t marks=lf|_mm512_cmpeq_epi8_mask(v,_mm512_set1_epi8(','));
+    out.lines_in(marks,lf,q);
+    unsigned lo=uint32_t(marks),hi=uint32_t(marks>>32);
+    auto p1=_mm512_add_epi16(pos,_mm512_set1_epi16(32));
+#ifdef SHOPPING_OVERLAP_CUTS
+    _mm512_storeu_si512(out.cuts.data()+out.nc,_mm512_maskz_compress_epi16(lo,pos));
+    out.nc+=std::popcount(lo);
+    _mm512_storeu_si512(out.cuts.data()+out.nc,_mm512_maskz_compress_epi16(hi,p1));
+#else
+    _mm512_mask_compressstoreu_epi16(out.cuts.data()+out.nc,lo,pos);
+    out.nc+=std::popcount(lo);
+    _mm512_mask_compressstoreu_epi16(out.cuts.data()+out.nc,hi,p1);
+#endif
+    out.nc+=std::popcount(hi);
+    pos=_mm512_add_epi16(pos,_mm512_set1_epi16(64));
+  }
+}
+template<size_t N,bool wide,class F>
+__attribute__((target("avx2,bmi,popcnt"))) void indexed_lines(Str data,F &fn) {
+  CsvBlockIndex index;
+  while(data.size()>=128) {
+    auto n=std::min(data.size(),index.extent);
+    auto end=data.substr(0,n).rfind('\n');
+    if(end==Str::npos) {
