+// Each output position is constructed once by its owning shard.
+template<class T> class ScatterStorage {
+  static_assert(std::is_trivially_destructible_v<T> && std::is_nothrow_copy_constructible_v<T>);
+  std::allocator<T> allocator;
+  T *data{};
+  size_t count{};
+public:
+  ScatterStorage()=default;
+  ScatterStorage(const ScatterStorage&)=delete;
+  ~ScatterStorage(){if(data)allocator.deallocate(data,count);}
+  void resize(size_t n){if(n)data=allocator.allocate(n);count=n;}
+  void put(size_t i,const T &v){std::construct_at(data+i,v);}
+  std::span<T> view(){return {data,count};}
+};
