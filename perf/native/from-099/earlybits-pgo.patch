+#pragma once
+struct RevisionExclusions {
+  std::vector<uint32_t> offsets;
+#ifdef SHOPPING_LOSER_BITS
+  std::vector<uint64_t> words;
+#endif
+  void finish() {
+#ifdef SHOPPING_LOSER_BITS
+    if(offsets.empty())return;
+    words.resize(*std::max_element(offsets.begin(),offsets.end())/64+1);
+    for(auto offset:offsets)words[offset/64]|=uint64_t{1}<<(offset%64);
+    std::vector<uint32_t>().swap(offsets);
+#else
+    std::sort(offsets.begin(),offsets.end());
+#endif
+  }
+  bool contains(size_t offset,size_t &cursor) const {
+#ifdef SHOPPING_LOSER_BITS
+    (void)cursor;
+    return offset/64<words.size() && ((words[offset/64]>>(offset%64))&1);
+#else
+    while(cursor<offsets.size() && offsets[cursor]<offset)++cursor;
+    return cursor<offsets.size() && offsets[cursor]==offset;
+#endif
+  }
+};
+struct SourceRevision {Key id;uint32_t chunk,offset;};
+inline std::vector<RevisionExclusions> find_exclusions(const std::vector<InputChunk> &chunks,size_t expected,unsigned threads) {
+  if(chunks.size()>UINT32_MAX)throw std::length_error("input chunk count exceeds compact locator");
+  struct Reader {KeyPool keys;PartitionSlab<SourceRevision> by_id;std::vector<uint64_t> losers;};
+  std::vector<Reader> readers(threads);
+  std::vector<Str> bodies(chunks.size());
+  for(auto &r:readers)r.by_id.reserve(std::min<size_t>(expected+expected/8,(size_t(1536)<<20)/sizeof(SourceRevision))/threads/shards);
+  parallel(chunks.size(),threads,[&](size_t chunk,unsigned worker){
+    auto bytes=bodies[chunk]=chunks[chunk].body();
+    if(bytes.empty())return;
+    const char *base=bytes.data(),*p=base,*end=p+bytes.size();
+    auto &r=readers[worker];
+    auto record=[&](const char *line,const char *last) {
+      const char *comma=nullptr;
+#if defined(__SSE2__)
+      if(end-line>=16) {
+        auto chars=_mm_loadu_si128(reinterpret_cast<const __m128i*>(line));
+        unsigned bits=unsigned(_mm_movemask_epi8(_mm_cmpeq_epi8(chars,_mm_set1_epi8(','))));
+        if(bits){auto pos=std::countr_zero(bits);if(last-line>pos)comma=line+pos;else return;}
+      }
+#endif
+      if(!comma)comma=static_cast<const char*>(std::memchr(line,',',size_t(last-line)));
+      if(!comma)return;
+      Str id(line,comma-line);
+      if(id.size()>=2 && id.front()=='"' && id.back()=='"'){id.remove_prefix(1);id.remove_suffix(1);}
+      if(id.empty())return;
+      // The chunk owns only physical lines whose first byte is inside its nominal range.
+      // A final very long line can extend past that range without changing its start.
+      auto key=r.keys.encode(id,'e');
+      r.by_id[bucket(key)].push_back({key,uint32_t(chunk),uint32_t(line-base)});
+    };
+#if defined(__SSE2__)
+    for(auto *q=p;end-q>=16;q+=16){
+      auto chars=_mm_loadu_si128(reinterpret_cast<const __m128i*>(q));
+      unsigned lf=unsigned(_mm_movemask_epi8(_mm_cmpeq_epi8(chars,_mm_set1_epi8('\n'))));
+      while(lf){auto *stop=q+std::countr_zero(lf);record(p,stop);p=stop+1;lf&=lf-1;}
+    }
+#endif
+    while(p<end){auto lf=static_cast<const char*>(std::memchr(p,'\n',end-p));if(!lf){record(p,end);break;}record(p,lf);p=lf+1;}
+  });
+  auto valid_ingest=[&](const SourceRevision &row) -> std::optional<Time> {
+    Str rest=bodies[row.chunk].substr(row.offset);
+    auto lf=rest.find('\n');
+    std::optional<Time> result;
+    scalar_rows<7>(rest.substr(0,lf),[&](const auto &fields){if(!fields[0].empty())result=ingest_time(fields[3]);});
+    return result;
+  };
+  parallel(shards,threads,[&](size_t shard,unsigned worker){
+    size_t count=0;
+    for(auto &r:readers)count+=r.by_id[shard].size();
+    size_t size=std::bit_ceil(std::max<size_t>(2,count+count/2));
+    std::vector<const SourceRevision*> table(size);
+    auto &losers=readers[worker].losers;
+    for(auto &r:readers){
+      for(auto span:r.by_id[shard].spans())for(auto &entry:span){
+        size_t i=(entry.id.hash()/shards)&(size-1);
+        while(table[i] && !(table[i]->id==entry.id))i=(i+1)&(size-1);
+        if(!table[i]){table[i]=&entry;continue;}
+        auto later=valid_ingest(entry);if(!later)continue;
+        auto earlier=valid_ingest(*table[i]);if(!earlier){table[i]=&entry;continue;}
+        const auto *drop=&entry;
+        if(*later<*earlier){drop=table[i];table[i]=&entry;}
+        losers.push_back((uint64_t(drop->chunk)<<32)|drop->offset);
+      }
+    }
+    for(auto &r:readers)r.by_id[shard].release();
+  });
+  std::vector<RevisionExclusions> excluded(chunks.size());
+  for(auto &reader:readers){
+    reader.by_id.release();
+    for(auto code:reader.losers)excluded[code>>32].offsets.push_back(uint32_t(code));
+  }
+  parallel(excluded.size(),threads,[&](size_t i,unsigned){excluded[i].finish();});
+  return excluded;
+}
