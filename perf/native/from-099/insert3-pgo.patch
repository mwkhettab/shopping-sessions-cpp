+#pragma once
+struct AliasAccumulator {
+  size_t head{}, spilled{};
+  unsigned size{};
+};
+
+template <class Layout, unsigned Limit> struct AliasIntervals {
+  using E = typename Layout::E;
+  struct Piece {
+    Time first,last;
+    int64_t count,revenue;
+    size_t first_buy,last_buy,next;
+  };
+  struct Buy {int category,price;size_t next;};
+  std::vector<Piece> pieces{{}};
+  std::vector<Buy> buys{{}};
+  std::vector<std::vector<E>> tails;
+  Layout layout;
+
+  explicit AliasIntervals(Layout l) : layout(l) {}
+  void insert(AliasAccumulator &alias,E word) {
+    if(alias.spilled) {
+      tails[alias.spilled-1].push_back(word);
+      return;
+    }
+    Event e=layout.unpack(word);
+    size_t before=0,at=alias.head;
+    while(at && e.ts-pieces[at].last>session_gap){before=at;at=pieces[at].next;}
+    if(!at || pieces[at].first-e.ts>session_gap) {
+      if(alias.size==Limit) {
+        tails.emplace_back().push_back(word);
+        alias.spilled=tails.size();
+        return;
+      }
+      size_t added=pieces.size();
+      pieces.push_back({e.ts,e.ts,0,0,0,0,at});
+      if(before)pieces[before].next=added;else alias.head=added;
+      at=added;++alias.size;
+    }
+    auto &p=pieces[at];
+    p.first=std::min(p.first,e.ts);p.last=std::max(p.last,e.ts);++p.count;
+    if(e.price) {
+      size_t id=buys.size();buys.push_back({e.category,e.price,p.first_buy});
+      if(!p.last_buy)p.last_buy=id;
+      p.first_buy=id;p.revenue+=e.price;
+    }
+    if(p.next && pieces[p.next].first-p.last<=session_gap) {
+      auto &q=pieces[p.next];
+      if(q.first_buy) {
+        if(p.last_buy)buys[p.last_buy].next=q.first_buy;else p.first_buy=q.first_buy;
+        p.last_buy=q.last_buy;
+      }
+      p.count+=q.count;p.revenue+=q.revenue;p.last=std::max(p.last,q.last);
+      p.next=q.next;--alias.size;
+    }
+  }
+
+  void finish(const AliasAccumulator &alias,Result &scratch,PartialStore &out) {
+    auto first=out.segments.size();
+    for(size_t at=alias.head;at;at=pieces[at].next) {
+      const auto &p=pieces[at];
+      auto j=out.purchases.size();
+      for(size_t i=p.first_buy;i;i=buys[i].next)
+        out.purchases.push_back({buys[i].category,buys[i].price});
+      out.segments.push_back({p.first,p.last,p.count,p.revenue,j,out.purchases.size()});
+    }
+    if(alias.spilled) {
+      auto &tail=tails[alias.spilled-1];
+      collapse_alias(std::span<E>(tail),layout,scratch,out);
+      std::sort(out.segments.begin()+first,out.segments.end(),
+                [](const auto &a,const auto &b){return a.first<b.first;});
+    }
+  }
+};
