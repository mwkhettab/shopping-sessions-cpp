+struct CsvPrefix {
+  uint64_t commas{}, quotes{}, range{};
+  uint8_t start_user{}, start_time{}, time_width{}, count{};
+};
+constexpr auto csv_prefixes() {
+  std::array<std::array<std::array<CsvPrefix,19>,3>,2> table{};
+  for(unsigned q0=0;q0<2;++q0) for(unsigned q1=0;q1<2;++q1)
+    for(unsigned q2=0;q2<2;++q2) for(unsigned w:{13u,20u,25u}){
+      const unsigned c0=9+2*q0,c1=c0+10+2*q1,c2=c1+1+w+2*q2;
+      auto bit=[](unsigned i){return uint64_t{1}<<i;};
+      uint64_t quotes=(q0?(bit(0)|bit(c0-1)):0) |
+                       (q1?(bit(c0+1)|bit(c1-1)):0) |
+                       (q2?(bit(c1+1)|bit(c2-1)):0);
+      table[q0][(c1-19)/2][c2-33]={bit(c0)|bit(c1)|bit(c2),quotes,bit(c2+1)-1,
+        uint8_t(c0+1+q1),uint8_t(c1+1+q2),uint8_t(w),uint8_t(2*(q0+q1+q2))};
+    }
+  return table;
+}
+inline constexpr auto csv_prefix_table=csv_prefixes();
+template<class F>
+__attribute__((target("avx2,bmi,popcnt,pclmul"),always_inline)) inline bool
+prefix_certified_event(const char *p,unsigned len,uint64_t lo,uint64_t hi,uint64_t ql,F &fn) {
+  constexpr uint64_t third=[]{
+    uint64_t m=0;for(unsigned i:{33u,35u,37u,39u,40u,42u,44u,46u,45u,47u,49u,51u})m|=uint64_t{1}<<i;return m;
+  }();
+  auto a=lo&((1ull<<9)|(1ull<<11));
+  auto b=lo&((1ull<<19)|(1ull<<21)|(1ull<<23));
+  auto c=lo&third;
+  if(!a||!b||!c)return false;
+  unsigned c0=std::countr_zero(a),c1=std::countr_zero(b),c2=std::countr_zero(c);
+  const CsvPrefix &prefix=csv_prefix_table[(c0-9)/2][(c1-19)/2][c2-33];
+  if(!prefix.range || (lo&prefix.range)!=prefix.commas)return false;
+  unsigned id_start=(c0-9)/2;
+  if(unsigned(p[0]=='"')!=id_start || unsigned(p[c0+1]=='"')!=prefix.start_user-(c0+1) ||
+     unsigned(p[c1+1]=='"')!=prefix.start_time-(c1+1))return false;
