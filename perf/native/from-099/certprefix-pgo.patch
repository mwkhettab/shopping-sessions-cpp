+    }
+    commas[block]=commas[block+1]=0;
+    return !(invalid|inside);
+  }
+  uint64_t shifted(unsigned block,unsigned off)const{
+    return off?(commas[block]>>off)|(commas[block+1]<<(64-off)):commas[block];
+  }
+};
