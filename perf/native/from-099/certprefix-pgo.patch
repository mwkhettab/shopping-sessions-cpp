+  unsigned c5=hi?127u-std::countl_zero(hi):63u-std::countl_zero(lo);
+  if(c4>=c5 || p[c3]!=',' || p[c4]!=',')return false;
+  const char *kind=p+s4+q4;
+  if((std::memcmp(kind,"view",4)!=0 && std::memcmp(kind,"cart",4)!=0) ||
+     c5-(c4+1)<=2u*(p[c4+1]=='"'))return false;
+  const char *id=p+id_start,*user=p+prefix.start_user;
+  Str ts(p+prefix.start_time,prefix.time_width),ingest(p+s3+q3,20);
+  return fn.common(id,user,ts,ingest);
+}
