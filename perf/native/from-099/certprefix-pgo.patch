+inline bool csv_separator(char c){return c==',' || c=='\n';}
+__attribute__((target("avx2,pclmul"),always_inline)) inline bool
+certify_quotes(const char *start,size_t n){
+  uint64_t inside=0,previous=1,invalid=0;
+  for(size_t i=0;i<n;i+=64){
+    const char *p=start+i;unsigned used=unsigned(std::min<size_t>(64,n-i));
+    alignas(32) char tail[64]{};
+    if(used<64){std::memcpy(tail,p,used);p=tail;}
+    auto a=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p));
+    auto b=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p+32));
+    auto join=[](__m256i x,__m256i y) __attribute__((target("avx2"),always_inline)) {
+      return uint64_t(unsigned(_mm256_movemask_epi8(x)))|(uint64_t(unsigned(_mm256_movemask_epi8(y)))<<32);
+    };
+    auto quote=_mm256_set1_epi8('"'),comma=_mm256_set1_epi8(','),lf=_mm256_set1_epi8('\n');
+    uint64_t q=join(_mm256_cmpeq_epi8(a,quote),_mm256_cmpeq_epi8(b,quote));
+    uint64_t sep=join(_mm256_or_si256(_mm256_cmpeq_epi8(a,comma),_mm256_cmpeq_epi8(a,lf)),
+                      _mm256_or_si256(_mm256_cmpeq_epi8(b,comma),_mm256_cmpeq_epi8(b,lf)));
