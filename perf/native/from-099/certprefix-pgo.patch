+__attribute__((target("avx2,pclmul"),always_inline)) inline uint64_t quote_prefix(uint64_t q){
+  auto value=_mm_cvtsi64_si128(std::bit_cast<int64_t>(q));
+  return uint64_t(_mm_cvtsi128_si64(_mm_clmulepi64_si128(value,_mm_set1_epi64x(-1),0)));
