+#pragma once
+template<class T,size_t Banks,size_t Capacity> struct BankBuffer {
+  static_assert(std::has_single_bit(Banks) && shards%Banks==0);
+  struct Bank {
+    std::array<T,Capacity> records;
+    std::array<uint16_t,Capacity> shard;
+    size_t used{};
+  };
+  std::array<Bank,Banks> banks;
+  void flush(Bank &bank,PartitionSlab<T> &target) {
+    for(size_t i=0;i<bank.used;++i)
+      target[bank.shard[i]].push_back(bank.records[i]);
+    bank.used=0;
+  }
+  void append(size_t shard,T value,PartitionSlab<T> &target) {
+    auto &bank=banks[shard/(shards/Banks)];
+    size_t at=bank.used++;
+    bank.records[at]=value;
+    bank.shard[at]=uint16_t(shard);
+    if(bank.used==Capacity)flush(bank,target);
+  }
+  void finish(PartitionSlab<T> &target){for(auto &bank:banks)flush(bank,target);}
+};
