+#pragma once
+template<class T,size_t Page> class InputJournal {
+  static_assert(std::has_single_bit(Page) && std::is_trivially_destructible_v<T>);
+  std::vector<T*> pages;
+  std::allocator<T> allocator;
+  size_t count{};
+public:
+  InputJournal()=default;
+  InputJournal(const InputJournal&)=delete;
+  ~InputJournal(){for(auto *p:pages)if(p)allocator.deallocate(p,Page);}
+  template<class...A> size_t append(A&&...args){
+    size_t at=count%Page;
+    if(!at){
+      T *next=allocator.allocate(Page);
+      try{pages.push_back(next);}catch(...){allocator.deallocate(next,Page);throw;}
+    }
+    std::construct_at(pages.back()+at,std::forward<A>(args)...);return count++;
+  }
+  T &operator[](size_t i){return pages[i/Page][i%Page];}
+  template<class F> void consume(F emit){
+    size_t remaining=count;
+    for(auto &p:pages){
+      size_t n=std::min<size_t>(Page,remaining);emit(std::span<T>(p,n));remaining-=n;
+      allocator.deallocate(p,Page);p=nullptr;
+    }
+    count=0;pages.clear();
+  }
+};
+template<size_t Page,class T,class Shard>
+void partition_journal(InputJournal<T,Page> &input,PartitionSlab<T> &output,Shard get){
+#ifdef SHOPPING_SORT_JOURNAL
+  std::vector<T> ordered(Page);
+  std::vector<uint16_t> tag(Page);
+  input.consume([&](std::span<T> rows){
+    std::array<unsigned,shards> counts{},ends;
+    for(size_t i=0;i<rows.size();++i) {
+      unsigned b=get(rows[i]);tag[i]=uint16_t(b);if(b<shards)++counts[b];
+    }
+    unsigned offset=0;
+    for(size_t b=0;b<shards;++b){ends[b]=offset;offset+=counts[b];}
+    for(size_t i=0;i<rows.size();++i)if(tag[i]<shards)ordered[ends[tag[i]]++]=rows[i];
+    for(size_t b=0;b<shards;++b)if(counts[b])
+      output[b].append_many(std::span<const T>(ordered.data()+ends[b]-counts[b],counts[b]));
+  });
+#else
+  input.consume([&](std::span<T> rows){
+    for(auto &r:rows){unsigned b=get(r);if(b<shards)output[b].push_back(r);}
+  });
+#endif
+}
