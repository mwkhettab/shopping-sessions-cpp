+#pragma once
+template<class T,size_t Width> struct RawColumns {
+  static_assert(std::has_single_bit(Width));
+  struct Block {uintptr_t keys[Width];T values[Width];};
+  static_assert(std::is_trivially_destructible_v<Block>);
+  struct Bin {
+    Block *blocks{};
+    size_t used{},limit{};
+    std::vector<Block> overflow;
+    size_t size() const{return used;}
+    Block &block(size_t i){return i<limit?blocks[i/Width]:overflow[(i-limit)/Width];}
+    void emplace_back(Key k,T value) {
+      size_t slot=used%Width;
+      if(!slot){
+        if(used<limit)::new(static_cast<void*>(blocks+used/Width)) Block;
+        else overflow.emplace_back();
+      }
+      auto &b=block(used++);
+      b.keys[slot]=k.bits;
+      b.values[slot]=value;
+    }
+    void erase(size_t i){block(i).keys[i%Width]=0;}
+    template<class Fn> void each(Fn visit) {
+      for(size_t i=0;i<used;i+=Width){
+        auto &b=block(i);
+        auto n=std::min(Width,used-i);
+        visit(std::span<uintptr_t>{b.keys,n},std::span<T>{b.values,n});
+      }
+    }
+    void release(){std::vector<Block>().swap(overflow);}
+  };
+  PartitionSlab<Block> slab;
+  std::array<Bin,shards> bins;
+  void reserve(size_t count){
+    slab.reserve((count+Width-1)/Width);
+    for(size_t i=0;i<shards;++i){
+      bins[i].blocks=slab[i].data;
+      bins[i].limit=slab[i].limit*Width;
+    }
+  }
+  void release(){slab.release();}
+  Bin &operator[](size_t i){return bins[i];}
+};
