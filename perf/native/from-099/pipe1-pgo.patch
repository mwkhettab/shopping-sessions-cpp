+#pragma once
+#include <condition_variable>
+
+template<unsigned BatchSize> class PipelinedWinners {
+public:
+  struct Revision {Key id;Time ingest;Key *event;};
+private:
+  struct Batch {
+    unsigned bucket{};
+    std::vector<Revision> rows;
+    Batch(){rows.reserve(BatchSize);}
+  };
+  using Packet=std::unique_ptr<Batch>;
+  struct Table {
+    std::vector<Revision> slots;
+    size_t used{};
+    static size_t locate(const std::vector<Revision> &table,Key id){
+      size_t at=(id.hash()/shards)&(table.size()-1);
+      while(table[at].id.bits && !(table[at].id==id))at=(at+1)&(table.size()-1);
+      return at;
+    }
+    void accept(const Revision &r,size_t initial){
+      if(slots.empty())slots.resize(initial);
+      if(used*10>=slots.size()*7) {
+        std::vector<Revision> grown(slots.size()*2);
+        for(auto &v:slots)if(v.id.bits)grown[locate(grown,v.id)]=v;
+        slots.swap(grown);
+      }
+      auto &old=slots[locate(slots,r.id)];
+      if(!old.id.bits){old=r;++used;return;}
+      if(r.ingest<old.ingest){if(old.event)old.event->bits=0;old=r;}
+      else if(r.event)r.event->bits=0;
+    }
+  };
+  struct Lane {
+    std::mutex mutex;
+    std::condition_variable changed;
+    bool done{};
+    std::vector<Packet> queue,free;
+  };
+  std::array<Table,shards> tables;
+  std::vector<std::unique_ptr<Lane>> lanes;
+  std::vector<std::jthread> reducers;
+  size_t initial;
+  bool serial;
+  std::mutex errors;
+  std::exception_ptr failure;
+  void stop(){
+    for(auto &p:lanes){
+      {std::lock_guard lock(p->mutex);p->done=true;}
+      p->changed.notify_all();
+    }
+  }
+  void reduce(Lane &lane){
+    try {
+      std::vector<Packet> work;
+      for(;;){
+        {
+          std::unique_lock lock(lane.mutex);
+          lane.changed.wait(lock,[&]{return lane.done||!lane.queue.empty();});
+          if(lane.queue.empty())break;
+          work.swap(lane.queue);
+        }
+        lane.changed.notify_all();
+        for(auto &batch:work) {
+          auto &table=tables[batch->bucket];
+          for(auto &r:batch->rows)table.accept(r,initial);
+          batch->rows.clear();
+        }
+        {
+          std::lock_guard lock(lane.mutex);
+          for(auto &p:work)if(lane.free.size()<128)lane.free.push_back(std::move(p));
+        }
+        work.clear();
+      }
+    }catch(...) {
+      {std::lock_guard lock(errors);if(!failure)failure=std::current_exception();}
+      stop();
+    }
+  }
+  Packet publish(Packet batch){
+    auto &lane=*lanes[batch->bucket%lanes.size()];
+    Packet empty;
+    {
+      std::unique_lock lock(lane.mutex);
+      lane.changed.wait(lock,[&]{return lane.done||lane.queue.size()<64;});
+      if(lane.done)throw std::runtime_error("revision consumer stopped");
+      lane.queue.emplace_back(std::move(batch));
+      if(!lane.free.empty()){empty=std::move(lane.free.back());lane.free.pop_back();}
+    }
+    lane.changed.notify_all();
+    return empty;
+  }
+public:
+  struct Producer {std::array<Packet,shards> current;};
+  PipelinedWinners(unsigned n,size_t estimated):initial(std::bit_ceil(std::clamp<size_t>(estimated/shards+estimated/shards/2,16,65536))),serial(n==0){
+    for(unsigned i=0;i<n;++i)lanes.push_back(std::make_unique<Lane>());
+    try{for(auto &p:lanes)reducers.emplace_back([this,lane=p.get()]{reduce(*lane);});}
+    catch(...){stop();throw;}
+  }
+  ~PipelinedWinners(){stop();reducers.clear();}
+  void push(Producer &p,Revision r) {
+    auto b=unsigned(r.id.hash()%shards);
+    if(serial){tables[b].accept(r,initial);return;}
+    auto &batch=p.current[b];
+    if(!batch)batch=std::make_unique<Batch>();
+    batch->bucket=b;batch->rows.push_back(r);
+    if(batch->rows.size()==BatchSize)batch=publish(std::move(batch));
+  }
+  void flush(Producer &p){
+    if(serial)return;
+    for(auto &batch:p.current)if(batch&&!batch->rows.empty())publish(std::move(batch));
+  }
+  void finish(){
+    stop();reducers.clear();
+    if(failure)std::rethrow_exception(failure);
+    for(auto &tab:tables)std::vector<Revision>().swap(tab.slots);
+  }
+};
