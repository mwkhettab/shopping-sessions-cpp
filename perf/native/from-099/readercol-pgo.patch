+#pragma once
+#include <ctime>
+struct EventReaderChoice {
+#ifdef SHOPPING_X86_CSV
+  static constexpr unsigned per_reader=SHOPPING_CSV_PAIRS;
+  std::array<std::array<double,per_reader>,2> samples{};
+  unsigned visits{},since{};
+  bool use_tiled{};
+  static uint64_t clock_ns(){
+    timespec ts{};
+    if(clock_gettime(CLOCK_THREAD_CPUTIME_ID,&ts)==0)return uint64_t(ts.tv_sec)*1000000000+ts.tv_nsec;
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+  }
+#endif
+  template<class F> void scan(Str bytes,unsigned owner,F &&callback) {
+#ifdef SHOPPING_X86_CSV
+    if(wide_csv_supported() && bytes.size()>=32768) {
+#ifdef SHOPPING_VENDOR_READER
+      if(__builtin_cpu_is("intel"))rows<7,true>(bytes,callback);
+      else rows<7>(bytes,callback);
+      return;
+#else
+      if(visits>=2+2*per_reader) {
+#ifdef SHOPPING_REPEAT_READER
+        if(++since>=96){visits=since=0;}
+        else
+#endif
+        {
+          if(use_tiled)rows<7,true>(bytes,callback);else rows<7>(bytes,callback);
+          return;
+        }
+      }
+      // Alternate both within each pair and between pairs; include both paths in warm-up.
+      unsigned round=visits/2,mode=(visits^round^owner)&1;
+      auto start=clock_ns();
+      if(mode)rows<7,true>(bytes,callback);else rows<7>(bytes,callback);
+      auto ns=clock_ns()-start;
+      if(round)samples[mode][round-1]=double(ns)/double(bytes.size());
+      if(++visits==2+2*per_reader){
+        for(auto &series:samples)std::sort(series.begin(),series.end());
+        use_tiled=samples[1][per_reader/2]<samples[0][per_reader/2]*0.992;
+      }
+      return;
+#endif
+    }
+#else
+    (void)owner;
+#endif
+    rows<7>(bytes,callback);
+  }
+};
