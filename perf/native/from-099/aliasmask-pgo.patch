+#pragma once
+
+// A primary entry represents an exact inline key. The shard, home bucket
+// and remaining quotient recover every hash bit. No stored fingerprint can
+// accidentally identify two users. Displaced entries also keep their probe
+// distance so the implicit home bucket is unambiguous.
+template<unsigned Ways,unsigned MaxDistance> struct AliasQuotients {
+  static constexpr unsigned distance_bits=std::bit_width(MaxDistance);
+  std::vector<std::array<uint64_t,Ways>> main;
+  std::unordered_map<Key,size_t,KeyHash> overflow;
+  unsigned prefix_bits,locator_bits;
+  uint64_t locator_mask;
+  explicit AliasQuotients(size_t count):main(count),
+    prefix_bits(std::countr_zero(shards)+std::countr_zero(count)),
+    locator_bits(1+prefix_bits-distance_bits),locator_mask((uint64_t{1}<<locator_bits)-1) {}
+  template<class Groups> size_t intern(Key key,Groups &groups){
+    auto insert=[&](){size_t index=groups.size();groups.push_back({key});return index;};
+    if(!key.indirect()){
+      uint64_t hash=key.hash();
+      size_t home=(hash/shards)&(main.size()-1);
+      uint64_t tag=(hash>>prefix_bits)<<(locator_bits+distance_bits);
+      for(unsigned distance=0;distance<=MaxDistance;++distance){
+        auto &bucket=main[(home+distance)&(main.size()-1)];
+        uint64_t expected=tag|(uint64_t(distance)<<locator_bits);
+        for(auto &entry:bucket){
+          if(entry){
+            if((entry&~locator_mask)==expected)return (entry&locator_mask)-1;
+          }else{
+            if(groups.size()>=locator_mask)break;
+            size_t index=insert();entry=expected|(index+1);return index;
+          }
+        }
+      }
+    }
+    auto [it,added]=overflow.try_emplace(key,groups.size());
+    if(added)insert();
+    return it->second;
+  }
+};
