+#pragma once
+template<class T,size_t Block> struct DemandSlab {
+  static_assert(std::has_single_bit(Block) && std::is_trivially_destructible_v<T>);
+  std::array<size_t,shards> counts{};
+  std::array<T*,shards> current{};
+  std::array<std::vector<T*>,shards> blocks;
+  std::vector<T*> extra;
+  std::allocator<T> allocator;
+  void *mapping=MAP_FAILED;
+  size_t bytes{},capacity{},issued{};
+  static constexpr size_t growth=std::max<size_t>(1,65536/(sizeof(T)*Block));
+  DemandSlab()=default;
+  DemandSlab(const DemandSlab&)=delete;
+  void reserve(size_t hint) {
+    if(!hint)return;
+    capacity=(hint*shards+Block-1)/Block;bytes=capacity*Block*sizeof(T);
+    mapping=mmap(nullptr,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    if(mapping==MAP_FAILED){capacity=0;return;}
+#ifdef MADV_HUGEPAGE
+    madvise(mapping,bytes,MADV_HUGEPAGE);
+#endif
+  }
+  T *take(){
+    size_t i=issued++;
+    if(i<capacity)return reinterpret_cast<T*>(mapping)+i*Block;
+    auto offset=(i-capacity)%growth;
+    if(!offset){
+      auto *new_page=allocator.allocate(growth*Block);
+      try{extra.push_back(new_page);}catch(...){allocator.deallocate(new_page,growth*Block);throw;}
+    }
+    return extra.back()+offset*Block;
+  }
+  template<class... A> size_t append(size_t b,A&&...args) {
+    size_t i=counts[b]++,offset=i%Block;
+    if(!offset) {
+      auto *next=take();blocks[b].push_back(next);current[b]=next;
+    }
+    std::construct_at(current[b]+offset,std::forward<A>(args)...);
+    return i;
+  }
+  struct View {
+    DemandSlab &s;size_t b;
+    size_t size()const{return s.counts[b];}
+    size_t capacity()const{return s.blocks[b].size()*Block;}
+    T &operator[](size_t i)const{return s.blocks[b][i/Block][i%Block];}
+    void push_back(T v){s.append(b,std::move(v));}
+    template<class... A> void emplace_back(A&&...args){s.append(b,std::forward<A>(args)...);}
+    void release(){std::vector<T*>().swap(s.blocks[b]);}
+    struct Range {
+      DemandSlab &s;size_t b;
+      struct Iter {
+        const Range *r;size_t i;
+        auto operator*()const{
+          auto &s=r->s;
+          return std::span<T>(s.blocks[r->b][i],std::min<size_t>(Block,s.counts[r->b]-i*Block));
+        }
+        Iter &operator++(){++i;return *this;}
+        bool operator!=(const Iter &other)const{return i!=other.i;}
+      };
+      Iter begin()const{return {this,0};}Iter end()const{return {this,s.blocks[b].size()};}
+    };
+    Range spans()const{return {s,b};}
+  };
+  View operator[](size_t b){return {*this,b};}
+  void release(){
+    if(mapping!=MAP_FAILED){munmap(mapping,bytes);mapping=MAP_FAILED;}
+    for(auto *p:extra)allocator.deallocate(p,growth*Block);
+    extra.clear();
+  }
+  ~DemandSlab(){release();}
+};
