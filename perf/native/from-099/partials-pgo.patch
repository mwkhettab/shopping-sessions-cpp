+++ b/cpp/partial_sessions.hpp
@@ -0,0 +1,68 @@
+#pragma once
+struct PartialStore {
+  struct Segment {Time first,last;int64_t count,revenue;size_t purchase_begin,purchase_end;};
+  struct Buy {int category;int64_t cents;};
+  std::vector<Segment> segments;
+  std::vector<Buy> purchases;
+};
+struct PartialRef {const PartialStore *store;const PartialStore::Segment *segment;};
+
+template<class E,class Layout>
+void collapse_alias(std::span<E> events,Layout layout,Result &scratch,PartialStore &out) {
+  if(events.empty())return;
+  size_t purchase_begin=out.purchases.size();
+  auto begin=[&](Time){purchase_begin=out.purchases.size();};
+  auto spend=[&](int category,int64_t cents){
+#ifdef SHOPPING_REDUCE_PRICES
+    auto &sum=scratch.spend[category];
+    if(!sum)scratch.purchased.push_back(category);
+    sum+=cents;
+#else
+    out.purchases.push_back({category,cents});
+#endif
+  };
+  auto end=[&](Time first,Time last,int64_t count,int64_t revenue){
+#ifdef SHOPPING_REDUCE_PRICES
+    for(int cat:scratch.purchased) {
+      auto &value=scratch.spend[cat];out.purchases.push_back({cat,value});value=0;
+    }
+    scratch.purchased.clear();
+#endif
+    out.segments.push_back({first,last,count,revenue,purchase_begin,out.purchases.size()});
+  };
+  if(events.size()>=32 && !scratch.bins.cells.empty()) {
+    scratch.bins.scan(events,begin,spend,end,layout);
+  } else {
+    std::sort(events.begin(),events.end(),[&](E a,E b){return layout.less(a,b);});
+    size_t i=0;
+    while(i<events.size()) {
+      size_t first=i;Time start=layout.time(events[i]),last=start;begin(start);
+      int64_t revenue=0;
+      do {
+        auto e=layout.unpack(events[i++]);
+        last=e.ts;
+        if(e.price){spend(e.category,e.price);revenue+=e.price;}
+      } while(i<events.size() && layout.time(events[i])-last<=session_gap);
+      end(start,last,int64_t(i-first),revenue);
+    }
+  }
+}
+
+template<class Begin,class Spend,class End>
+void merge_aliases(std::span<const PartialRef> refs,Begin begin,Spend spend,End end) {
+  Time first=0,last=0;
+  int64_t count=0,revenue=0;
+  for(auto &ref:refs) {
+    const auto &piece=*ref.segment;
+    if(!count || piece.first-last>session_gap) {
+      if(count)end(first,last,count,revenue);
+      first=piece.first;last=piece.last;begin(first);count=0;revenue=0;
+    } else last=std::max(last,piece.last);
+    count+=piece.count;revenue+=piece.revenue;
+    for(size_t j=piece.purchase_begin;j<piece.purchase_end;++j) {
+      const auto &p=ref.store->purchases[j];
+      spend(p.category,p.cents);
+    }
+  }
+  if(count)end(first,last,count,revenue);
+}
