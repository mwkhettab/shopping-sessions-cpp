+#pragma once
+// All identifiers from links enter this table, including aliases with no data.
+class IdentityRoutes {
+  struct Cell {Key key;uintptr_t value{};};
+  struct Table {
+    std::vector<Cell> values;
+#ifdef SHOPPING_ROUTE_FILTER
+    std::vector<uint64_t> possible;
+#endif
+    Cell *find(Key k,size_t hash) {
+      auto mask=values.size()-1;
+      size_t at=(hash/shards)&mask;
+      while(values[at].key.bits && !(values[at].key==k))at=(at+1)&mask;
+      return &values[at];
+    }
+  };
+  struct LinkWorker {
+    KeyPool pool;
+    std::vector<std::array<Cell*,2>> edges;
+    Bins<std::pair<Key,size_t>> endpoints;
+  };
+  struct Lookup {Key raw,person;};
+  std::array<Table,shards> tables;
+  std::vector<LinkWorker> streams;
+#ifdef SHOPPING_ROUTE_CACHE
+  std::vector<std::vector<Lookup>> caches;
+#endif
+  static Cell *root(Cell *p) {
+    for(;;){
+      std::atomic_ref<uintptr_t> ref(p->value);
+      auto old=ref.load(std::memory_order_relaxed);
+      auto *parent=reinterpret_cast<Cell*>(old);
+      if(p==parent)return p;
+      auto next=std::atomic_ref<uintptr_t>(parent->value).load(std::memory_order_relaxed);
+      ref.compare_exchange_weak(old,next,std::memory_order_relaxed);
+      p=parent;
+    }
+  }
+#ifdef SHOPPING_ROUTE_FILTER
+  static uint64_t check_bits(size_t hash){
+    return (uint64_t{1}<<((hash>>33)&63))|(uint64_t{1}<<((hash>>48)&63));
+  }
+#endif
+public:
+  IdentityRoutes(const std::vector<InputChunk>&links,unsigned threads) : streams(threads) {
+#ifdef SHOPPING_ROUTE_CACHE
+    caches.resize(threads);
+    for(auto &cache:caches)cache.resize(SHOPPING_ROUTE_CACHE);
+#endif
+    parallel(links.size(),threads,[&](size_t i,unsigned t){
+      auto &w=streams[t];
+      rows<2>(links[i].body(),[&](const auto &row){
+        if(row[0].empty()||row[1].empty())return;
+        size_t at=w.edges.size()*2;w.edges.emplace_back();
+        for(unsigned side=0;side<2;++side){
+          Key id=w.pool.encode(row[side],'u');
+          w.endpoints[id.hash()%shards].emplace_back(id,at+side);
+        }
+      });
+    });
+    parallel(shards,threads,[&](size_t b,unsigned){
+      size_t count=0;
+      for(auto &w:streams)count+=w.endpoints[b].size();
+      if(!count)return;
+      auto &tab=tables[b];
+      tab.values.resize(std::bit_ceil(count+count/4+2));
+#ifdef SHOPPING_ROUTE_FILTER
+      tab.possible.resize(std::bit_ceil(std::max<size_t>(1,count/8)));
+#endif
+      for(auto &w:streams){
+        for(auto [key,loc]:w.endpoints[b]){
+          size_t h=key.hash();auto *entry=tab.find(key,h);
+          if(!entry->key.bits){
+            entry->key=key;entry->value=reinterpret_cast<uintptr_t>(entry);
+#ifdef SHOPPING_ROUTE_FILTER
+            tab.possible[(h/shards)&(tab.possible.size()-1)]|=check_bits(h);
+#endif
+          }
+          w.edges[loc/2][loc%2]=entry;
+        }
+        std::vector<std::pair<Key,size_t>>().swap(w.endpoints[b]);
+      }
+    });
+    using Edge=std::array<Cell*,2>;
+    std::vector<std::span<Edge>> chunks;
+    for(auto &w:streams){
+      std::span<Edge> all(w.edges);
+      while(!all.empty()){auto n=std::min<size_t>(4096,all.size());chunks.push_back(all.first(n));all=all.subspan(n);}
+    }
+    parallel(chunks.size(),threads,[&](size_t i,unsigned){
+      for(auto [a,b]:chunks[i]){
+        for(;;){
+          a=root(a);b=root(b);if(a==b)break;
+          if(a->key.user_less(b->key))std::swap(a,b);
+          uintptr_t old=reinterpret_cast<uintptr_t>(a);
+          if(std::atomic_ref<uintptr_t>(a->value).compare_exchange_weak(
+               old,reinterpret_cast<uintptr_t>(b),std::memory_order_relaxed))break;
+        }
+      }
+    });
+    parallel(shards,threads,[&](size_t b,unsigned){
+      for(auto &v:tables[b].values)if(v.key.bits)
+        std::atomic_ref<uintptr_t>(v.value).store(reinterpret_cast<uintptr_t>(root(&v)),std::memory_order_relaxed);
+    });
+    parallel(shards,threads,[&](size_t b,unsigned){
+      for(auto &v:tables[b].values)if(v.key.bits)v.value=reinterpret_cast<Cell*>(v.value)->key.bits;
+    });
+    for(auto &w:streams)std::vector<Edge>().swap(w.edges);
+  }
+  Key lookup(Key raw,[[maybe_unused]] unsigned t) {
+    size_t h=raw.hash();
+#ifdef SHOPPING_ROUTE_CACHE
+    auto &slot=caches[t][(h^(h>>21))&(SHOPPING_ROUTE_CACHE-1)];
+    if(slot.raw==raw)return slot.person;
+#endif
+    auto &tab=tables[h%shards];
+    Key person=raw;
+    if(!tab.values.empty()){
+#ifdef SHOPPING_ROUTE_FILTER
+      auto need=check_bits(h);
+      if((tab.possible[(h/shards)&(tab.possible.size()-1)]&need)==need)
+#endif
+      {
+        auto *v=tab.find(raw,h);if(v->key.bits)person={v->value};
+      }
+    }
+#ifdef SHOPPING_ROUTE_CACHE
+    slot={raw,person};
+#endif
+    return person;
+  }
+};
