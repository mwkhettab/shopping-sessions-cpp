+#pragma once
+// Encode only members of a proved byte alphabet. A nonzero final symbol
+// distinguishes every supported spelling from its zero-padded extensions.
+struct UserIdPlane {
+  static constexpr uint64_t mask48=(uint64_t{1}<<48)-1;
+  static constexpr uint64_t selected=0x5f5f5f5f5f5f5f5fULL,fixed=0x2020202020202020ULL;
+#if defined(SHOPPING_X86_CSV)
+  __attribute__((target("bmi2"))) static uint64_t gather(uint64_t data){return _pext_u64(data,selected);}
+  __attribute__((target("bmi2"))) static uint64_t expand(uint64_t data){return _pdep_u64(data,selected);}
+#endif
+  static uint64_t encode(uint64_t padded,unsigned width){
+    auto used=UINT64_MAX>>(8*(8-width));
+    if(((padded^fixed)&~selected&used) || !((padded>>(8*(width-1)))&0x5fu))return 0;
+    padded&=used;
+    uint64_t k;
+#if defined(SHOPPING_X86_CSV)
+    if(__builtin_cpu_supports("bmi2"))k=gather(padded);else
+#endif
+    {
+      auto digits=(padded&0x1f1f1f1f1f1f1f1fULL)|((padded>>1)&fixed);
+      auto pairs=(digits&0x003f003f003f003fULL)|((digits>>2)&0x0fc00fc00fc00fc0ULL);
+      auto quads=(pairs&0x00000fff00000fffULL)|((pairs>>4)&0x00fff00000fff000ULL);
+      k=(quads&0xffffff)|((quads>>8)&0xffffff000000ULL);
+    }
+    k^=k>>23;k=(k*key_multiplier)&mask48;k^=k>>19;
+    return k;
+  }
+  static uint64_t recover(uint64_t h){
+    h^=(h>>19)^(h>>38);h=(h*key_inverse)&mask48;h^=(h>>23)^(h>>46);
+    if(!h)return 0;
+    unsigned n=(std::bit_width(h)+5)/6;
+    uint64_t result;
+#if defined(SHOPPING_X86_CSV)
+    if(__builtin_cpu_supports("bmi2"))result=expand(h);else
+#endif
+    {
+      auto quads=(h&0xffffff)|((h>>24)<<32);
+      auto pairs=(quads&0x00000fff00000fffULL)|((quads&0x00fff00000fff000ULL)<<4);
+      auto digits=(pairs&0x003f003f003f003fULL)|((pairs&0x0fc00fc00fc00fc0ULL)<<2);
+      result=(digits&0x1f1f1f1f1f1f1f1fULL)|((digits&fixed)<<1);
+    }
+    return result|(fixed&(UINT64_MAX>>(8*(8-n))));
+  }
+};
