+template<unsigned Bits> struct PlaneRevision {
+  uint32_t low,middle,last;
+  static constexpr unsigned extra=Bits*8-9-32;
+  static constexpr unsigned low_time=31-extra,raw_width=64-extra-25;
+  static constexpr uint32_t key_mask=(uint32_t{1}<<extra)-1;
+  static constexpr uint64_t raw_limit=uint64_t{1}<<raw_width;
+  static_assert((Bits==6 && low_time==24 && raw_width==32) || (Bits==7 && low_time==16 && raw_width==24));
+  bool external()const{return middle>>31;}
+  uint64_t extension()const{return uint64_t(low)|(uint64_t(last)<<32);}
+  uint64_t code(size_t b)const{return ((uint64_t(middle&key_mask)<<32)|low)*shards+b;}
+  uint32_t time_bits()const{
+    if constexpr(low_time==24)return middle>>extra;
+    else return (middle>>extra)|((last>>raw_width)<<low_time);
+  }
+  uint64_t location()const{return uint64_t(last)&(raw_limit-1);}
+  static PlaneRevision make(Key id,Time seconds,uint64_t pos,Time anchor,std::vector<FullPlaneRevision> &overflow){
+    uint64_t when=uint64_t(seconds)-uint64_t(anchor)+(uint64_t{1}<<23);
+    if(!id.indirect() && when<(uint64_t{1}<<24) && pos<raw_limit){
+      uint64_t quotient=id.hash()/shards;
+      uint32_t middle=uint32_t(quotient>>32)|((uint32_t(when)<<extra)&0x7fffffffu);
+      uint32_t last=uint32_t(pos);
+      if constexpr(raw_width<32)last|=uint32_t(when>>low_time)<<raw_width;
+      return {uint32_t(quotient),middle,last};
+    }
+    uint64_t i=overflow.size();
+    overflow.push_back({id,seconds,pos});
+    return {uint32_t(i),0x80000000u,uint32_t(i>>32)};
+  }
