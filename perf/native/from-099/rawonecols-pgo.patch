+
+template <size_t N, unsigned Batch, class F>
+__attribute__((target("avx2,bmi,popcnt"))) void tiled_lines(Str data, F &fn) {
+  size_t from = 0, scan = 0;
+  std::array<size_t, Batch> ends;
+  unsigned n = 0;
+  auto flush = [&]() __attribute__((target("avx2,bmi,popcnt"), always_inline)) {
+    for (unsigned i = 0; i < n; ++i) {
+      auto to = ends[i];
+      split_known_line<N>(data.data() + from, to - from,
+                          data.data() + data.size(), fn);
+      from = to + 1;
+    }
+    n = 0;
+  };
+  auto lf = _mm256_set1_epi8('\n');
+  for (; scan + 32 <= data.size(); scan += 32) {
+    auto v = _mm256_loadu_si256(
+        reinterpret_cast<const __m256i *>(data.data() + scan));
+    auto mask = unsigned(_mm256_movemask_epi8(_mm256_cmpeq_epi8(v, lf)));
+    while (mask) {
+      ends[n++] = scan + std::countr_zero(mask);
+      mask &= mask - 1;
+      if (n == Batch)
+        flush();
+    }
+  }
+  if (n)
+    flush();
