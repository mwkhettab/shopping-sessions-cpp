+template<class Record,size_t Width> struct PlaneColumns {
+  struct Block {std::array<uint32_t,2> signature[Width];uint32_t position[Width];};
+  struct Bin {
+    Block *blocks{};
+    size_t used{},limit{};
+    std::vector<Block> more;
+    size_t size()const{return used;}
+    size_t capacity()const{return limit+more.capacity()*Width;}
+    Record operator[](size_t i)const{
+      const auto &b=i<limit?blocks[i/Width]:more[(i-limit)/Width];
+      auto j=i%Width;
+      return {b.signature[j][0],b.signature[j][1],b.position[j]};
+    }
+    void push_back(Record r){
+      size_t j=used%Width;
+      Block *b;
+      if(used<limit){
+        b=blocks+used/Width;
+        if(!j)::new(static_cast<void*>(b)) Block;
+      }else{
+        if(!j)more.emplace_back();
+        b=&more.back();
+      }
+      b->signature[j]={r.low,r.middle};b->position[j]=r.last;
+      ++used;
+    }
+    void release(){std::vector<Block>().swap(more);}
+  };
+  PartitionSlab<Block> slab;
+  std::array<Bin,shards> bins;
+  void reserve(size_t n){
+    slab.reserve((n+Width-1)/Width);
+    for(size_t b=0;b<shards;++b){bins[b].blocks=slab[b].data;bins[b].limit=slab[b].limit*Width;}
+  }
+  void release(){slab.release();}
+  Bin &operator[](size_t i){return bins[i];}
+  const Bin &operator[](size_t i)const{return bins[i];}
+  auto begin()const{return bins.begin();}
+  auto end()const{return bins.end();}
+};
