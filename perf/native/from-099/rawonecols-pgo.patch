+template<unsigned Bits,bool Hardware> struct EventIdPlane {
+  static_assert(Bits==6 || Bits==7);
+  static constexpr uint64_t selected=Bits==6?0x5f5f5f5f5f5f5f5fULL:0x7f7f7f7f7f7f7f7fULL;
+  static constexpr uint64_t fixed=Bits==6?0x2020202020202020ULL:0;
+  static constexpr uint64_t hash_mask=(uint64_t{1}<<(8*Bits))-1;
+  static uint64_t project(uint64_t bytes){
+#if defined(SHOPPING_X86_CSV)
+    if constexpr(Hardware)if(__builtin_cpu_supports("bmi2"))return project_event_id<selected>(bytes);
+#endif
+    if constexpr(Bits==6){
+      uint64_t digits=(bytes&0x1f1f1f1f1f1f1f1fULL)|((bytes>>1)&0x2020202020202020ULL);
+      uint64_t pairs=(digits&0x003f003f003f003fULL)|((digits>>2)&0x0fc00fc00fc00fc0ULL);
+      uint64_t quads=(pairs&0x00000fff00000fffULL)|((pairs>>4)&0x00fff00000fff000ULL);
+      return (quads&0xffffff)|((quads>>8)&0xffffff000000ULL);
+    }else{
+      uint64_t pairs=(bytes&0x007f007f007f007fULL)|((bytes>>1)&0x3f803f803f803f80ULL);
+      uint64_t quads=(pairs&0x00003fff00003fffULL)|((pairs>>2)&0x0fffc0000fffc000ULL);
+      return (quads&0x0fffffff)|((quads>>4)&0x00fffffff0000000ULL);
+    }
+  }
+  static Key borrowed(Str id,KeyPool &pool){
+    auto &value=pool.other.emplace_back(BorrowedKey{id,std::hash<Str>{}(id)});
+    return {reinterpret_cast<uintptr_t>(&value)|1};
+  }
+  static Key known(Str id,uint64_t padded,KeyPool &pool){
+    if constexpr(sizeof(uintptr_t)>=8){
+      unsigned n=unsigned(id.size()-1);
+      auto used=UINT64_MAX>>(8*(8-n));
+      // The discarded bit plane is constant on every used byte. The last
+      // symbol must be nonzero so padding cannot change a spelling's length.
+      if(((padded^fixed)&~selected&used)==0 && (uint8_t(id.back())&uint8_t(selected))){
