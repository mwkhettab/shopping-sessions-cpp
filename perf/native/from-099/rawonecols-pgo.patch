+#pragma once
+// Rows retain an unmodified timestamp. A parallel, sparse purchase stream
+// restores the full event before it enters a person's final timeline.
+template<class Layout,bool Indexed,bool Reserve> struct SparseRawEvents {
+  using E=typename Layout::E;
+  static constexpr bool packed=std::is_same_v<Layout,WordLayout>;
+  struct Compact {uint32_t low,high,token;};
+  static_assert(sizeof(Compact)==12);
+  using Row=std::conditional_t<packed,Compact,std::pair<Key,E>>;
+  struct Exception {size_t pos;uint32_t detail;};
+  using Extra=std::conditional_t<Indexed,Exception,uint64_t>;
+  PartitionSlab<Row> store;
+  std::array<std::vector<Extra>,shards> extra;
+  auto &operator[](size_t b){return store[b];}
+  const auto &operator[](size_t b)const{return store[b];}
+  void reserve(size_t n){
+    store.reserve(n);
+    if constexpr(packed && Reserve)if(n>=96)for(auto &bucket:extra)bucket.reserve(n/24);
+  }
+  void append(size_t b,Key key,E payload){
+    auto &bucket=store[b];
+    if constexpr(packed){
+      uint32_t token=uint32_t(payload>>32),detail=uint32_t(payload);
+      if constexpr(Indexed){
+        if(detail)extra[b].push_back({bucket.size(),detail});
+      }else if(detail || token==UINT32_MAX){
+        extra[b].push_back(payload);token=UINT32_MAX;
+      }
+      bucket.push_back({uint32_t(key.bits),uint32_t(uint64_t(key.bits)>>32),token});
+    }else bucket.emplace_back(key,payload);
+  }
+  static Key user(const Row &row){
+    if constexpr(packed)return {uintptr_t((uint64_t(row.high)<<32)|row.low)};
+    else return row.first;
+  }
+  static void set(Row &row,uintptr_t key){
+    if constexpr(packed){row.low=uint32_t(key);row.high=uint32_t(uint64_t(key)>>32);}
+    else row.first.bits=key;
+  }
+  void erase(size_t b,size_t i){set(store[b][i],0);}
+  template<class F> void index_users(size_t b,F f){
+    for(auto part:store[b].spans())for(auto &row:part)set(row,f(user(row)));
+  }
+  template<class F> void scatter(size_t b,F f){
+    if constexpr(packed){
+      auto &exception=extra[b];size_t cursor=0,pos=0,next=SIZE_MAX;
+      if constexpr(Indexed)if(!exception.empty())next=exception.front().pos;
+      for(auto part:store[b].spans())for(auto &row:part){
+        uint64_t payload=uint64_t(row.token)<<32;
+        if constexpr(Indexed){
+          if(pos==next){
+            payload|=exception[cursor++].detail;
+            next=cursor==exception.size()?SIZE_MAX:exception[cursor].pos;
+          }
+        }else if(row.token==UINT32_MAX)payload=exception[cursor++];
+        ++pos;
+        auto index=user(row).bits;
+        if(index!=UINTPTR_MAX)f(index,payload);
+      }
+    }else for(auto part:store[b].spans())for(auto &[key,payload]:part)if(key.bits!=UINTPTR_MAX)f(key.bits,payload);
+  }
+  void clear_bucket(size_t b){store[b].release();std::vector<Extra>().swap(extra[b]);}
+  void release(){store.release();}
+};
