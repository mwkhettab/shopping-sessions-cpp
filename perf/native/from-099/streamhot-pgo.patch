+#pragma once
+class UserPageWriter {
+  using Bytes=flat_parquet::Bytes;
+  static constexpr flat_parquet::Column schema[]={
+    {"user_id",6,0},{"day",1,6},{"sessions",2},{"events",2},{"revenue_cents",2},{"top_category",6,0,true}
+  };
+  flat_parquet::File file;
+  std::array<Bytes,6> data;
+  Bytes definitions,optional,packed;
+  size_t rows{},text_bytes{};
+  std::array<char,9> inline_name;
+  uintptr_t previous_key{};
+  Str last_name;
+  static constexpr size_t row_limit=16384;
+  void flush() {
+    if(!rows)return;
+    file.group(rows);
+    file.page(data[0]);
+    for(size_t i=1;i<5;++i) {
+#ifdef SHOPPING_PLAIN_STREAM
+      file.page(data[i]);
+#else
+      packed.clear();
+      if(i==1)flat_parquet::delta_pack<int32_t>(packed,data[i]);
+      else flat_parquet::delta_pack<int64_t>(packed,data[i]);
+      file.page(packed,5);
+#endif
+    }
+    optional.clear();
+    size_t start=flat_parquet::levels(optional,rows);
+    std::memcpy(optional.data()+start,definitions.data(),definitions.size());
+    optional.append(data[5]);file.page(optional);
+    for(auto &p:data)p.clear();
+    definitions.clear();rows=0;text_bytes=0;
+  }
+public:
+  explicit UserPageWriter(const fs::path &path):file(path,schema) {
+    for(auto &p:data)p.reserve(row_limit*8);
+    definitions.reserve(row_limit/8);
+    packed.reserve(row_limit*4);
+  }
+  void append(const UserDay &r) {
+    if(r.user.bits!=previous_key) {last_name=r.user.user_text(inline_name);previous_key=r.user.bits;}
+    size_t extra=last_name.size()+(r.category?r.category->size():0);
+    if(rows && (rows==row_limit || extra>std::max<size_t>(text_bytes,8u<<20)-text_bytes)) flush();
+    text_bytes+=extra;
+    flat_parquet::plain_string(data[0],last_name);
+    flat_parquet::little(data[1],r.day);flat_parquet::little(data[2],r.sessions);
+    flat_parquet::little(data[3],r.events);flat_parquet::little(data[4],r.revenue);
+    if(!(rows%8))definitions.push_back(0);
+    if(r.category) {
+      definitions.back()=char(static_cast<unsigned char>(definitions.back())|(1u<<(rows%8)));
+      flat_parquet::plain_string(data[5],*r.category);
+    }
+    ++rows;
+  }
+  void close(){flush();file.close();}
+};
