+#pragma once
+template<class T,bool Starts,bool Color> struct HotSlab {
+  static_assert(std::is_trivially_destructible_v<T>);
+  std::array<size_t,shards> counts{};
+  std::conditional_t<Starts,std::array<T*,shards>,std::array<T*,0>> starts{};
+  std::array<std::vector<T>,shards> spill;
+  void *region=MAP_FAILED;
+  size_t bytes{},stride{},cap{};
+  HotSlab()=default;
+  HotSlab(const HotSlab&)=delete;
+  T *begin_at(size_t b) const {
+    if constexpr(Starts)return starts[b];
+    else {
+      if(!cap)return nullptr;
+      return reinterpret_cast<T*>(static_cast<char*>(region)+b*stride+(Color?((b*13)&63)*64:0));
+    }
+  }
+  void reserve(size_t n) {
+    if(!n)return;
+    constexpr size_t page=4096;
+    size_t usable=(n*sizeof(T)+page-1)/page*page;
+    stride=usable+(Color?page:0);
+    bytes=stride*shards;
+    region=mmap(nullptr,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+    if(region==MAP_FAILED)return;
+    cap=usable/sizeof(T);
+#ifdef MADV_HUGEPAGE
+    madvise(region,bytes,MADV_HUGEPAGE);
+#endif
+    if constexpr(Starts)for(size_t b=0;b<shards;++b)
+      starts[b]=reinterpret_cast<T*>(static_cast<char*>(region)+b*stride+(Color?((b*13)&63)*64:0));
+  }
+  template<class...A> size_t append(size_t b,A&&...args) {
+    size_t i=counts[b]++;
+    if(i<cap)std::construct_at(begin_at(b)+i,std::forward<A>(args)...);
+    else spill[b].emplace_back(std::forward<A>(args)...);
+    return i;
+  }
+  struct View {
+    HotSlab &s;size_t b;
+    size_t size()const{return s.counts[b];}
+    size_t capacity()const{return s.cap+s.spill[b].capacity();}
+    auto spans()const{return std::array{std::span<T>(s.begin_at(b),std::min(s.cap,size())),std::span<T>(s.spill[b])};}
+    T &operator[](size_t i)const{return i<s.cap?s.begin_at(b)[i]:s.spill[b][i-s.cap];}
+    void push_back(T value){s.append(b,std::move(value));}
+    template<class...A> void emplace_back(A&&...args){s.append(b,std::forward<A>(args)...);}
+    void release(){std::vector<T>().swap(s.spill[b]);}
+  };
+  View operator[](size_t b){return {*this,b};}
+  void release(){if(region!=MAP_FAILED){munmap(region,bytes);region=MAP_FAILED;cap=0;}}
+  ~HotSlab(){release();}
+};
