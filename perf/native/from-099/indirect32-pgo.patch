+++ b/cpp/narrow_events.hpp
@@ -0,0 +1,62 @@
+#pragma once
+struct PurchaseIndexLimit {};
+
+// The ordinary 31-bit value is the exact millisecond offset. Purchases refer
+// to append-only arrays owned by the reading worker and frozen before grouping.
+struct ShortEventLayout {
+  using E=uint32_t;
+  using C=WordLayout::C;
+  struct Purchase {uint32_t time,details;};
+  struct PackedBits {
+    std::array<uint32_t,2> words;
+    PackedBits()=default;
+    PackedBits(uintptr_t n){*this=n;}
+    PackedBits &operator=(uintptr_t n) {
+      uint64_t v=n;std::memcpy(words.data(),&v,sizeof v);return *this;
+    }
+    operator uintptr_t() const {
+      uint64_t v;std::memcpy(&v,words.data(),sizeof v);return uintptr_t(v);
+    }
+  };
+  struct StoredKey {PackedBits bits;};
+  struct RawRecord {
+    StoredKey first;
+    E second;
+    RawRecord(Key k,E value):first{k.bits},second(value){}
+  };
+#ifdef SHOPPING_PACK_RAW
+  using Raw=RawRecord;
+#else
+  using Raw=std::pair<Key,E>;
+#endif
+  static_assert(sizeof(RawRecord)==12);
+  static constexpr uint32_t purchase_flag=uint32_t{1}<<31;
+  Time origin;
+  std::span<std::vector<Purchase>> purchases;
+  unsigned owner_bits,mask;
+
+  E pack(Event raw,unsigned worker) const {
+    uint32_t t=uint32_t(uint64_t(raw.ts)-uint64_t(origin));
+    if(!raw.price)return t;
+    auto &out=purchases[worker];
+    if(out.size()>((purchase_flag-1)>>owner_bits))throw PurchaseIndexLimit{};
+    uint32_t index=uint32_t(out.size());
+    out.push_back({t,(uint32_t(raw.price)<<8)|uint32_t(raw.category)});
+    return purchase_flag | (index<<owner_bits) | worker;
+  }
+  const Purchase &purchase(E e) const {
+    return purchases[e&mask][(e & ~purchase_flag)>>owner_bits];
+  }
+  uint32_t offset(E e) const {return e&purchase_flag?purchase(e).time:e;}
+  Time time(E e) const{return origin+offset(e);}
+  Event unpack(E e) const {
+    if(!(e&purchase_flag)) return {origin+e,0,0};
+    const auto &p=purchase(e);
+    return {origin+p.time,int32_t(p.details>>8),int32_t(p.details&255)};
+  }
+  bool less(E a,E b) const{return offset(a)<offset(b);}
+  Time click_time(C c) const{return origin-reach+Time(c.ts);}
+  C click(Key id,Time ts,int campaign) const {
+    return {id,uint32_t(uint64_t(ts)-uint64_t(origin)+reach),campaign};
+  }
+};
