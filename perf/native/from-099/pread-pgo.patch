+#pragma once
+struct ChunkReader {
+  std::vector<char> buffer;
+  int fd=-1;
+  const fs::path *path{};
+  ChunkReader()=default;
+  ChunkReader(const ChunkReader&)=delete;
+  ~ChunkReader(){if(fd>=0)close(fd);}
+  template<class Pool> Str read(const InputChunk &chunk,Pool &pool) {
+    Str source=chunk.body();pool.original=nullptr;
+    if(source.size()<8192||source.size()>(2u<<20)||!chunk.path)return source;
+    if(buffer.size()<source.size())buffer.resize(source.size());
+#ifdef SHOPPING_PREAD
+    if(path!=chunk.path){
+      if(fd>=0)close(fd);
+      fd=open(chunk.path->c_str(),O_RDONLY);path=chunk.path;
+    }
+    if(fd<0)return source;
+    size_t done=0;
+    auto offset=source.data()-chunk.file.data();
+    while(done<source.size()){
+      auto n=pread(fd,buffer.data()+done,source.size()-done,off_t(offset)+off_t(done));
+      if(n<0 && errno==EINTR)continue;
+      if(n<=0)return source;
+      done+=size_t(n);
+    }
+#else
+    std::memcpy(buffer.data(),source.data(),source.size());
+#endif
+    pool.original=source.data();pool.mirror=buffer.data();
+    return {buffer.data(),source.size()};
+  }
+};
