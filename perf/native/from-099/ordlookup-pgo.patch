+#pragma once
+#ifdef SHOPPING_X86_CSV
+// Within a 256-byte tile even its very last delimiter fits in one byte.
+// Extract newline bits in separator order. In a well-formed event stream
+// every seventh separator must be LF, regardless of field widths or quotes.
+struct OrdinalMasks { uint64_t separators, quotes, newlines; };
+
+template<size_t N> inline constexpr auto ordinal_newlines=[] {
+  std::array<uint64_t,N> out{};
+  for(unsigned phase=0;phase<N;++phase)
+    for(unsigned bit=0;bit<64;++bit)
+      if((phase+bit+1)%N==0)out[phase]|=uint64_t{1}<<bit;
+  return out;
+}();
+
+struct OrdinalFields {
+  const char *base;
+  const uint8_t *end;
+  Str operator[](size_t i) const {
+    unsigned first=uint8_t(end[std::ptrdiff_t(i)-1]+1),cut=end[i];
+    unsigned trim=base[first]=='"';
+    return {base+first+trim,cut-first-2*trim};
+  }
+  template<size_t N> operator std::array<Str,N>() const {
+    std::array<Str,N> row;
+    for(unsigned i=0;i<N;++i)row[i]=(*this)[i];
+    return row;
+  }
+};
+
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),always_inline))
+inline OrdinalMasks ordinal_masks_avx2(const char *p){
+  auto a=row_mask32(p),b=row_mask32(p+32);
+  auto join=[](unsigned x,unsigned y){return uint64_t(x)|(uint64_t(y)<<32);};
+  auto lf=join(a.lf,b.lf);
+  return {join(a.comma,b.comma)|lf,join(a.quotes,b.quotes),lf};
+}
+
+__attribute__((target("avx512f,avx512bw"),always_inline))
+inline OrdinalMasks ordinal_masks_wide(const char *p){
+  auto text=_mm512_loadu_si512(p);
+  uint64_t lf=_mm512_cmpeq_epi8_mask(text,_mm512_set1_epi8('\n'));
+  return {lf|_mm512_cmpeq_epi8_mask(text,_mm512_set1_epi8(',')),
+          _mm512_cmpeq_epi8_mask(text,_mm512_set1_epi8('"')),lf};
+}
+
+inline constexpr auto byte_positions=[] {
+  std::array<uint64_t,256> table{};
+  for(unsigned mask=0;mask<256;++mask){
+    unsigned n=0;
+    for(unsigned i=0;i<8;++i)if(mask&(1u<<i))table[mask]|=uint64_t(i)<<(8*n++);
+  }
+  return table;
+}();
+
+template<bool lookup>
+__attribute__((target("avx2,bmi,bmi2,popcnt,pclmul"),always_inline))
+inline void ordinal_positions(uint8_t *out,unsigned base,uint64_t sep){
+  if constexpr(lookup){
+    for(unsigned i=0;i<64;i+=8){
+      uint8_t marks=uint8_t(sep);sep>>=8;
+      uint64_t positions=byte_positions[marks]+uint64_t(base+i)*0x0101010101010101ULL;
+      std::memcpy(out,&positions,8);out+=std::popcount(marks);
+    }
+  }else{
+    while(sep){*out++=uint8_t(base+std::countr_zero(sep));sep&=sep-1;}
+  }
+}
+
+__attribute__((target("avx512f,avx512bw,avx512vbmi2"),always_inline))
+inline void ordinal_positions_wide(uint8_t *out,unsigned base,uint64_t sep){
+  alignas(64) static constexpr auto seq=[] {
+    std::array<uint8_t,64> out{};
+    for(unsigned i=0;i<64;++i)out[i]=uint8_t(i);
+    return out;
+  }();
+  auto offsets=_mm512_add_epi8(_mm512_load_si512(seq.data()),_mm512_set1_epi8(char(base)));
+  _mm512_storeu_si512(out,_mm512_maskz_compress_epi8(sep,offsets));
+}
+
+#define ORDINAL_USE_WIDE 0
+#define ORDINAL_READER ordinal_rows
+#define ORDINAL_TARGET "avx2,bmi,bmi2,popcnt,pclmul"
+#include "ordinal_loop.inc"
+#undef ORDINAL_TARGET
+#undef ORDINAL_READER
+#undef ORDINAL_USE_WIDE
+#define ORDINAL_USE_WIDE 1
+#define ORDINAL_READER ordinal_wide_rows
+#define ORDINAL_TARGET "avx2,bmi,bmi2,popcnt,pclmul,avx512f,avx512bw,avx512vbmi2"
+#include "ordinal_loop.inc"
+#undef ORDINAL_TARGET
+#undef ORDINAL_READER
+#undef ORDINAL_USE_WIDE
+#endif
