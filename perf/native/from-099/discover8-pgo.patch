+#pragma once
+class PossibleRevisions {
+  static constexpr unsigned partitions=256;
+  std::vector<uint64_t> repeated;
+  uint32_t mask{};
+  template<class F> static void first_fields(Str data,F callback) {
+    if(data.empty())return;
+    const char *p=data.data(),*end=p+data.size();
+    auto field=[&](const char *from,const char *to) {
+      const char *comma=nullptr;
+#if defined(__SSE2__)
+      if(end-from>=16) {
+        auto first=_mm_loadu_si128(reinterpret_cast<const __m128i*>(from));
+        auto hits=unsigned(_mm_movemask_epi8(_mm_cmpeq_epi8(first,_mm_set1_epi8(','))));
+        if(hits){auto at=std::countr_zero(hits);if(to-from>at)comma=from+at;else return;}
+      }
+#endif
+      if(!comma)comma=static_cast<const char*>(std::memchr(from,',',size_t(to-from)));
+      if(!comma)return;
+      Str s(from,comma-from);
+      if(s.size()>=2 && s.front()=='"' && s.back()=='"'){s.remove_prefix(1);s.remove_suffix(1);}
+      if(!s.empty())callback(s);
+    };
+#if defined(__SSE2__)
+    const char *q=p;
+    while(end-q>=16) {
+      auto v=_mm_loadu_si128(reinterpret_cast<const __m128i*>(q));
+      unsigned lf=unsigned(_mm_movemask_epi8(_mm_cmpeq_epi8(v,_mm_set1_epi8('\n'))));
+      while(lf){auto *line=q+std::countr_zero(lf);field(p,line);p=line+1;lf&=lf-1;}
+      q+=16;
+    }
+#endif
+    while(p<end){
+      auto lf=static_cast<const char*>(std::memchr(p,'\n',end-p));
+      if(!lf){field(p,end);break;}
+      field(p,lf);p=lf+1;
+    }
+  }
+public:
+  PossibleRevisions(const std::vector<InputChunk> &parts,size_t estimate,unsigned threads) {
+    auto count=std::bit_ceil(std::clamp<size_t>(estimate,4096,size_t(1)<<26))*DISCOVERY_FACTOR;
+    mask=uint32_t(count-1);
+    repeated.resize(count/64);
+    using Queues=std::array<std::vector<uint32_t>,partitions>;
+    std::vector<Queues> queues(threads);
+    parallel(parts.size(),threads,[&](size_t i,unsigned owner){
+      KeyPool ids;
+      auto &out=queues[owner];
+      first_fields(parts[i].body(),[&](Str id){
+        auto tag=uint32_t(ids.encode(id,'e').hash())&mask;
+        out[tag%partitions].push_back(tag/partitions);
+      });
+    });
+    auto words=count/partitions/64;
+    parallel(partitions,threads,[&](size_t part,unsigned){
+      std::vector<uint64_t> seen(words);
+      auto *dup=repeated.data()+part*words;
+      for(auto &src:queues){
+        auto &values=src[part];
+        for(auto v:values){
+          auto bit=uint64_t{1}<<(v%64);auto &word=seen[v/64];
+          dup[v/64]|=word&bit;word|=bit;
+        }
+        std::vector<uint32_t>().swap(values);
+      }
+    });
+  }
+  bool contains(size_t hash) const {
+    auto v=uint32_t(hash)&mask;
+    auto at=size_t(v%partitions)*(repeated.size()/partitions)+(v/partitions)/64;
+    return (repeated[at]>>((v/partitions)%64))&1;
+  }
+};
