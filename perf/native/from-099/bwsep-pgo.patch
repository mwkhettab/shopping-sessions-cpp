+template<size_t N,unsigned Bytes,bool Direct,class F>
+__attribute__((target(SHOP_ORD16_TARGET))) void SHOP_ORD16_READER(Str data,F &fn){
+  static_assert(Bytes%64==0 && Bytes<=8192);
+  constexpr unsigned Words=Bytes/64;
+  alignas(64) std::array<uint8_t,Bytes+64> positions;
+  positions[0]=255;
+  uint8_t *cuts=positions.data()+1;
+  while(data.size()>=Bytes){
+    const char *text=data.data();
+    std::array<OrdinalMasks,Words> masks;
+    for(unsigned k=0;k<Words;++k){
+#if SHOP_ORD16_WIDE
+      masks[k]=ordinal_masks_wide(text+64*k);
+#else
+      masks[k]=ordinal_masks_avx2(text+64*k);
+#endif
+    }
+    unsigned words=Words;
+    while(words && !masks[words-1].newlines)--words;
+    if(!words){
+      auto lf=data.find('\n',Bytes);
+      size_t take=lf==Str::npos?data.size():lf+1;
+      scalar_rows<N>(data.substr(0,take),fn);
+      data.remove_prefix(take);
+      continue;
+    }
+    auto &last=masks[words-1];
+    unsigned length=words*64-std::countl_zero(last.newlines);
+    uint64_t tail=mask_to(length-(words-1)*64);
+    last.separators&=tail;last.quotes&=tail;
+    uint64_t inside=0,previous=1,invalid=0;
+    unsigned nc=0;
+    std::array<uint16_t,Bytes> line_ends;
+    unsigned commas=0,lines=0;
+    FieldQuotes<Bytes> quote_flags;
+    for(unsigned b=0;b<words;++b){
+      auto [sep,q,lf]=masks[b];
+      unsigned count=std::popcount(sep);
+      uint64_t want=ordinal_newlines<N>[nc%N]&mask_to(count);
+      invalid|=_pext_u64(lf,sep)^want;
+      uint64_t closed=(q<<1)|(b?masks[b-1].quotes>>63:0);
+      quote_flags.append(nc,_pext_u64(closed,sep));
+      uint64_t parity=quote_prefix(q)^inside;
+      uint64_t next=b+1<words?(masks[b+1].separators&1):1;
+      invalid|=((q&parity)&~((sep<<1)|previous))|((q&~parity)&~((sep>>1)|(next<<63)))|(sep&parity);
+      inside=uint64_t(0)-(parity>>63);previous=sep>>63;
+      uint64_t cm=sep&~lf;
+#if SHOP_ORD16_WIDE
+      ordinal_positions<false>(cuts+commas,uint8_t(64*b),cm);
+#else
+      ordinal_positions<false>(cuts+commas,uint8_t(64*b),cm);
+#endif
+      for(auto bits=lf;bits;bits&=bits-1)
+        line_ends[lines++]=uint16_t(64*b+std::countr_zero(bits));
+      commas+=std::popcount(cm);
+      nc+=count;
+    }
+    if(invalid || inside || nc%N){
+      tiled_lines<N,16>(data.substr(0,length),fn);
+    }else {
+      unsigned begin=0;
+      for(unsigned line=0;line<lines;++line){
+        unsigned lf=line_ends[line];
+        if(lf-begin<=255){
+          CommaTileFields<N,true> row{text+begin,cuts+line*(N-1),uint8_t(begin),lf-begin,quote_flags.seven(line*N)};
+          if constexpr(Direct)emit_ordinal_row<N>(row,fn);
+          else fn(row);
+        }else scalar_rows<N>(Str(text+begin,lf-begin),fn);
+        begin=lf+1;
+      }
+    }
+    data.remove_prefix(length);
+  }
+  tiled_lines<N,16>(data,fn);
+}
