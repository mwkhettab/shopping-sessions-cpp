+#pragma once
+#ifdef SHOPPING_X86_CSV
+__attribute__((target("avx2,pclmul"),always_inline)) inline uint64_t quote_prefix(uint64_t q){
+  auto value=_mm_cvtsi64_si128(std::bit_cast<int64_t>(q));
+  return uint64_t(_mm_cvtsi128_si64(_mm_clmulepi64_si128(value,_mm_set1_epi64x(-1),0)));
+}
+inline bool csv_separator(char c){return c==',' || c=='\n';}
+__attribute__((target("avx2,pclmul"),always_inline)) inline bool
+certify_quotes(const char *start,size_t n){
+  uint64_t inside=0,previous=1,invalid=0;
+  for(size_t i=0;i<n;i+=64){
+    const char *p=start+i;unsigned used=unsigned(std::min<size_t>(64,n-i));
+    alignas(32) char tail[64]{};
+    if(used<64){std::memcpy(tail,p,used);p=tail;}
+    auto a=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p));
+    auto b=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p+32));
+    auto join=[](__m256i x,__m256i y) __attribute__((target("avx2"),always_inline)) {
+      return uint64_t(unsigned(_mm256_movemask_epi8(x)))|(uint64_t(unsigned(_mm256_movemask_epi8(y)))<<32);
+    };
+    auto quote=_mm256_set1_epi8('"'),comma=_mm256_set1_epi8(','),lf=_mm256_set1_epi8('\n');
+    uint64_t q=join(_mm256_cmpeq_epi8(a,quote),_mm256_cmpeq_epi8(b,quote));
+    uint64_t sep=join(_mm256_or_si256(_mm256_cmpeq_epi8(a,comma),_mm256_cmpeq_epi8(a,lf)),
+                      _mm256_or_si256(_mm256_cmpeq_epi8(b,comma),_mm256_cmpeq_epi8(b,lf)));
+    uint64_t parity=quote_prefix(q)^inside;
+    auto opening=q&parity,closing=q&~parity;
+    uint64_t next=(i+64<n)?uint64_t(csv_separator(start[i+64])):uint64_t(1);
+    invalid|=(opening&~((sep<<1)|previous)) | (closing&~((sep>>1)|(next<<63))) | (sep&parity);
+    inside=uint64_t(0)-(parity>>63);previous=sep>>63;
+  }
+  return !(invalid|inside);
+}
+template<size_t N,class F>
+__attribute__((target("avx2,bmi,popcnt"),always_inline)) inline void
+split_certified(const char *p,unsigned len,const char *end,F &fn) {
+  if(len>=128 || end-p<128){split_known_line<N>(p,len,end,fn);return;}
+  auto marks=[&](unsigned at) __attribute__((target("avx2,bmi,popcnt"),always_inline)) {
+    auto comma=_mm256_set1_epi8(',');
+    auto a=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p+at));
+    auto b=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(p+at+32));
+    return (uint64_t(unsigned(_mm256_movemask_epi8(_mm256_cmpeq_epi8(a,comma))))|
+            (uint64_t(unsigned(_mm256_movemask_epi8(_mm256_cmpeq_epi8(b,comma))))<<32))&mask_to(len-at);
+  };
+  uint64_t lo=marks(0),hi=len>64?marks(64):0;
+  if(std::popcount(lo)+std::popcount(hi)!=N-1)return;
+  std::array<Str,N> row;
+  unsigned from=0;
+  for(unsigned i=0;i<N;++i){
+    unsigned cut=len;
+    if(i+1<N){
+      if(lo){cut=std::countr_zero(lo);lo&=lo-1;}
+      else{cut=64+std::countr_zero(hi);hi&=hi-1;}
+    }
+    unsigned q=p[from]=='"';
+    row[i]=Str(p+from+q,cut-from-2*q);from=cut+1;
+  }
+  fn(row);
+}
