+`generate --seed N --events E --clicks C --output DIR` writes every input file above. The whale users, whale campaigns, window, ID keys and dirt rates all change with the seed, so nothing about a dataset can be hard-coded. One in eight distinct `user_id`, `event_id` and `click_id` values carries a 32-character hexadecimal suffix (the rest use short lowercase base 36), and every ID passes through a per-seed keyed bijection, so pipelines must treat IDs as opaque variable-width strings rather than fixed-width or invertible generator numbers.
diff --git a/tests/pipeline/sharded_retry.py b/tests/pipeline/sharded_retry.py
new file mode 100644
index 0000000..29e34f4
--- /dev/null
+++ b/tests/pipeline/sharded_retry.py
@@ -0,0 +1,28 @@
+"""Exercise automatic routing with fresh and already populated output directories."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+from tempfile import TemporaryDirectory
+
+
+def check(binary, starter):
+    fixture = starter / "fixtures" / "A1"
+    compare = starter / "scripts" / "compare.py"
+    env = dict(os.environ, NCPU="2", V1ND_LOG="1")
+    with TemporaryDirectory() as temp:
+        output = Path(temp)
+        for trace in ("[sharded] completed", "[v1nd]"):
+            proc = subprocess.run([binary, fixture / "input", output], env=env,
+                                  check=True, text=True, capture_output=True)
+            assert trace in proc.stderr, proc.stderr
+            subprocess.run([sys.executable, compare, output, fixture / "expected"], check=True)
+            if trace.startswith("[sharded]"):
+                (output / "user_daily" / "stale.parquet").write_bytes(b"stale")
+                (output / "user_daily" / "_SUCCESS").touch()
+        assert not (output / "user_daily" / "stale.parquet").exists()
+        assert (output / "user_daily" / "_SUCCESS").is_file()
+
+
+if __name__ == "__main__":
+    check(Path(sys.argv[1]).resolve(), Path(sys.argv[2]).resolve())
